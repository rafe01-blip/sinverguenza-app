function generateSpaceKeyFromEvent(event: EventType): SpaceKey {
  if (event.isDance || event.activityTypes?.includes("dance")) return "dance"
  if (event.isWorkshop || event.activityTypes?.includes("workshop"))
    return "workshop"
  if (event.activityTypes?.includes("gaming")) return "gaming"
  if (event.activityTypes?.includes("sports")) return "sports"
  if (event.activityTypes?.includes("music")) return "music"
  if (event.activityTypes?.includes("networking")) return "networking"
  if (event.activityTypes?.includes("food")) return "food"
  if (event.activityTypes?.includes("outdoor")) return "outdoor"
  if (event.activityTypes?.includes("fitness")) return "fitness"
  if (event.pricing === "free") return "free"
  if (event.pricing === "paid") return "paid"

  return "events"
}

function buildEventThreadPost(
  event: EventType,
  authorId: string
): CommunityPost {
  return normalizeCommunityPost({
    id: `event-thread-${event.id}`,
    authorId,
    type: "event",
    content: `Talk about ${event.title}. Ask questions, share updates, and see who is going.`,
    image: event.image || DEFAULT_ASSET,
    mediaType: "image",
    mediaUrl: event.image || DEFAULT_ASSET,
    thumbnailUrl: event.image || DEFAULT_ASSET,
    createdAt: new Date().toISOString(),
    expiresAt: sevenDaysFromNow(),
    likes: 0,
    isLiked: false,
    comments: [],
    spaceKey: event.linkedSpaceId
      ? (event.linkedSpaceId as SpaceKey)
      : generateSpaceKeyFromEvent(event),
    eventId: event.id,
    isEventThread: true,
    tags: ["Event Chat"],
  })
