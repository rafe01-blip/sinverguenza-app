"use client"

import { useMemo, useState } from "react"
import { Search, Sparkles, Users, Lock, Globe, ChevronRight } from "lucide-react"
import { TopHeader } from "@/components/navigation/top-header"
import { BottomNav } from "@/components/navigation/bottom-nav"
import { useApp, SpaceKey } from "@/lib/app-context"

const GOLD = "#C9A84C"
const DARK = "#0A0A0A"
const CARD = "#121212"

type SpaceFilter = "all" | "joined" | "popular" | "public" | "private"

function getSpaceTypeLabel(key: SpaceKey) {
  if (key === "private") return "Private"
  return "Public"
}

function getSpaceVibe(key: SpaceKey) {
  switch (key) {
    case "dance":
      return "Most active"
    case "events":
      return "Hot this week"
    case "workshop":
      return "Learn & grow"
    case "music":
      return "Playlist energy"
    case "opportunities":
      return "Real connections"
    case "free":
      return "Open access"
    case "paid":
      return "Premium plans"
    default:
      return "Community space"
  }
}

export function SpacesScreen() {
  const {
  spaces,
  openSpace,
  toggleJoinSpace,
  setCurrentScreen,
} = useApp()

  const [query, setQuery] = useState("")
  const [activeFilter, setActiveFilter] = useState<SpaceFilter>("all")

  const filteredSpaces = useMemo(() => {
    let result = [...spaces]

    if (query.trim()) {
      const q = query.trim().toLowerCase()
      result = result.filter(
        (space) =>
          space.label.toLowerCase().includes(q) ||
          space.description.toLowerCase().includes(q)
      )
    }

    if (activeFilter === "joined") {
      result = result.filter((space) => space.isJoined)
    }

    if (activeFilter === "popular") {
      result = [...result].sort((a, b) => b.membersCount - a.membersCount)
    }

    if (activeFilter === "public") {
      result = result.filter((space) => space.key !== "private")
    }

    if (activeFilter === "private") {
      result = result.filter((space) => space.key === "private")
    }

    return result
  }, [spaces, query, activeFilter])

  const joinedCount = spaces.filter((space) => space.isJoined).length
  const popularSpaces = [...spaces]
    .sort((a, b) => b.membersCount - a.membersCount)
    .slice(0, 3)

  return (
    <div
      style={{
        minHeight: "100vh",
        background: DARK,
        color: "#fff",
        paddingBottom: 96,
      }}
    >
      <TopHeader title="Spaces" showBack onBack={() => setCurrentScreen("community")} />

      <div style={{ padding: "16px" }}>
        <div style={heroCard}>
          <div style={heroGlow} />
          <div style={heroTopRow}>
            <div style={heroIconWrap}>
              <Users size={18} />
            </div>
            <div style={heroEyebrow}>COMMUNITY HUBS</div>
          </div>

          <div style={heroTitle}>Organized conversations, not random noise.</div>

          <div style={heroText}>
            Spaces help people talk by topic, vibe, and interest — so Community feels powerful,
            simple, and premium.
          </div>

          <div style={heroStatsRow}>
            <div style={heroStatBox}>
              <div style={heroStatNumber}>{spaces.length}</div>
              <div style={heroStatLabel}>Spaces</div>
            </div>

            <div style={heroStatBox}>
              <div style={heroStatNumber}>{joinedCount}</div>
              <div style={heroStatLabel}>Joined</div>
            </div>

            <div style={heroStatBox}>
              <div style={heroStatNumber}>
                {spaces.reduce((sum, space) => sum + space.membersCount, 0)}
              </div>
              <div style={heroStatLabel}>Members</div>
            </div>
          </div>
        </div>

        <div style={searchWrap}>
          <Search size={18} color="#9a9a9a" />
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search spaces"
            style={searchInput}
          />
        </div>

        <div style={filtersWrap}>
          {[
            { key: "all", label: "All" },
            { key: "joined", label: "Joined" },
            { key: "popular", label: "Popular" },
            { key: "public", label: "Public" },
            { key: "private", label: "Private" },
          ].map((item) => (
            <button
              key={item.key}
              onClick={() => setActiveFilter(item.key as SpaceFilter)}
              style={activeFilter === item.key ? chipActive : chip}
            >
              {item.label}
            </button>
          ))}
        </div>

        {popularSpaces.length > 0 && activeFilter === "all" && !query.trim() && (
          <div style={{ marginBottom: 22 }}>
            <div style={sectionHeader}>
              <span>Trending Spaces</span>
              <div style={sectionHint}>
                <Sparkles size={13} />
                <span>Discover</span>
              </div>
            </div>

            <div style={featuredScroll}>
              {popularSpaces.map((space) => (
                <button
                  key={space.key}
                  onClick={() => openSpace(space.key)}
                  style={featuredCard}
                >
                  <div style={featuredEmoji}>{space.emoji}</div>
                  <div style={featuredName}>{space.label}</div>
                  <div style={featuredDesc}>{space.description}</div>

                  <div style={featuredMetaRow}>
                    <span style={featuredMetaText}>{space.membersCount} members</span>
                    <span style={featuredMetaText}>{space.topicsCount} topics</span>
                  </div>

                  <div style={featuredBottomRow}>
                    <span style={featuredPill}>{getSpaceVibe(space.key)}</span>
                    <span style={featuredArrow}>
                      Open <ChevronRight size={14} />
                    </span>
                  </div>
                </button>
              ))}
            </div>
          </div>
        )}

        <div style={sectionHeader}>
          <span>All Spaces</span>
          <div style={sectionCount}>{filteredSpaces.length} shown</div>
        </div>

        {filteredSpaces.length === 0 ? (
          <div style={emptyWrap}>
            <div style={emptyTitle}>No spaces found</div>
            <div style={emptyText}>
              Try another search or switch the filter.
            </div>
          </div>
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            {filteredSpaces.map((space) => (
              <div key={space.key} style={spaceCard}>
                <button
                  onClick={() => openSpace(space.key)}
                  style={spaceMainBtn}
                >
                  <div style={spaceEmojiWrap}>{space.emoji}</div>

                  <div style={{ flex: 1, textAlign: "left" }}>
                    <div style={spaceTitleRow}>
                      <div style={spaceName}>{space.label}</div>
                      <div style={spaceTypePill}>
                        {space.key === "private" ? <Lock size={12} /> : <Globe size={12} />}
                        <span>{getSpaceTypeLabel(space.key)}</span>
                      </div>
                    </div>

                    <div style={spaceDesc}>{space.description}</div>

                    <div style={spaceMetaRow}>
                      <span style={spaceMeta}>{space.membersCount} members</span>
                      <span style={spaceMeta}>{space.topicsCount} topics</span>
                      <span style={spaceMeta}>{getSpaceVibe(space.key)}</span>
                    </div>
                  </div>
                </button>

                <div style={spaceActionsRow}>
                  <button
                    onClick={() => toggleJoinSpace(space.key)}
                    style={space.isJoined ? joinedBtn : joinBtn}
                  >
                    {space.isJoined ? "Joined" : "Join"}
                  </button>

                  <button
                    onClick={() => openSpace(space.key)}
                    style={openBtn}
                  >
                    Open
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <BottomNav />
    </div>
  )
}

