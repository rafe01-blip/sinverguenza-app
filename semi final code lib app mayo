function normalizeCommunityPost(post: CommunityPost): CommunityPost {
  const media = normalizeMediaList({
    media: post.media,
    image: post.image,
    videoUrl: post.mediaType === "video" ? post.mediaUrl : undefined,
    thumbnailUrl: post.thumbnailUrl || post.image,
    durationSeconds: post.durationSeconds,
    alt: post.content,
    fallback: post.image || DEFAULT_ASSET,
  })

  const primaryMedia = media[0]
  const mediaType = post.mediaType || primaryMedia?.type || "image"

  return {
    ...post,
    media,
    mediaType,
    mediaUrl: post.mediaUrl || primaryMedia?.url,
    thumbnailUrl:
      post.thumbnailUrl ||
      primaryMedia?.thumbnailUrl ||
      (primaryMedia?.type === "image" ? primaryMedia.url : undefined),
    durationSeconds:
      mediaType === "video"
        ? Math.min(
            post.durationSeconds ??
              primaryMedia?.durationSeconds ??
              60,
            60
          )
        : undefined,
    image: post.image || getPrimaryMediaUrl(media, ""),
    comments: post.comments ?? [],
    tags: post.tags ?? [],
    spaceKey: post.spaceKey ?? null,
    eventId: post.eventId ?? null,
    isEventThread: post.isEventThread ?? false,
  }
}
