function timeAgoFromDate(dateString: string) {
  const now = Date.now()
  const then = new Date(dateString).getTime()
  const diff = Math.max(1, now - then)

  const minutes = Math.floor(diff / (1000 * 60))
  const hours = Math.floor(diff / (1000 * 60 * 60))
  const days = Math.floor(diff / (1000 * 60 * 60 * 24))

  if (minutes < 60) return `${minutes}m`
  if (hours < 24) return `${hours}h`
  return `${days}d`
}

function getCreatorBadgeClass(role: string) {
  switch (role) {
    case "official":
      return "bg-primary/20 text-primary"
    case "instructor":
      return "bg-emerald-500/20 text-emerald-400"
    case "host":
      return "bg-violet-500/20 text-violet-400"
    default:
      return "bg-muted text-muted-foreground"
  }
}

function getCreatorBadgeText(role: string) {
  switch (role) {
    case "official":
      return "Official"
    case "instructor":
      return "Instructor"
    case "host":
      return "Host"
    default:
      return "Member"
  }
}

function getSpaceLabel(space: SpaceKey) {
  switch (space) {
    case "dance":
      return "Dance"
    case "workshop":
      return "Workshop"
    case "events":
      return "Events"
    case "fitness":
      return "Fitness"
    default:
      return "General"
  }
}

function getTopReaction(
  quickReactions?: Partial<Record<StoryReaction, number>>
): StoryReaction | null {
  if (!quickReactions) return null

  let topReaction: StoryReaction | null = null
  let topCount = 0

  STORY_REACTIONS.forEach((reaction) => {
    const count = quickReactions[reaction] ?? 0
    if (count > topCount) {
      topCount = count
      topReaction = reaction
    }
  })

  return topReaction
}

function isVideoPost(post: { type?: string; mediaType?: string }) {
  return post.type === "video" || post.mediaType === "video"
}

function getPostMediaPreview(post: {
  image?: string
  mediaType?: "image" | "video"
  mediaUrl?: string
  thumbnailUrl?: string
}) {
  return post.thumbnailUrl || post.image || post.mediaUrl || ""
}
