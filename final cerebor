function normalizeCreator(creator: Creator): Creator {
  const roleLower = String(
    creator.role || creator.badgeLabel || "member"
  ).toLowerCase()

  const badgeLabel: CreatorBadgeLabel =
    creator.badgeLabel ||
    (roleLower.includes("official")
      ? "Official"
      : roleLower.includes("instructor")
      ? "Instructor"
      : roleLower.includes("host")
      ? "Host"
      : "Member")

  const role: CreatorRole =
    roleLower.includes("official")
      ? "official"
      : roleLower.includes("instructor")
      ? "instructor"
      : roleLower.includes("host")
      ? "host"
      : "member"

  const instagramUrl =
    creator.instagramUrl ||
    creator.socials?.instagram ||
    (creator.instagram
      ? `https://instagram.com/${creator.instagram.replace("@", "")}`
      : undefined)

  const socials: SocialLinks = {
    ...(creator.socials || {}),
    instagram: creator.socials?.instagram || instagramUrl,
    whatsapp: normalizeWhatsApp(creator.socials?.whatsapp),
    whatsappGroup: normalizeUrl(creator.socials?.whatsappGroup),
    tiktok: normalizeUrl(creator.socials?.tiktok),
    facebook: normalizeUrl(creator.socials?.facebook),
    website: normalizeUrl(creator.socials?.website),
    x: normalizeUrl(creator.socials?.x),
    youtube: normalizeUrl(creator.socials?.youtube),
    discord: normalizeUrl(creator.socials?.discord),
  }

  return {
    ...creator,
    displayName: creator.displayName || creator.name,
    badgeLabel,
    role,

    avatar: safeImage(creator.avatar),
    coverImage: safeImage(creator.coverImage),

    followers: creator.followers ?? creator.followersCount ?? 0,
    following: creator.following ?? creator.followingCount ?? 0,
    posts: creator.posts ?? creator.postsCount ?? 0,
    events: creator.events ?? creator.eventsCount ?? 0,

    followersCount: creator.followersCount ?? creator.followers ?? 0,
    followingCount: creator.followingCount ?? creator.following ?? 0,
    postsCount: creator.postsCount ?? creator.posts ?? 0,
    eventsCount: creator.eventsCount ?? creator.events ?? 0,

    totalLikes: creator.totalLikes ?? 0,

    isFollowing: creator.isFollowing ?? false,
    isVerified: creator.isVerified ?? badgeLabel === "Official",

    isSystemAccount: creator.isSystemAccount ?? false,
    isOfficialAccount:
      creator.isOfficialAccount ?? creator.id === "creator-official-sv",

    instagramUrl,
    socials,
    primarySocial: creator.primarySocial || "instagram",
  }
}

function normalizeEvent(event: EventType): EventType {
  const media = normalizeMediaList({
