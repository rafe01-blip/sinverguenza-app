const INITIAL_ORDERS: OrderType[] = []

function buildOrderTrackingSteps(status: OrderStatus): OrderTrackingStep[] {
  const now = new Date().toISOString()

  const steps: OrderTrackingStep[] = [
    {
      id: "placed",
      label: "Order placed",
      completed: true,
      timestamp: now,
    },
    {
      id: "processing",
      label: "Processing",
      completed:
        status === "processing" ||
        status === "shipped" ||
        status === "delivered",
      timestamp:
        status === "processing" ||
        status === "shipped" ||
        status === "delivered"
          ? now
          : undefined,
    },
    {
      id: "shipped",
      label: "Ready / Shipped",
      completed: status === "shipped" || status === "delivered",
      timestamp:
        status === "shipped" || status === "delivered" ? now : undefined,
    },
    {
      id: "out-for-delivery",
      label: "Out for delivery",
      completed: status === "delivered",
      timestamp: status === "delivered" ? now : undefined,
    },
    {
      id: "delivered",
      label: "Delivered",
      completed: status === "delivered",
      timestamp: status === "delivered" ? now : undefined,
    },
  ]

  if (status === "cancelled") {
    return steps.map((step, index) => ({
      ...step,
      completed: index === 0,
    }))
  }

  return steps
}

