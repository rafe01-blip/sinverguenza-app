"use client"

import { useMemo, useState } from "react"
import { Search } from "lucide-react"
import { TopHeader } from "@/components/navigation/top-header"
import { BottomNav } from "@/components/navigation/bottom-nav"
import { useApp } from "@/lib/app-context"

const GOLD = "#C9A84C"
const DARK = "#0A0A0A"
const CARD = "#121212"
function getBadgeColor(label?: string) {
  const key = (label || "").toLowerCase()

  if (key.includes("official")) return "#C9A84C"
  if (key.includes("instructor")) return "#3B82F6"
  if (key.includes("host")) return "#A855F7"
  return "#6B7280"
}
export function FollowersListScreen() {
  const {
    creators,
    setSelectedCreator,
    setCurrentScreen,
    toggleFollow,
  } = useApp()

  const [query, setQuery] = useState("")
  const visibleFollowers = useMemo(() => {
    const q = query.trim().toLowerCase()

    return creators.filter((creator) => {
      if (!q) return true

      return (
        creator.name.toLowerCase().includes(q) ||
        creator.username.toLowerCase().includes(q)
      )
    })
  }, [creators, query])
  return (
    <div
      style={{
        minHeight: "100vh",
        background: DARK,
        color: "#fff",
        paddingBottom: 96,
      }}
    >
      <TopHeader title="Followers" />

      <div style={{ padding: "16px" }}>
        <div style={searchWrap}>
          <Search size={18} color="#9a9a9a" />
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search followers"
            style={searchInput}
          />
        </div>
        {visibleFollowers.length === 0 ? (
          <div style={emptyWrap}>
            <div style={emptyTitle}>No followers found</div>
            <div style={emptyText}>
              Try another name in the search bar.
            </div>
          </div>
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            {visibleFollowers.map((creator) => (
              <div
                key={creator.id}
                onClick={() => {
                  setSelectedCreator(creator)
                  setCurrentScreen("creator-profile")
                }}
                style={followerCard}
              >
                <div style={{ display: "flex", alignItems: "center", gap: 12, flex: 1 }}>
                  <div style={avatarWrap}>
                    <img
                      src={creator.avatar || "/placeholder.svg"}
                      alt={creator.name}
                      style={avatarImg}
                    />
                  </div>

                  <div style={{ flex: 1 }}>
                    <div style={{ fontWeight: 900, marginBottom: 4 }}>
                      {creator.name}
                    </div>

                    <div style={{ color: "#aaa", fontSize: 13, marginBottom: 6 }}>
                      @{creator.username}
                    </div>

                    <div
                      style={{
                        display: "inline-flex",
                        alignItems: "center",
                        padding: "6px 10px",
                        borderRadius: 999,
                        background: getBadgeColor(creator.badgeLabel),
                        color: "#fff",
                        fontWeight: 800,
                        fontSize: 11,
                      }}
                    >
                      {creator.badgeLabel}
                    </div>
                  </div>
                </div>
                <button
                  onClick={(e) => {
                    e.stopPropagation()
                    toggleFollow(creator.id)
                  }}
                  style={creator.isFollowing ? followingBtn : followBtn}
                >
                  {creator.isFollowing ? "Following" : "Follow"}
                </button>
              </div>
            ))}
          </div>
        )}
      </div>

      <BottomNav />
    </div>
  )
}
const searchWrap = {
  display: "flex",
  alignItems: "center",
  gap: 10,
  background: CARD,
  border: "1px solid rgba(255,255,255,0.08)",
  borderRadius: 18,
  padding: "12px 14px",
  marginBottom: 16,
}

const searchInput = {
  flex: 1,
  background: "transparent",
  border: "none",
  outline: "none",
  color: "#fff",
  fontSize: 14,
}
const followerCard = {
  background: CARD,
  border: "1px solid rgba(255,255,255,0.08)",
  borderRadius: 22,
  padding: "14px",
  display: "flex",
  alignItems: "center",
  gap: 12,
  cursor: "pointer",
}

