========================================================= */

function safeImage(value?: string | null) {
  if (!value || typeof value !== "string") return DEFAULT_ASSET
  const trimmed = value.trim()
  return trimmed.length > 0 ? trimmed : DEFAULT_ASSET
}

function getInitialsFallback(name?: string | null) {
  if (!name) return "SV"

  const parts = name.trim().split(" ")
  if (parts.length === 1) return parts[0][0]?.toUpperCase() || "SV"

  return (
    (parts[0][0] || "") + (parts[1][0] || "")
  ).toUpperCase()
}

function uniqueImages(images: (string | undefined | null)[]) {
  return images
    .filter((img): img is string => !!img && img.trim().length > 0)
    .map((img) => img.trim())
    .filter((img, index, arr) => arr.indexOf(img) === index)
}

function uniqueMedia(media: (MediaItem | undefined | null)[]) {
  return media
    .filter((item): item is MediaItem => !!item && !!item.url)
    .filter(
      (item, index, arr) =>
        arr.findIndex((m) => m.url === item.url) === index
    )
}

function imageToMedia(
  url: string | undefined | null,
  alt?: string,
  id?: string
): MediaItem | null {
  if (!url) return null

  return {
    id: id || `img-${Date.now()}-${Math.random()}`,
    type: "image",
    url,
    thumbnailUrl: url,
    alt,
  }
}

function videoToMedia(args: {
  id?: string
  url?: string
  thumbnailUrl?: string
  alt?: string
  durationSeconds?: number
}): MediaItem | null {
  if (!args.url) return null

  return {
    id: args.id || `video-${Date.now()}`,
    type: "video",
    url: args.url,
    thumbnailUrl: args.thumbnailUrl || DEFAULT_ASSET,
    alt: args.alt,
    durationSeconds: Math.min(args.durationSeconds ?? 60, 60),
  }
}

type NormalizeMediaArgs = {
  media?: MediaItem[]
  image?: string
  images?: string[]
  videoUrl?: string
  thumbnailUrl?: string
  durationSeconds?: number
  alt?: string
  fallback?: string
}

function normalizeMediaList(args: NormalizeMediaArgs): MediaItem[] {
  const imageMedia = uniqueImages([
    args.image,
    ...(args.images ?? []),
    args.fallback,
  ]).map((img, i) =>
    imageToMedia(img, args.alt, `img-${i + 1}`)
  )

  const videoMedia = videoToMedia({
    id: "video-1",
    url: args.videoUrl,
    thumbnailUrl: args.thumbnailUrl,
    alt: args.alt,
    durationSeconds: args.durationSeconds,
  })

  const existing: MediaItem[] = (args.media ?? []).map((item, i) => ({
    ...item,
    id: item.id || `media-${i + 1}`,
    thumbnailUrl:
      item.thumbnailUrl ||
      (item.type === "image"
        ? item.url
        : args.thumbnailUrl || DEFAULT_ASSET),
  }))

  const merged = uniqueMedia([
    ...existing,
    videoMedia,
    ...imageMedia,
  ])

  return merged.length > 0
    ? merged
    : [
        {
          id: "fallback",
          type: "image",
          url: args.fallback || DEFAULT_ASSET,
          thumbnailUrl: args.fallback || DEFAULT_ASSET,
        },
      ]
}

function getPrimaryMediaUrl(
  media?: MediaItem[],
  fallback = DEFAULT_ASSET
) {
  const first = media?.[0]
  if (!first) return fallback

  return first.type === "video"
    ? first.thumbnailUrl || fallback
    : first.url
}

function getMediaGallery(
  entity: EventType | ProductType | CommunityStory
): MediaItem[] {
  return normalizeMediaList({
    media: entity.media,
    image: (entity as any).image,
    images: (entity as any).images,
    fallback: DEFAULT_ASSET,
  })
}

function isVideoMedia(media?: MediaItem | null) {
