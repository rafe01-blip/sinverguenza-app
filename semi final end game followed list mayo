  overflow: "hidden",
  background: "#222",
  border: `2px solid ${GOLD}`,
  flexShrink: 0 as const,
}

const avatarImg = {
  width: "100%",
  height: "100%",
  objectFit: "cover" as const,
  display: "block",
}
const followBtn = {
  padding: "12px 16px",
  borderRadius: 14,
  background: `linear-gradient(135deg, ${GOLD}, #8B6914)`,
