"use client"

import { useState } from "react"
import { TopHeader } from "@/components/navigation/top-header"
import { BottomNav } from "@/components/navigation/bottom-nav"
import { useApp } from "@/lib/app-context"
import {
  User,
  Mail,
  Lock,
  Bell,
  Clock3,
  Instagram,
  Facebook,
  MessageCircle,
  Globe,
  Music2,
  Image as ImageIcon,
  Shield,
} from "lucide-react"

const GOLD = "#C9A84C"
const DARK = "#0A0A0A"
const CARD = "#121212"

export function SettingsScreen() {
  const { goBack, setCurrentScreen, user, updateMyProfile, updateMySocials } = useApp()

  const [notificationsOn, setNotificationsOn] = useState(true)
  const [use12Hour, setUse12Hour] = useState(true)

  const [name, setName] = useState(user?.name || "Mario Rosario")
  const [username, setUsername] = useState(user?.username || "mariorafaelrosario")
  const [email, setEmail] = useState(user?.email || "mario@example.com")
  const [bio, setBio] = useState(user?.bio || "Passion for dance and community ✨")

  const [instagram, setInstagram] = useState(user?.socials?.instagram || "")
  const [facebook, setFacebook] = useState(user?.socials?.facebook || "")
  const [tiktok, setTiktok] = useState(user?.socials?.tiktok || "")
  const [whatsapp, setWhatsapp] = useState(user?.socials?.whatsapp || "")
  const [website, setWebsite] = useState(user?.socials?.website || "")
  const [xLink, setXLink] = useState(user?.socials?.x || "")

  const saveProfileInfo = () => {
    updateMyProfile({
      name,
      username,
      email,
      bio,
    })
  }

  const saveSocials = () => {
    updateMySocials({
      instagram,
      facebook,
      tiktok,
      whatsapp,
      website,
      x: xLink,
    })
  }

  return (
    <div
      style={{
        minHeight: "100vh",
        background: DARK,
        color: "#fff",
        paddingBottom: 96,
      }}
    >
      <TopHeader title="Settings" />

      <div style={{ padding: "12px 16px 0" }}>
        <button onClick={goBack} style={backBtn}>
          ← Back
        </button>
      </div>

      <div style={{ padding: "0 16px 24px" }}>
        <div style={profileMiniCard}>
          <div style={profileMiniAvatar}>
            <img
              src={user?.avatar || "/placeholder.svg"}
              alt="Profile"
              style={avatarImg}
            />
          </div>

          <div style={{ flex: 1 }}>
            <div style={{ fontWeight: 900, fontSize: 18 }}>
              {name}
            </div>
            <div style={{ color: "#aaa", fontSize: 13 }}>
              @{username}
            </div>
            <div style={profileMiniPill}>Profile bridge ready</div>
          </div>
        </div>

        <div style={sectionCard}>
          <div style={sectionTitle}>Account</div>

          <div style={fieldWrap}>
            <label style={fieldLabel}>
              <User size={14} />
              <span>Name</span>
            </label>
            <input
              value={name}
              onChange={(e) => setName(e.target.value)}
              style={input}
              placeholder="Your name"
            />
          </div>

          <div style={fieldWrap}>
            <label style={fieldLabel}>
              <Shield size={14} />
              <span>Username</span>
            </label>
            <input
              value={username}
              onChange={(e) => setUsername(e.target.value)}
              style={input}
              placeholder="@username"
            />
          </div>

          <div style={fieldWrap}>
            <label style={fieldLabel}>
              <Mail size={14} />
              <span>Email</span>
            </label>
            <input
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              style={input}
              placeholder="Email"
            />
          </div>

          <div style={fieldWrapLast}>
            <label style={fieldLabel}>
              <Lock size={14} />
              <span>Bio / Status</span>
            </label>
            <textarea
              value={bio}
              onChange={(e) => setBio(e.target.value.slice(0, 140))}
              style={textarea}
              placeholder="Write something for your profile..."
            />
            <div style={charCount}>{bio.length}/140</div>
          </div>

          <button onClick={saveProfileInfo} style={saveBtn}>
            Save Account Info
          </button>
        </div>

        <div style={sectionCard}>
          <div style={sectionTitle}>Photos</div>

          <div style={photoRow}>
            <button style={photoBtn}>
              <ImageIcon size={16} />
              <span>Change Profile Photo</span>
            </button>

            <button style={photoBtn}>
              <ImageIcon size={16} />
              <span>Change Cover Photo</span>
            </button>
          </div>

          <div style={smallNote}>
            Later we can connect these buttons to real upload behavior without redesigning the screen.
          </div>
        </div>

        <div style={sectionCard}>
          <div style={sectionTitle}>Preferences</div>

          <div style={rowBtnStatic}>
            <div style={rowLeft}>
              <Bell size={16} />
              <span>Notifications</span>
            </div>

            <button
              onClick={() => setNotificationsOn(!notificationsOn)}
              style={switchWrap}
            >
              <div
                style={{
                  ...switchTrack,
                  background: notificationsOn ? GOLD : "#3a3a3a",
                }}
              />
              <div
                style={{
                  ...switchKnob,
                  transform: notificationsOn
                    ? "translateX(22px)"
                    : "translateX(0px)",
                }}
              />
            </button>
          </div>

          <div style={rowBtnStatic}>
            <div style={rowLeft}>
              <Clock3 size={16} />
              <span>12h Time Format</span>
            </div>

            <button
              onClick={() => setUse12Hour(!use12Hour)}
              style={switchWrap}
            >
              <div
                style={{
                  ...switchTrack,
                  background: use12Hour ? GOLD : "#3a3a3a",
                }}
              />
              <div
                style={{
                  ...switchKnob,
                  transform: use12Hour
                    ? "translateX(22px)"
                    : "translateX(0px)",
                }}
              />
            </button>
          </div>
        </div>

        <div style={sectionCard}>
          <div style={sectionTitle}>Socials</div>

          <div style={fieldWrap}>
            <label style={fieldLabel}>
              <Instagram size={14} />
              <span>Instagram</span>
            </label>
            <input
              value={instagram}
              onChange={(e) => setInstagram(e.target.value)}
              style={input}
              placeholder="https://instagram.com/..."
            />
          </div>

          <div style={fieldWrap}>
            <label style={fieldLabel}>
              <Facebook size={14} />
              <span>Facebook</span>
            </label>
            <input
              value={facebook}
              onChange={(e) => setFacebook(e.target.value)}
              style={input}
              placeholder="https://facebook.com/..."
            />
          </div>

          <div style={fieldWrap}>
            <label style={fieldLabel}>
              <Music2 size={14} />
              <span>TikTok</span>
            </label>
            <input
              value={tiktok}
              onChange={(e) => setTiktok(e.target.value)}
              style={input}
              placeholder="https://tiktok.com/..."
            />
          </div>

          <div style={fieldWrap}>
            <label style={fieldLabel}>
              <MessageCircle size={14} />
              <span>WhatsApp</span>
            </label>
            <input
              value={whatsapp}
              onChange={(e) => setWhatsapp(e.target.value)}
              style={input}
              placeholder="https://wa.me/..."
            />
          </div>

          <div style={fieldWrap}>
            <label style={fieldLabel}>
              <Globe size={14} />
              <span>Website</span>
            </label>
            <input
              value={website}
              onChange={(e) => setWebsite(e.target.value)}
              style={input}
              placeholder="https://..."
            />
          </div>

          <div style={fieldWrapLast}>
            <label style={fieldLabel}>
              <span style={{ fontWeight: 900 }}>X</span>
              <span>X / Twitter</span>
            </label>
            <input
              value={xLink}
              onChange={(e) => setXLink(e.target.value)}
              style={input}
              placeholder="https://x.com/..."
            />
          </div>

          <button onClick={saveSocials} style={saveBtn}>
            Save Social Links
          </button>
        </div>

        <div style={sectionCard}>
          <div style={sectionTitle}>Bridge</div>

          <div style={bridgeText}>
            Your profile is not meant to replace your social platforms. It works as a premium bridge so people can discover you here and connect with you there.
          </div>

          <div style={bridgeTags}>
            <span style={bridgeTag}>Profile</span>
            <span style={bridgeTag}>Community</span>
            <span style={bridgeTag}>Creators</span>
            <span style={bridgeTag}>Socials</span>
          </div>
        </div>

        <div style={dangerCard}>
          <div style={sectionTitle}>Danger Zone</div>

          <button
            onClick={() => setCurrentScreen("landing")}
            style={logoutBtn}
          >
            Log Out
          </button>
        </div>
      </div>

      <BottomNav />
    </div>
  )
}

