                  <Avatar
                    src={creator.avatar}
                    name={creator.displayName || creator.name}
                    size={32}
                  />

                  <div className="min-w-0">
                    <div className="flex items-center gap-1">
                      <p className="truncate text-[13px] font-semibold text-white">
                        {creator.displayName || creator.name}
                      </p>

                      {creator.isVerified && (
