  if (trendingPosts.length === 0) return null

  const visiblePosts = expanded ? trendingPosts : trendingPosts.slice(0, 1)

  return (
    <div className="px-4 pt-5">
      <button
        onClick={() => setExpanded((prev) => !prev)}
