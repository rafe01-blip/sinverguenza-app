  /* ---------- CREATORS ---------- */
  const [creators, setCreatorsState] =
    useState<Creator[]>(INITIAL_CREATORS)
  const [selectedCreator, setSelectedCreatorState] =
    useState<Creator | null>(null)

  /* ---------- COMMUNITY ---------- */
  const [communityPosts, setCommunityPosts] =
    useState<CommunityPost[]>(INITIAL_COMMUNITY_POSTS)

  const [communityStories, setCommunityStories] =
    useState<CommunityStory[]>(INITIAL_COMMUNITY_STORIES)

  /* ---------- SPACES ---------- */
  const [spaces, setSpaces] = useState<SpaceType[]>(
    INITIAL_SPACES.map(normalizeSpace)
  )
  const [activeSpace, setActiveSpace] =
    useState<SpaceKey | null>(null)

  /* ---------- STORIES VIEWER ---------- */
  const [selectedStoryId, setSelectedStoryId] =
    useState<string | null>(null)

  const [storySource, setStorySource] =
    useState<"home" | "community" | null>(null)

  /* ---------- CREATOR LIST ---------- */
  const [creatorListType, setCreatorListType] =
    useState<CreatorListType>("top-creators")

  const [creatorListTitle, setCreatorListTitle] =
    useState("Top Creators")

  const [creatorListSourceCreatorId, setCreatorListSourceCreatorId] =
    useState<string | null>(null)

  /* =========================
     USER HANDLERS
  ========================= */

  const setUser = (nextUser: UserType | null) => {
    setUserState(nextUser)

    if (nextUser) {
      setCreatorsState((prev) =>
        upsertMeCreator(prev, nextUser)
      )
    }
  }

  const updateMyProfile = (updates: Partial<UserType>) => {
    setUserState((prev) => {
      if (!prev) return prev

      const nextUser: UserType = {
        ...prev,
        ...updates,
        socials: {
          ...(prev.socials || {}),
          ...(updates.socials || {}),
        },
      }

      setCreatorsState((current) =>
        upsertMeCreator(current, nextUser)
      )

      return nextUser
    })
  }

  const updateMySocials = (updates: Partial<SocialLinks>) => {
    updateMyProfile({
      socials: {
        ...(user?.socials || {}),
        ...updates,
        whatsapp: normalizeWhatsApp(
          updates.whatsapp || user?.socials?.whatsapp
        ),
      },
    })
  }
  /* =========================
     BASIC SETTERS
  ========================= */

  const setProducts = (nextProducts: ProductType[]) => {
    setProductsState(
      nextProducts.map((product, index) => normalizeProduct(product, index))
    )
  }

  const setCreators = (nextCreators: Creator[]) => {
    setCreatorsState(
      upsertMeCreator(nextCreators.map(normalizeCreator), user || INITIAL_USER)
    )
  }

  const setSelectedCreator = (creator: Creator | null) => {
    setSelectedCreatorState(creator ? normalizeCreator(creator) : null)
  }

  /* =========================
     NAVIGATION
  ========================= */

  const navigateTo = (screen: Screen) => {
    setCurrentScreen(screen)
  }

  const goBack = () => {
    if (currentScreen === "checkout") {
      setCurrentScreen("cart")
      return
    }

    if (currentScreen === "cart") {
      setCurrentScreen("shop")
      return
    }

    if (currentScreen === "product-detail") {
      setCurrentScreen("shop")
      return
    }

    if (currentScreen === "story-viewer") {
      setCurrentScreen(storySource === "home" ? "home" : "community")
      return
    }

    if (currentScreen === "creator-profile" || currentScreen === "creator-list") {
      setCurrentScreen("community")
      return
    }

    if (currentScreen === "space") {
      setCurrentScreen("spaces")
      return
    }

    if (currentScreen === "create-space") {
      setCurrentScreen("spaces")
      return
    }

    if (currentScreen === "event-detail") {
      if (lastEventSource === "calendar") {
        setCurrentScreen("calendar")
        return
      }

      setCurrentScreen("home")
      return
    }

    if (currentScreen === "settings") {
      setCurrentScreen("profile")
      return
    }

    setCurrentScreen("home")
  }

  /* =========================
     CALENDAR OPEN HELPERS
  ========================= */

  const openPinnedCalendarFocus = () => {
    const pinnedEvents = events
      .map(normalizeEvent)
      .filter((event) => event.isPinned && isFutureOrTodayEvent(event))
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))

    const firstPinned = pinnedEvents[0]

    setCalendarViewMode("focus")
    setCalendarEntrySource("home-pinned")
    setCurrentScreen("calendar")

    if (firstPinned) {
      setSelectedDate(firstPinned.date)
      setCalendarHighlightedEventId(firstPinned.id)
    }
  }

  const openCalendarExpandFromHome = (date?: string) => {
    setCalendarViewMode("expand")
    setCalendarEntrySource("home-date")
    setCalendarHighlightedEventId(null)
    setSelectedDate(date || todayDateString())
    setCurrentScreen("calendar")
  }

  const openEventInCalendar = (
    eventId: string,
    mode: CalendarEntryMode = "focus"
  ) => {
    const targetEvent = events.find((event) => event.id === eventId)
    if (!targetEvent) return

    setCalendarViewMode(mode)
    setCalendarEntrySource("event-detail")
    setSelectedDate(targetEvent.date)
    setCalendarHighlightedEventId(targetEvent.id)
    setCurrentScreen("calendar")
  }
  /* =========================
     EVENT ACTIONS
  ========================= */

  const createEvent = (event: EventType) => {
    const normalizedEvent = normalizeEvent({
      ...event,
      reminderConfig: event.reminderConfig ?? buildMarioReminderConfig(),
    })

    setEvents((prev) => [normalizedEvent, ...prev.map(normalizeEvent)])

    setUserState((prev) => {
      if (!prev) return prev

      return {
        ...prev,
        createdEventCount: (prev.createdEventCount ?? 0) + 1,
      }
    })

    const threadPost = buildEventThreadPost(
      normalizedEvent,
      normalizedEvent.organizerCreatorId || user?.id || "me-user"
    )

    setCommunityPosts((prev) => [
      threadPost,
      ...prev.map(normalizeCommunityPost),
    ])
  }

  const updateEvent = (eventId: string, updates: Partial<EventType>) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({ ...event, ...updates })
          : normalizeEvent(event)
      )
    )

    setSelectedEvent((prev) =>
      prev && prev.id === eventId
        ? normalizeEvent({ ...prev, ...updates })
        : prev
    )
  }

  const toggleLike = (eventId: string) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              isLiked: !event.isLiked,
              likes: (event.likes ?? 0) + (event.isLiked ? -1 : 1),
            })
          : normalizeEvent(event)
      )
    )

    setSelectedEvent((prev) =>
      prev && prev.id === eventId
        ? normalizeEvent({
            ...prev,
            isLiked: !prev.isLiked,
            likes: (prev.likes ?? 0) + (prev.isLiked ? -1 : 1),
          })
        : prev
    )
  }

  const toggleSave = (eventId: string) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              isSaved: !event.isSaved,
            })
          : normalizeEvent(event)
      )
    )

    setSelectedEvent((prev) =>
      prev && prev.id === eventId
        ? normalizeEvent({
            ...prev,
            isSaved: !prev.isSaved,
          })
        : prev
    )
  }

  const togglePinEvent = (eventId: string) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              isPinned: !event.isPinned,
            })
          : normalizeEvent(event)
      )
    )

    setSelectedEvent((prev) =>
      prev && prev.id === eventId
        ? normalizeEvent({
            ...prev,
            isPinned: !prev.isPinned,
          })
        : prev
    )
  }

  const setAttendanceStatus = (
    eventId: string,
    status: EventAttendanceStatus
  ) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              attendanceStatus:
                event.attendanceStatus === status ? null : status,
            })
          : normalizeEvent(event)
      )
    )

    setSelectedEvent((prev) =>
      prev && prev.id === eventId
        ? normalizeEvent({
            ...prev,
            attendanceStatus:
              prev.attendanceStatus === status ? null : status,
          })
        : prev
    )
  }

  const getPinnedEvents = () => {
    return events
      .map(normalizeEvent)
      .filter((event) => event.isPinned && isFutureOrTodayEvent(event))
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
      .slice(0, 3)
  }

  const getSavedEvents = () => {
    return events
      .map(normalizeEvent)
      .filter((event) => event.isSaved && isFutureOrTodayEvent(event))
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
  }

  const getGoingEvents = () => {
    return events
      .map(normalizeEvent)
      .filter(
        (event) =>
          event.attendanceStatus === "going" && isFutureOrTodayEvent(event)
      )
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
  }

  const addComment = (eventId: string, text: string) => {
    const trimmed = text.trim()
    if (!trimmed) return

    const newComment: EventComment = {
      id: `event-comment-${Date.now()}`,
      userName: user?.name || "Mario",
      text: trimmed,
      createdAt: new Date().toISOString(),
      replies: [],
    }

    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              comments: [...normalizeComments(event.comments), newComment],
              commentsCount: (event.commentsCount ?? 0) + 1,
            })
          : normalizeEvent(event)
      )
    )
  }

  const addReplyToComment = (
    eventId: string,
    commentId: string,
    text: string
  ) => {
    const trimmed = text.trim()
    if (!trimmed) return

    const newReply: EventCommentReply = {
      id: `event-reply-${Date.now()}`,
      userName: user?.name || "Mario",
      text: trimmed,
      createdAt: new Date().toISOString(),
    }

    setEvents((prev) =>
      prev.map((event) => {
        if (event.id !== eventId) return normalizeEvent(event)

        const comments = normalizeComments(event.comments).map((comment) =>
          comment.id === commentId
            ? {
                ...comment,
                replies: [...(comment.replies ?? []), newReply],
              }
            : comment
        )

        return normalizeEvent({
          ...event,
          comments,
        })
      })
    )
  }
  /* =========================
     CREATOR ACTIONS
  ========================= */

  const openCreatorProfile = (creatorId: string) => {
    const creator = creators.find((item) => item.id === creatorId)
    if (!creator) return

    setSelectedCreatorState(normalizeCreator(creator))
    setCurrentScreen("creator-profile")
  }

  const toggleFollow = (id: string) => {
    setCreatorsState((prev) =>
      prev.map((creator) => {
        if (creator.id !== id) return normalizeCreator(creator)

        const nextFollowing = !creator.isFollowing
        const followersCount = creator.followersCount ?? creator.followers ?? 0

        return normalizeCreator({
          ...creator,
          isFollowing: nextFollowing,
          followersCount: nextFollowing
            ? followersCount + 1
            : Math.max(0, followersCount - 1),
          followers: nextFollowing
            ? followersCount + 1
            : Math.max(0, followersCount - 1),
        })
      })
    )

    setSelectedCreatorState((prev) => {
      if (!prev || prev.id !== id) return prev

      const nextFollowing = !prev.isFollowing
      const followersCount = prev.followersCount ?? prev.followers ?? 0

      return normalizeCreator({
        ...prev,
        isFollowing: nextFollowing,
        followersCount: nextFollowing
          ? followersCount + 1
          : Math.max(0, followersCount - 1),
        followers: nextFollowing
          ? followersCount + 1
          : Math.max(0, followersCount - 1),
      })
    })
  }

  const getTopCreators = () => {
    return creators
      .map(normalizeCreator)
      .sort((a, b) => (b.followersCount ?? 0) - (a.followersCount ?? 0))
      .slice(0, 10)
  }

  const getCreatorFollowers = (creatorId: string) => {
    return creators
      .map(normalizeCreator)
      .filter((creator) => creator.id !== creatorId)
      .slice(0, 25)
  }

  const getCreatorFollowing = (creatorId: string) => {
    return creators
      .map(normalizeCreator)
      .filter((creator) => creator.isFollowing)
      .slice(0, 25)
  }

  const getCreatorEvents = (creatorId: string) => {
    return events
      .map(normalizeEvent)
      .filter((event) => event.organizerCreatorId === creatorId)
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
  }

  const openCreatorList = (
    type: CreatorListType,
    creatorId?: string | null,
    title?: string
  ) => {
    setCreatorListType(type)
    setCreatorListSourceCreatorId(creatorId || null)

    if (title) {
      setCreatorListTitle(title)
    } else {
      if (type === "followers") setCreatorListTitle("Followers")
      else if (type === "following") setCreatorListTitle("Following")
      else setCreatorListTitle("Top Creators")
    }

    setCurrentScreen("creator-list")
  }

  /* =========================
     COMMUNITY ACTIONS
  ========================= */

  const createCommunityPost = (input: CreateCommunityPostInput) => {
    const id = `post-${Date.now()}`
    const createdAt = new Date().toISOString()

    if (input.type === "story") {
      const newStory: CommunityStory = normalizeStory({
        id,
        authorId: user?.id || "me-user",
        type: "story",
        content: input.content,
        image: input.image,
        createdAt,
        expiresAt: makeDateIn(24),
        storyViewMode: input.storyViewMode || "internal",
        audience: input.audience || "public",
        slides:
          input.slides && input.slides.length > 0
            ? input.slides
            : [
                {
                  id: `${id}-slide-1`,
                  type: "image",
                  image: input.image || DEFAULT_ASSET,
                  content: input.content,
                  createdAt,
                },
              ],
        media: input.media,
      })

      setCommunityStories((prev) => [newStory, ...prev.map(normalizeStory)])
      return
    }

    const newPost: CommunityPost = normalizeCommunityPost({
      id,
      authorId: user?.id || "me-user",
type: input.type === "poll" ? "poll" : input.type === "video" ? "video" : "post",
      content: input.content,
      image: input.image,
      mediaType: input.type === "video" ? "video" : "image",
      mediaUrl: input.image,
      thumbnailUrl: input.image,
      createdAt,
      expiresAt: sevenDaysFromNow(),
      likes: 0,
      isLiked: false,
      comments: [],
      instagramUrl: input.instagramUrl,
      pollOptions:
        input.type === "poll" && input.pollOptions
          ? input.pollOptions.map((text, index) => ({
              id: `${id}-option-${index + 1}`,
              text,
              votes: 0,
            }))
          : undefined,
      spaceKey: input.spaceKey ?? null,
      tags: [],
    })

    setCommunityPosts((prev) => [newPost, ...prev.map(normalizeCommunityPost)])
  }
  const toggleCommunityLike = (postId: string) => {
    setCommunityPosts((prev) =>
      prev.map((post) =>
        post.id === postId
          ? normalizeCommunityPost({
              ...post,
              isLiked: !post.isLiked,
              likes: post.isLiked
                ? Math.max(0, post.likes - 1)
                : post.likes + 1,
            })
          : normalizeCommunityPost(post)
      )
    )
  }

  const addCommunityComment = (postId: string, text: string) => {
    const trimmed = text.trim()
    if (!trimmed) return

    const newComment: CommunityComment = {
      id: `comment-${Date.now()}`,
      authorId: user?.id || "me-user",
      authorName: user?.name || "Mario",
      authorAvatar: user?.avatar || DEFAULT_ASSET,
      content: trimmed,
      createdAt: new Date().toISOString(),
      replies: [],
    }

    setCommunityPosts((prev) =>
      prev.map((post) =>
        post.id === postId
          ? normalizeCommunityPost({
              ...post,
              comments: [...post.comments, newComment],
            })
          : normalizeCommunityPost(post)
      )
    )
  }

  const addCommunityReply = (
    postId: string,
    commentId: string,
    text: string
  ) => {
    const trimmed = text.trim()
    if (!trimmed) return

    const newReply: CommunityReply = {
      id: `reply-${Date.now()}`,
      authorId: user?.id || "me-user",
      authorName: user?.name || "Mario",
      authorAvatar: user?.avatar || DEFAULT_ASSET,
      content: trimmed,
      createdAt: new Date().toISOString(),
    }

    setCommunityPosts((prev) =>
      prev.map((post) => {
        if (post.id !== postId) return normalizeCommunityPost(post)

        return normalizeCommunityPost({
          ...post,
          comments: post.comments.map((comment) =>
            comment.id === commentId
              ? {
                  ...comment,
                  replies: [...comment.replies, newReply],
                }
              : comment
          ),
        })
      })
    )
  }

  const voteOnPoll = (postId: string, optionId: string) => {
    setCommunityPosts((prev) =>
      prev.map((post) => {
        if (post.id !== postId || post.type !== "poll" || !post.pollOptions) {
          return normalizeCommunityPost(post)
        }

        if (post.selectedPollOptionId) return normalizeCommunityPost(post)

        return normalizeCommunityPost({
          ...post,
          selectedPollOptionId: optionId,
          pollOptions: post.pollOptions.map((option) =>
            option.id === optionId
              ? {
                  ...option,
                  votes: option.votes + 1,
                }
              : option
          ),
        })
      })
    )
  }

  /* =========================
     STORY ACTIONS
  ========================= */

  const getStoriesForSource = (source: "home" | "community") => {
    const myUserId = user?.id || "me-user"

    const followingCreatorIds = new Set(
      creators
        .filter((creator) => creator.isFollowing)
        .map((creator) => creator.id)
    )

    const activeStories = communityStories
      .map(normalizeStory)
      .filter((story) => !isStoryExpired(story))
      .filter((story) => {
        if (source === "home") {
          const isMine = story.authorId === myUserId
          const isFollowing = followingCreatorIds.has(story.authorId)

          if (isMine) return true

          return (
            isFollowing &&
            (story.audience === "followers" || story.audience === "both")
          )
        }

        return story.audience === "public" || story.audience === "both"
      })

    const latestPerAuthor = new Map<string, CommunityStory>()

    activeStories.forEach((story) => {
      const existing = latestPerAuthor.get(story.authorId)

      if (
        !existing ||
        getStorySortTimestamp(story) > getStorySortTimestamp(existing)
      ) {
        latestPerAuthor.set(story.authorId, story)
      }
    })

    const stories = Array.from(latestPerAuthor.values())

    const ensuredMarioStory =
      source === "home" && !stories.some((story) => story.authorId === myUserId)
        ? [
            normalizeStory({
              id: "story-mario-placeholder",
              authorId: myUserId,
              type: "story",
              content: "Your Story",
              image: user?.avatar || DEFAULT_ASSET,
              createdAt: new Date().toISOString(),
              expiresAt: makeDateIn(24),
              instagramUrl: user?.socials?.instagram,
              storyViewMode: "internal",
              audience: "both",
              seenByMe: false,
              likesCount: 0,
              isLiked: false,
              slides: [
                {
                  id: "story-mario-placeholder-slide-1",
                  type: "image",
                  image: user?.avatar || DEFAULT_ASSET,
                  content: "Your Story",
                  createdAt: new Date().toISOString(),
                },
              ],
              quickReactions: {},
              myReaction: null,
              replies: [],
            }),
            ...stories,
          ]
        : stories

    return sortStoriesForSource(ensuredMarioStory, source, myUserId)
  }

  const markStorySeen = (storyId: string) => {
    setCommunityStories((prev) =>
      prev.map((story) =>
        story.id === storyId
          ? normalizeStory({
              ...story,
              seenByMe: true,
            })
          : normalizeStory(story)
      )
    )
  }

  const toggleStoryLike = (storyId: string) => {
    setCommunityStories((prev) =>
      prev.map((story) =>
        story.id === storyId
          ? normalizeStory({
              ...story,
              isLiked: !story.isLiked,
              likesCount: (story.likesCount ?? 0) + (story.isLiked ? -1 : 1),
            })
          : normalizeStory(story)
      )
    )
  }

  const addStoryReply = (storyId: string, text: string) => {
    const trimmed = text.trim()
    if (!trimmed) return

    const newReply: StoryReply = {
      id: `story-reply-${Date.now()}`,
      authorId: user?.id || "me-user",
      authorName: user?.name || "Mario",
      authorAvatar: user?.avatar || DEFAULT_ASSET,
      text: trimmed,
      createdAt: new Date().toISOString(),
    }

    setCommunityStories((prev) =>
      prev.map((story) =>
        story.id === storyId
          ? normalizeStory({
              ...story,
              replies: [...(story.replies ?? []), newReply],
            })
          : normalizeStory(story)
      )
    )
  }

  const setStoryReaction = (storyId: string, reaction: StoryReaction) => {
    setCommunityStories((prev) =>
      prev.map((story) => {
        if (story.id !== storyId) return normalizeStory(story)

        const nextQuickReactions = {
          "❤️": story.quickReactions?.["❤️"] ?? 0,
          "🔥": story.quickReactions?.["🔥"] ?? 0,
          "👏": story.quickReactions?.["👏"] ?? 0,
          "🕺🏾": story.quickReactions?.["🕺🏾"] ?? 0,
          "💃": story.quickReactions?.["💃"] ?? 0,
          "😎": story.quickReactions?.["😎"] ?? 0,
          "🤣": story.quickReactions?.["🤣"] ?? 0,
        }

        if (story.myReaction) {
          nextQuickReactions[story.myReaction] = Math.max(
            0,
            (nextQuickReactions[story.myReaction] ?? 0) - 1
          )
        }

        const isSameReaction = story.myReaction === reaction

        if (isSameReaction) {
          return normalizeStory({
            ...story,
            myReaction: null,
            quickReactions: nextQuickReactions,
          })
        }

        nextQuickReactions[reaction] =
          (nextQuickReactions[reaction] ?? 0) + 1

        return normalizeStory({
          ...story,
          myReaction: reaction,
          quickReactions: nextQuickReactions,
        })
      })
    )
  }

  const openStory = (storyId: string, source: "home" | "community") => {
    const exists = communityStories.some((story) => story.id === storyId)

    if (exists) {
      markStorySeen(storyId)
    }

    setSelectedStoryId(storyId)
    setStorySource(source)
    setCurrentScreen("story-viewer")
  }
  /* =========================
     SPACE ACTIONS
  ========================= */

  const getSpaceFreshness = (space: SpaceType): SpaceFreshness => {
    return getSpaceFreshnessFromDates(space.createdAt, space.expiresAt)
  }

  const openSpace = (space: SpaceKey) => {
    setActiveSpace(space)
    setCurrentScreen("space")
  }

  const requestJoinSpace = (space: SpaceKey) => {
    setSpaces((prev) =>
      prev.map((item) =>
        item.key === space
          ? normalizeSpace({
              ...item,
              requestStatus: item.requestStatus === "pending" ? "none" : "pending",
              isJoined: false,
            })
          : normalizeSpace(item)
      )
    )
  }

  const toggleJoinSpace = (space: SpaceKey) => {
    setSpaces((prev) =>
      prev.map((item) => {
        if (item.key !== space) return normalizeSpace(item)

        if (item.visibility === "private" && !item.isJoined) {
          return normalizeSpace({
            ...item,
            requestStatus: "pending",
            isJoined: false,
          })
        }

        const nextJoined = !item.isJoined

        return normalizeSpace({
          ...item,
          isJoined: nextJoined,
          requestStatus: nextJoined ? "approved" : "none",
          membersCount: nextJoined
            ? item.membersCount + 1
            : Math.max(0, item.membersCount - 1),
        })
      })
    )
  }

  const getSpaceLimitInfo = () => buildSpaceLimitInfo(user)

  const createSpace = (input: CreateSpaceInput) => {
    const limitInfo = buildSpaceLimitInfo(user)
    if (!limitInfo.canCreateMore) return false

    const key: SpaceKey =
      input.linkedEventId ? "events" : input.visibility === "private" ? "private" : "general"

    const newSpace: SpaceType = normalizeSpace({
      key,
      label: input.label.trim() || "New Space",
      emoji: input.emoji.trim() || "💬",
      description: input.description.trim() || "A fresh community space.",
      membersCount: 1,
      topicsCount: 0,
      isJoined: true,
      visibility: input.visibility,
      requestStatus: "approved",
      linkedEventId: input.linkedEventId,
      createdAt: new Date().toISOString(),
      expiresAt: sevenDaysFromNow(),
    })

    setSpaces((prev) => [newSpace, ...prev.map(normalizeSpace)])

    setUserState((prev) =>
      prev
        ? {
            ...prev,
            createdSpaceCount: (prev.createdSpaceCount ?? 0) + 1,
          }
        : prev
    )

    return true
  }

  const getSpacePosts = (space: SpaceKey | null) => {
    return communityPosts
      .map(normalizeCommunityPost)
      .filter((post) => (space ? post.spaceKey === space : true))
      .filter((post) => !post.expiresAt || !isExpired(post.expiresAt))
      .filter((post) => isFreshWithin7Days(post.createdAt))
      .sort(
        (a, b) =>
          new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
      )
  }

  /* =========================
     CART ACTIONS
  ========================= */

  const addToCart = ({
    product,
    size,
    color,
    quantity,
  }: {
    product: ProductType
    size: string
    color: string
    quantity: number
  }) => {
    const normalizedProduct = normalizeProduct(product, product.sortOrder ?? 0)

    const productImage =
      normalizedProduct.featuredImage ||
      normalizedProduct.image ||
      normalizedProduct.images?.[0] ||
      DEFAULT_ASSET

    setCartItems((prev) => {
      const existing = prev.find(
        (item) =>
          item.productId === normalizedProduct.id &&
          item.size === size &&
          item.color === color
      )

      if (existing) {
        return prev.map((item) =>
          item.id === existing.id
            ? { ...item, quantity: item.quantity + quantity }
            : item
        )
      }

      return [
        ...prev,
        {
          id: `cart-${Date.now()}`,
          productId: normalizedProduct.id,
          productName: normalizedProduct.name,
          productImage,
          size,
          color,
          quantity,
          price: normalizedProduct.price,
        },
      ]
    })
  }

  const removeFromCart = (id: string) => {
    setCartItems((prev) => prev.filter((item) => item.id !== id))
  }

  const updateCartQuantity = (id: string, qty: number) => {
    if (qty <= 0) {
      removeFromCart(id)
      return
    }

    setCartItems((prev) =>
      prev.map((item) => (item.id === id ? { ...item, quantity: qty } : item))
    )
  }

  const clearCart = () => {
    setCartItems([])
  }

  const cartSubtotal = useMemo(
    () => cartItems.reduce((sum, item) => sum + item.price * item.quantity, 0),
    [cartItems]
  )

  const cartShipping = cartItems.length > 0 && cartSubtotal < 75 ? 8 : 0
  const cartTotal = cartSubtotal + cartShipping

  /* =========================
     NOTIFICATIONS
  ========================= */

  const [notifications, setNotifications] = useState<NotificationItem[]>([
    {
      id: "notification-event-1",
      type: "events",
      title: "Bachata con Flow",
      message: "Your pinned event is coming up soon.",
      createdAt: makeDateAgo(2),
      isRead: false,
      targetType: "event",
      targetId: "event-sv-bachata-flow",
      image: EVENT_SV_BACHATA_FLOW,
    },
    {
      id: "notification-space-1",
      type: "spaces",
      title: "Dance Space is active",
      message: "New conversations are happening in Dance.",
      createdAt: makeDateAgo(5),
      isRead: false,
      targetType: "space",
      targetId: "dance",
    },
    {
      id: "notification-shop-1",
      type: "store",
      title: "SV Matching Set",
      message: "Black matching set is trending.",
      createdAt: makeDateAgo(10),
      isRead: true,
      targetType: "product",
      targetId: "sv-matching-set-black",
      image: PRODUCT_MATCHING_SET_BLACK,
    },
  ])

  const [selectedNotification, setSelectedNotification] =
    useState<NotificationItem | null>(null)

  const markNotificationRead = (notificationId: string) => {
    setNotifications((prev) =>
      prev.map((notification) =>
        notification.id === notificationId
          ? { ...notification, isRead: true }
          : notification
      )
    )
  }

  const markAllNotificationsRead = () => {
    setNotifications((prev) =>
      prev.map((notification) => ({ ...notification, isRead: true }))
    )
  }

  const openNotificationTarget = (notification: NotificationItem) => {
    setSelectedNotification(notification)
    markNotificationRead(notification.id)

    if (notification.targetType === "event" && notification.targetId) {
      const event = events.find((item) => item.id === notification.targetId)
      if (event) {
        setSelectedEvent(event)
        setLastEventSource("calendar")
        setCurrentScreen("event-detail")
      }
      return
    }

    if (notification.targetType === "space" && notification.targetId) {
      openSpace(notification.targetId as SpaceKey)
      return
    }

    if (notification.targetType === "creator" && notification.targetId) {
      openCreatorProfile(notification.targetId)
      return
    }

    if (notification.targetType === "product" && notification.targetId) {
      const product = products.find((item) => item.id === notification.targetId)
      if (product) {
        setSelectedProduct(product)
        setCurrentScreen("product-detail")
      }
      return
    }

    if (
      (notification.targetType === "community-post" ||
        notification.targetType === "event-thread") &&
      notification.targetId
    ) {
      setCurrentScreen("community")
      return
    }

    setCurrentScreen("notifications")
  }

  /* =========================
     CONTEXT VALUE
  ========================= */

  return (
    <AppContext.Provider
      value={{
        currentScreen,
        setCurrentScreen,
        navigateTo,
        goBack,

        user,
        setUser,
        updateMyProfile,
        updateMySocials,

        homeSelectedDate,
        setHomeSelectedDate,

        events,
        selectedEvent,
        setSelectedEvent,
        lastEventSource,
        setLastEventSource,

        createEvent,
        updateEvent,
        toggleLike,
        toggleSave,
        togglePinEvent,
        setAttendanceStatus,

        getPinnedEvents,
        getSavedEvents,
        getGoingEvents,

        openPinnedCalendarFocus,
        openCalendarExpandFromHome,
        openEventInCalendar,

        addComment,
        addReplyToComment,

        calendarSearchOpen,
        setCalendarSearchOpen,
        calendarSearchQuery,
        setCalendarSearchQuery,

        selectedDate,
        setSelectedDate,
        currentMonth,
        setCurrentMonth,
        calendarFilters,
        setCalendarFilters,
        calendarViewMode,
        setCalendarViewMode,
        calendarEntrySource,
        setCalendarEntrySource,
        calendarHighlightedEventId,
        setCalendarHighlightedEventId,

        products,
        setProducts,
        selectedProduct,
        setSelectedProduct,

        cartItems,
        addToCart,
        removeFromCart,
        updateCartQuantity,
        clearCart,
        cartSubtotal,
        cartShipping,
        cartTotal,

        creators,
        setCreators,
        selectedCreator,
        setSelectedCreator,
        openCreatorProfile,
        toggleFollow,

        creatorListType,
        creatorListTitle,
        openCreatorList,
        getTopCreators,
        getCreatorFollowers,
        getCreatorFollowing,
        getCreatorEvents,

        communityPosts,
        communityStories,
        createCommunityPost,
        toggleCommunityLike,
        addCommunityComment,
        addCommunityReply,
        voteOnPoll,

        getStoriesForSource,
        markStorySeen,
        toggleStoryLike,
        addStoryReply,
        setStoryReaction,

        selectedStoryId,
        setSelectedStoryId,
        storySource,
        openStory,

        spaces,
        activeSpace,
        setActiveSpace,
        openSpace,
        toggleJoinSpace,
        requestJoinSpace,
        createSpace,
        getSpaceLimitInfo,
        getSpacePosts,
        getSpaceFreshness,

        notifications,
        markNotificationRead,
        markAllNotificationsRead,
        openNotificationTarget,
        selectedNotification,
        setSelectedNotification,
      }}
    >
      {children}
    </AppContext.Provider>
  )
}

/* =========================
   HOOK
========================= */

export const useApp = () => {
  const context = useContext(AppContext)

  if (!context) {
    throw new Error("useApp must be used inside AppProvider")
  }

  return context
}
