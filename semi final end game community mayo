function StoryCard({ storyId }: { storyId: string }) {
  const {
    communityStories,
    creators,
    openStory,
    toggleStoryLike,
    setStoryReaction,
  } = useApp()

  const story = communityStories.find((item) => item.id === storyId)
  if (!story) return null

  const creator = creators.find((item) => item.id === story.authorId)
  if (!creator) return null

  const firstSlide = story.slides?.[0]

  const coverImage =
    firstSlide?.thumbnailUrl ||
    firstSlide?.image ||
    story.thumbnailUrl ||
    story.image ||
    creator.coverImage ||
    creator.avatar

  const storyIsVideo = story.type === "video" || firstSlide?.type === "video"
  const topReaction = getTopReaction(story.quickReactions)
  const totalReplies = story.replies?.length ?? 0

  return (
    <div className="w-[132px] shrink-0">
      <button
        onClick={() => openStory(story.id, "community")}
        className="group block w-full text-left"
      >
        <div className="relative h-[172px] overflow-hidden rounded-[22px] border border-white/10 bg-[#111] shadow-[0_12px_28px_rgba(0,0,0,0.28)]">
          <SafeImage
            src={coverImage}
            alt={story.content || creator.name}
            className="object-cover transition-transform duration-300 group-active:scale-[1.02]"
          />

          <div className="absolute inset-0 bg-gradient-to-t from-black/88 via-black/20 to-black/15" />
          <div className="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(201,168,76,0.14),transparent_30%)]" />

          <div className="absolute left-2 top-2 flex items-center gap-1.5">
            <Avatar
              src={creator.avatar}
              name={creator.displayName || creator.name}
              size={28}
            />

            {creator.isVerified && (
              <div className="flex h-4 w-4 items-center justify-center rounded-full bg-primary text-black">
                <BadgeCheck className="h-3 w-3" />
              </div>
            )}
          </div>

          <div className="absolute right-2 top-2 rounded-full border border-white/10 bg-black/45 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-[0.14em] text-white/80 backdrop-blur-md">
            {storyIsVideo ? "Video" : "24h"}
          </div>

          {storyIsVideo && (
            <div className="absolute inset-0 flex items-center justify-center">
              <div className="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-black/55 text-white backdrop-blur-md">
                <Play className="ml-0.5 h-4 w-4 fill-white" />
              </div>
            </div>
          )}

          <div className="absolute inset-x-2 bottom-2">
            <div className="rounded-[16px] border border-white/10 bg-black/45 px-2.5 py-2 backdrop-blur-md">
              <p className="truncate text-[11px] font-semibold text-white">
                {creator.displayName || creator.name}
              </p>

              <p className="mt-0.5 line-clamp-2 text-[11px] leading-4 text-white/75">
                {story.content}
              </p>

              <div className="mt-1.5 flex items-center justify-between gap-2 text-[9px] text-white/55">
                <span>{timeAgoFromDate(story.createdAt)}</span>
                <span>{story.likesCount ?? 0} likes</span>
              </div>
            </div>
          </div>
        </div>
      </button>

      <div className="mt-2 flex items-center justify-between gap-1">
        <button
          onClick={() => toggleStoryLike(story.id)}
          className={`flex h-7 items-center gap-1 rounded-full border px-2 text-[10px] font-medium ${
            story.isLiked
              ? "border-red-500/30 bg-red-500/12 text-red-400"
              : "border-white/10 bg-white/[0.04] text-zinc-300"
          }`}
        >
          <Heart className={`h-3 w-3 ${story.isLiked ? "fill-red-500" : ""}`} />
          {story.likesCount ?? 0}
        </button>

        <div className="flex items-center gap-1">
          {STORY_REACTIONS.slice(0, 2).map((reaction) => (
            <button
              key={reaction}
              onClick={() => setStoryReaction(story.id, reaction)}
              className={`flex h-7 w-7 items-center justify-center rounded-full border text-[12px] ${
                story.myReaction === reaction
                  ? "border-primary bg-primary/15"
                  : "border-white/10 bg-white/[0.04]"
              }`}
            >
              {reaction}
            </button>
          ))}
        </div>
      </div>

      <div className="mt-1 flex items-center justify-between gap-2 text-[9px] text-zinc-500">
        <span className="truncate">
          {topReaction ? `Top ${topReaction}` : story.seenByMe ? "Seen" : "New"}
        </span>

        <span>{totalReplies} replies</span>
      </div>
    </div>
  )
}

