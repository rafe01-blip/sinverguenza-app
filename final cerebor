    likes: post.likes ?? 0,
    isLiked: post.isLiked ?? false,
    replies: post.replies ?? [],
    expiresAt: post.expiresAt || sevenDaysFromNow(),
  }
}

function normalizeProductColorOptions(
  product: ProductType
): ProductColorOption[] {
  const baseImages = uniqueImages([
    product.image,
    product.heroImage,
    ...(product.images ?? []),
    ...(product.lifestyleImages ?? []),
  ])

  const safeBaseImages =
    baseImages.length > 0 ? baseImages : [product.image || DEFAULT_ASSET]

  if (product.colorOptions && product.colorOptions.length > 0) {
    return product.colorOptions.map((option, index) => {
      const optionImages = uniqueImages([
        option.image,
        option.heroImage,
        option.featuredImage,
        option.hoverImage,
        ...(option.images ?? []),
        ...(option.lifestyleImages ?? []),
      ])

      const safeOptionImages =
        optionImages.length > 0 ? optionImages : safeBaseImages

      return {
        ...option,
        id: option.id || `${product.id}-color-${index + 1}`,
        label:
          option.label ||
          product.colors?.[index] ||
          `Color ${index + 1}`,
        swatch: option.swatch || option.label || product.colors?.[index],
        image: option.image || safeOptionImages[0],
        images: safeOptionImages,
        lifestyleImages: option.lifestyleImages ?? [],
        heroImage: option.heroImage || safeOptionImages[0],
        featuredImage: option.featuredImage || safeOptionImages[0],
        hoverImage:
          option.hoverImage || safeOptionImages[1] || safeOptionImages[0],
        isDefault: option.isDefault ?? index === 0,
      }
    })
  }

  const fallbackColors =
    product.colors && product.colors.length > 0
      ? product.colors
      : ["Default"]

  return fallbackColors.map((color, index) => ({
    id: `${product.id}-color-${index + 1}`,
    label: color,
    swatch: color,
    image: safeBaseImages[0],
    images: safeBaseImages,
    lifestyleImages: product.lifestyleImages ?? [],
    heroImage: safeBaseImages[0],
    featuredImage: safeBaseImages[0],
    hoverImage: safeBaseImages[1] || safeBaseImages[0],
    isDefault: index === 0,
  }))
}

function normalizeProduct(product: ProductType, index: number): ProductType {
  const stock = typeof product.stock === "number" ? product.stock : 12

  const availability: ProductType["availability"] =
    stock <= 0 ? "out-of-stock" : stock <= 8 ? "low-stock" : "in-stock"

  const media = normalizeMediaList({
    media: product.media,
    image: product.image,
    images: product.images,
    fallback: DEFAULT_ASSET,
    alt: product.name,
  })

  const colorOptions = normalizeProductColorOptions({
    ...product,
    image: getPrimaryMediaUrl(media),
    images: media.map((item) => item.url),
  })

  const defaultColor =
    colorOptions.find((option) => option.isDefault) || colorOptions[0]

  const finalImages =
    defaultColor?.images && defaultColor.images.length > 0
      ? defaultColor.images
      : media.map((item) => item.url)

  return {
    ...product,
    media,
    image: safeImage(getPrimaryMediaUrl(media)),
    images: finalImages,
    colors:
      product.colors && product.colors.length > 0
        ? product.colors
        : colorOptions.map((option) => option.label),
    colorOptions,
    shortDescription:
      product.shortDescription ||
      product.description?.slice(0, 90) ||
      "Premium Sin Vergüenza piece",
    stock,
    availability,
    compareAtPrice:
      product.compareAtPrice ??
      (product.price >= 50
        ? Number((product.price * 1.2).toFixed(0))
        : undefined),
    featured:
      product.featured ??
      (product.badge === "Best Seller" ||
        product.badge === "New" ||
        product.badge === "Premium" ||
        index < 2),
    isBestSeller: product.isBestSeller ?? product.badge === "Best Seller",
    isNew: product.isNew ?? product.badge === "New",
    isLimited: product.isLimited ?? product.badge === "Limited",
    isTrending: product.isTrending ?? product.badge === "Trending",
    isPremium: product.isPremium ?? product.badge === "Premium",
    material: product.material ?? "Premium quality",
    fit: product.fit ?? "True to size",
    care: product.care ?? "Wash cold, air dry",
    shippingNote: product.shippingNote ?? "Ships in 2–4 business days",
    gender: product.gender ?? "unisex",
    sortOrder: product.sortOrder ?? index + 1,
    collection: product.collection ?? "core",
    heroImage: product.heroImage || getPrimaryMediaUrl(media),
    featuredImage: product.featuredImage || getPrimaryMediaUrl(media),
    hoverImage: product.hoverImage || finalImages[1] || finalImages[0],
    shopSection: product.shopSection ?? "core",
  }
}

