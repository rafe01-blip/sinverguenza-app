function getBlockedUserIds(user: UserType | null) {
  return new Set(user?.preferences?.blockedUsers ?? [])
}

function isBlockedByUser(
  user: UserType | null,
  creatorId?: string | null
) {
  if (!creatorId) return false
  return getBlockedUserIds(user).has(creatorId)
}

function getRestrictedTags(user: UserType | null) {
  return new Set(user?.preferences?.restrictedEventTypes ?? [])
}

function eventMatchesRestrictPreferences(
  event: EventType,
  user: UserType | null
) {
  const restricted = getRestrictedTags(user)

  // si está vacío o tiene "all", no filtra
  if (restricted.size === 0 || restricted.has("all")) return true

  const eventTokens = new Set<string>([
    event.category || "",
    event.visibility || "",
    event.pricing || "",
    ...(event.activityTypes ?? []),
    ...(event.audienceTags ?? []),
  ])

  return Array.from(restricted).some((tag) =>
    eventTokens.has(tag)
  )
}

function isEventBlockedOrRestricted(
  event: EventType,
  user: UserType | null
) {
  if (isBlockedByUser(user, event.organizerCreatorId)) return true
  return !eventMatchesRestrictPreferences(event, user)
}

