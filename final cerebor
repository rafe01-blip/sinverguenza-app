function getSpaceFreshnessFromDates(
  createdAt?: string,
  expiresAt?: string
): SpaceFreshness {
  if (expiresAt && isExpired(expiresAt)) return "expired"
  if (!createdAt) return "active"

  const created = new Date(createdAt).getTime()
  const ageHours = (Date.now() - created) / (1000 * 60 * 60)

  if (ageHours <= 24) return "new"
  if (ageHours <= 7 * 24) return "active"

  return "quiet"
}

function normalizeSpace(space: SpaceType): SpaceType {
  const visibility =
    space.visibility ?? (space.key === "private" ? "private" : "public")

  const freshness =
    space.freshness ??
    getSpaceFreshnessFromDates(space.createdAt, space.expiresAt)

  return {
    ...space,
    id: space.id || String(space.key),
    name: space.name || space.label,
    visibility,
    requestStatus:
      space.requestStatus ?? (space.isJoined ? "approved" : "none"),
    createdAt: space.createdAt ?? new Date().toISOString(),
    expiresAt: space.expiresAt,
    freshness,
    activityState:
      space.activityState ??
      (freshness === "new"
        ? "new"
        : freshness === "active"
        ? "active"
        : "quiet"),
    unreadCount: space.unreadCount ?? 0,
    lastActivityAt: space.lastActivityAt || space.createdAt,
    socialLinks: {
      ...(space.socialLinks || {}),
      instagram: normalizeUrl(space.socialLinks?.instagram || space.instagram),
      whatsapp: normalizeWhatsApp(space.socialLinks?.whatsapp || space.whatsapp),
      website: normalizeUrl(space.socialLinks?.website || space.externalLink),
    },
  }
}

function normalizeSpacePost(post: SpacePost): SpacePost {
  const media = normalizeMediaList({
    media: post.media,
    fallback: DEFAULT_ASSET,
    alt: post.content,
  }).filter((item) => item.id !== "fallback")

  const voiceNote =
    post.voiceNote && post.voiceNote.type === "audio"
      ? {
          ...post.voiceNote,
          durationSeconds: Math.min(
            post.voiceNote.durationSeconds ?? 60,
            60
