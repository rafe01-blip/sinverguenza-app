"use client"

import { useMemo, useState } from "react"
import { Search, BadgeCheck } from "lucide-react"
import { TopHeader } from "@/components/navigation/top-header"
import { BottomNav } from "@/components/navigation/bottom-nav"
import { useApp } from "@/lib/app-context"

const GOLD = "#C9A84C"
const DARK = "#0A0A0A"
const CARD = "#121212"

type CreatorFilter = "all" | "official" | "instructor" | "host" | "member"

const FILTERS: { key: CreatorFilter; label: string }[] = [
  { key: "all", label: "All" },
  { key: "official", label: "Official" },
  { key: "instructor", label: "Instructor" },
  { key: "host", label: "Host" },
  { key: "member", label: "Member" },
]

function getBadgeColor(label?: string) {
  const key = (label || "").toLowerCase()

  if (key.includes("official")) return "#C9A84C"
  if (key.includes("instructor")) return "#3B82F6"
  if (key.includes("host")) return "#A855F7"
  return "#6B7280"
}

export function CreatorListScreen() {
  const {
    creators,
    setSelectedCreator,
    setCurrentScreen,
    toggleFollow,
  } = useApp()

  const [activeFilter, setActiveFilter] = useState<CreatorFilter>("all")
  const [query, setQuery] = useState("")

  const visibleCreators = useMemo(() => {
    return creators.filter((creator) => {
      const matchesFilter =
        activeFilter === "all"
          ? true
          : (creator.badgeLabel || "").toLowerCase() === activeFilter

      const q = query.trim().toLowerCase()
      const matchesQuery =
        !q ||
        creator.name.toLowerCase().includes(q) ||
        creator.username.toLowerCase().includes(q)

      return matchesFilter && matchesQuery
    })
  }, [activeFilter, creators, query])

  return (
    <div
      style={{
        minHeight: "100vh",
        background: DARK,
        color: "#fff",
        paddingBottom: 96,
      }}
    >
      <TopHeader title="Creators" />

      <div style={{ padding: "16px" }}>
        {/* 🔍 SEARCH */}
        <div style={searchWrap}>
          <Search size={18} color="#9a9a9a" />
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search creators..."
            style={searchInput}
          />
        </div>

        {/* 🔘 FILTERS */}
        <div style={filtersWrap}>
          {FILTERS.map((item) => (
            <button
              key={item.key}
              onClick={() => setActiveFilter(item.key)}
              style={activeFilter === item.key ? chipActive : chip}
            >
              {item.label}
            </button>
          ))}
        </div>

        {/* 📭 EMPTY */}
        {visibleCreators.length === 0 ? (
          <div style={emptyWrap}>
            <div style={emptyTitle}>No creators found</div>
            <div style={emptyText}>
              Try another name or filter.
            </div>
          </div>
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            {visibleCreators.map((creator) => (
              <div
                key={creator.id}
                onClick={() => {
                  setSelectedCreator(creator)
                  setCurrentScreen("creator-profile")
                }}
                style={creatorCard}
              >
                {/* LEFT */}
                <div style={{ display: "flex", gap: 12, flex: 1 }}>
                  <div style={avatarWrap}>
                    <img
                      src={creator.avatar || "/placeholder.svg"}
                      alt={creator.name}
                      style={avatarImg}
                    />
                  </div>

                  <div style={{ flex: 1 }}>
                    <div style={nameRow}>
                      <span>{creator.name}</span>
                      {creator.isVerified && (
                        <BadgeCheck size={14} color={GOLD} />
                      )}
                    </div>

                    <div style={username}>
                      @{creator.username}
                    </div>

                    <div
                      style={{
                        ...badge,
                        background: getBadgeColor(creator.badgeLabel),
                      }}
                    >
                      {creator.badgeLabel}
                    </div>
                  </div>
                </div>

                {/* FOLLOW BUTTON */}
                <button
                  onClick={(e) => {
                    e.stopPropagation()
                    toggleFollow(creator.id)
                  }}
                  style={creator.isFollowing ? followingBtn : followBtn}
                >
                  {creator.isFollowing ? "Following" : "Follow"}
                </button>
              </div>
            ))}
          </div>
        )}
      </div>

      <BottomNav />
    </div>
  )
}

