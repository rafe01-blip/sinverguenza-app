            type: story.type === "video" ? "video" : "image",
            image: story.image || story.thumbnailUrl || DEFAULT_ASSET,
            videoUrl: story.videoUrl,
            thumbnailUrl: story.thumbnailUrl || story.image || DEFAULT_ASSET,
            durationSeconds: Math.min(story.durationSeconds ?? 8, 60),
            content: story.content,
            createdAt: story.createdAt,
          },
        ]

  const media = normalizeMediaList({
    media: story.media,
    image: story.image,
    images: slides
      .filter((slide) => slide.type === "image")
      .map((slide) => slide.image || DEFAULT_ASSET),
    videoUrl:
      story.videoUrl ||
      slides.find((slide) => slide.type === "video")?.videoUrl,
    thumbnailUrl:
      story.thumbnailUrl ||
      slides[0]?.thumbnailUrl ||
      slides[0]?.image,
    durationSeconds: story.durationSeconds,
    alt: story.content,
    fallback: DEFAULT_ASSET,
