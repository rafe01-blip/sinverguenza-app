  const updateMyProfile = (updates: Partial<UserType>) => {
    setUserState((prev) => {
      if (!prev) return prev

      const nextUser: UserType = {
        ...prev,
        ...updates,
        socials: {
          ...(prev.socials || {}),
          ...(updates.socials || {}),
        },
        preferences: {
          ...(prev.preferences || {}),
          ...(updates.preferences || {}),
        },
      }

      setCreatorsState((current) =>
        ensureOfficialSVCreator(upsertMeCreator(current, nextUser))
      )

      return nextUser
    })

    showToast("Profile updated", "success")
  }

  const updateMySocials = (updates: Partial<SocialLinks>) => {
    updateMyProfile({
      socials: {
        ...(user?.socials || {}),
        ...updates,
        instagram: normalizeUrl(updates.instagram || user?.socials?.instagram),
        tiktok: normalizeUrl(updates.tiktok || user?.socials?.tiktok),
        facebook: normalizeUrl(updates.facebook || user?.socials?.facebook),
        website: normalizeUrl(updates.website || user?.socials?.website),
        whatsapp: normalizeWhatsApp(
          updates.whatsapp || user?.socials?.whatsapp
        ),
      },
    })

    showToast("Social links saved", "success")
  }

  const setProducts = (nextProducts: ProductType[]) => {
    setProductsState(
      nextProducts.map((product, index) =>
        normalizeProduct(product, index)
      )
    )
  }

  const setCreators = (nextCreators: Creator[]) => {
    setCreatorsState(
      ensureOfficialSVCreator(
        upsertMeCreator(
          nextCreators.map(normalizeCreator),
          user || INITIAL_USER
        )
      )
    )
  }

  const setSelectedCreator = (creator: Creator | null) => {
    setSelectedCreatorState(creator ? normalizeCreator(creator) : null)
  }

  const setSelectedProduct = (product: ProductType | null) => {
    setSelectedProductState(
      product ? normalizeProduct(product, product.sortOrder ?? 0) : null
    )
  }

  const setSelectedEvent = (event: EventType | null) => {
    setSelectedEventState(event ? normalizeEvent(event) : null)
  }

  const setSelectedOrder = (order: OrderType | null) => {
    setSelectedOrderState(order ? normalizeOrder(order) : null)
  }

  /* =========================
     NAVIGATION
  ========================= */

  const setCurrentScreen = (screen: Screen) => {
    setCurrentScreenState(screen)
  }

  const navigateTo = (target: NavigationTarget) => {
    if (!target.replace) {
      setNavigationStack((prev) => [
        ...prev,
        {
          screen: currentScreen,
          selectedEventId: selectedEvent?.id ?? null,
          selectedCreatorId: selectedCreator?.id ?? null,
          selectedProductId: selectedProduct?.id ?? null,
          selectedStoryId: selectedStoryId ?? null,
          activeSpaceKey: activeSpace ?? null,
          selectedOrderId: selectedOrder?.id ?? null,
          source: currentScreen,
        },
      ])
    }

    if (target.eventId) {
      const event = events.find((item) => item.id === target.eventId)
      if (event) setSelectedEvent(event)
    }

    if (target.creatorId) {
      const creator = creators.find((item) => item.id === target.creatorId)
      if (creator) setSelectedCreator(creator)
    }

    if (target.productId) {
      const product = products.find((item) => item.id === target.productId)
      if (product) setSelectedProduct(product)
    }

    if (target.storyId) setSelectedStoryId(target.storyId)
    if (target.spaceKey) setActiveSpace(target.spaceKey as SpaceKey)

    if (target.orderId) {
      const order = orders.find((item) => item.id === target.orderId)
      if (order) setSelectedOrder(order)
    }

    setCurrentScreenState(target.screen)
  }
  const goBack = () => {
    setNavigationStack((prev) => {
      if (prev.length === 0) {
        setCurrentScreenState("home")
        return prev
      }

      const last = prev[prev.length - 1]

      if (last.selectedEventId) {
        const event = events.find((item) => item.id === last.selectedEventId)
        setSelectedEvent(event || null)
      } else {
        setSelectedEvent(null)
      }

      if (last.selectedCreatorId) {
        const creator = creators.find(
          (item) => item.id === last.selectedCreatorId
        )
        setSelectedCreator(creator || null)
      } else {
        setSelectedCreator(null)
      }

      if (last.selectedProductId) {
        const product = products.find(
          (item) => item.id === last.selectedProductId
        )
        setSelectedProduct(product || null)
      } else {
        setSelectedProduct(null)
      }

      setSelectedStoryId(last.selectedStoryId ?? null)
      setActiveSpace((last.activeSpaceKey as SpaceKey) ?? null)

      if (last.selectedOrderId) {
        const order = orders.find((item) => item.id === last.selectedOrderId)
        setSelectedOrder(order || null)
      } else {
        setSelectedOrder(null)
      }

      setCurrentScreenState(last.screen)

      return prev.slice(0, -1)
    })
  }

  const resetNavigation = (screen: Screen = "home") => {
    setNavigationStack([])
    setCurrentScreenState(screen)
  }

  const navigateMainTab = (screen: Screen) => {
    setNavigationStack([])
    setCurrentScreenState(screen)
  }

  /* =========================
     BLOCK / RESTRICT
  ========================= */

  const isUserBlocked = (userId: string) => {
    return isBlockedByUser(user, userId)
  }

  const blockUser = (userId: string) => {
    if (!userId || userId === user?.id) return

    updateMyProfile({
      preferences: {
        ...(user?.preferences || {}),
        blockedUsers: Array.from(
          new Set([...(user?.preferences?.blockedUsers ?? []), userId])
        ),
        restrictedEventTypes:
          user?.preferences?.restrictedEventTypes ?? ["all"],
        hiddenTags: user?.preferences?.hiddenTags ?? [],
      },
    })

    setCreatorsState((prev) =>
      prev.map((creator) =>
        creator.id === userId
          ? normalizeCreator({
              ...creator,
              isFollowing: false,
              priorityUntilInteracted: false,
              followersCount: Math.max(
                0,
                (creator.followersCount ?? creator.followers ?? 0) - 1
              ),
            })
          : normalizeCreator(creator)
      )
    )

    if (selectedCreator?.id === userId) {
      setSelectedCreatorState(null)
      goBack()
    }

    showToast("User blocked", "info")
  }

  const unblockUser = (userId: string) => {
    updateMyProfile({
      preferences: {
        ...(user?.preferences || {}),
        blockedUsers: (user?.preferences?.blockedUsers ?? []).filter(
          (id) => id !== userId
        ),
        restrictedEventTypes:
          user?.preferences?.restrictedEventTypes ?? ["all"],
        hiddenTags: user?.preferences?.hiddenTags ?? [],
      },
    })
  }

  const restrictTag = (tag: string) => {
    const cleanTag = tag.trim().toLowerCase()
    if (!cleanTag) return

    const current = user?.preferences?.restrictedEventTypes ?? ["all"]
    const next =
      cleanTag === "all"
        ? ["all"]
        : Array.from(
            new Set([...current.filter((item) => item !== "all"), cleanTag])
          )

    updateMyProfile({
      preferences: {
        ...(user?.preferences || {}),
        blockedUsers: user?.preferences?.blockedUsers ?? [],
        restrictedEventTypes: next,
        hiddenTags: user?.preferences?.hiddenTags ?? [],
        eventPreferences: {
          mode: cleanTag === "all" ? "all" : "custom",
          selectedTags: cleanTag === "all" ? [] : next,
        },
      },
    })
  }

  const unrestrictTag = (tag: string) => {
    const cleanTag = tag.trim().toLowerCase()

    const next = (user?.preferences?.restrictedEventTypes ?? ["all"]).filter(
      (item) => item !== cleanTag
    )

    updateMyProfile({
      preferences: {
        ...(user?.preferences || {}),
        blockedUsers: user?.preferences?.blockedUsers ?? [],
        restrictedEventTypes: next.length > 0 ? next : ["all"],
        hiddenTags: user?.preferences?.hiddenTags ?? [],
        eventPreferences: {
          mode: next.length > 0 ? "custom" : "all",
          selectedTags: next,
        },
      },
    })
  }

  const isTagRestricted = (tag: string) => {
    const restricted = user?.preferences?.restrictedEventTypes ?? ["all"]
    return restricted.includes(tag.toLowerCase())
  }

  const eventMatchesUserPreferences = (event: EventType) => {
    return eventMatchesRestrictPreferences(event, user)
  }

  const isEventBlockedOrRestrictedLocal = (event: EventType) => {
    return isEventBlockedOrRestricted(event, user)
  }

  /* =========================
     EVENT LIFECYCLE
  ========================= */

  const isPastEvent = (event: EventType) => {
    const { end } = getEventDateTime(event)
    return Date.now() > end.getTime()
  }

  const isEventLive = (event: EventType) => {
    return getEventLifecycleStatus(event) === "live"
  }

  const isEventRecentlyEnded = (event: EventType) => {
    return getEventLifecycleStatus(event) === "just-ended"
  }

  const getEventLifecycleStatus = (
    event: EventType
  ): EventLifecycleStatus => {
    return getEventLifecycleStatusStatic(event)
  }

  const shouldKeepEventInProfile = (event: EventType) => {
    return shouldKeepEventInProfileStatic(event)
  }

  const shouldShowEventInHome = (event: EventType) => {
    const normalized = normalizeEvent(event)
    const status = getEventLifecycleStatus(normalized)

    if (normalized.hiddenFromHome) return false
    if (isEventBlockedOrRestrictedLocal(normalized)) return false

    return (
      status === "upcoming" ||
      status === "live" ||
      status === "just-ended"
    )
  }

  const shouldShowEventInCalendar = (event: EventType) => {
    const normalized = normalizeEvent(event)
    if (isEventBlockedOrRestrictedLocal(normalized)) return false
    return normalized.lifecycleStatus !== "expired"
  }

  const getEventById = (eventId: string) => {
    return events.find((event) => event.id === eventId) || null
  }

  const getVisibleEvents = () => {
    return events
      .map(normalizeEvent)
      .filter((event) => !isEventBlockedOrRestrictedLocal(event))
  }

  const getHomeEvents = () => {
    return getVisibleEvents()
      .filter(shouldShowEventInHome)
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
  }

  const getCalendarEvents = () => {
    return getVisibleEvents()
      .filter(shouldShowEventInCalendar)
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
  }

  const getProfileEvents = (userId: string = user?.id || "me-user") => {
    return getVisibleEvents()
      .filter(
        (event) =>
          event.organizerCreatorId === userId ||
          event.postedById === userId ||
          shouldKeepEventInProfile(event)
      )
      .sort((a, b) => getEventSortTimestamp(b) - getEventSortTimestamp(a))
  }

  const getPinnedEvents = () => {
    return getVisibleEvents()
      .filter((event) => event.isPinned)
      .filter((event) => getEventLifecycleStatus(event) !== "archived")
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
      .slice(0, 3)
  }

  const getSavedEvents = () => {
    return getVisibleEvents()
      .filter((event) => event.isSaved)
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
  }

  const getGoingEvents = () => {
    return getVisibleEvents()
      .filter((event) => event.attendanceStatus === "going")
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
  }

  const getEventCardData = (eventId: string) => {
    const event = getEventById(eventId)
    return event ? normalizeEvent(event) : null
  }

  const openEventDetail = (
    eventId: string,
    source: "home" | "calendar" | "notifications" = "home"
  ) => {
    const event = getEventById(eventId)
    if (!event) return

    setSelectedEvent(event)
    setLastEventSource(source)

    navigateTo({
      screen: "event-detail",
      eventId,
    })
  }

  const openPinnedCalendarFocus = () => {
    const pinnedEvents = getPinnedEvents()
    const firstPinned = pinnedEvents[0]

    setCalendarViewMode("focus")
    setCalendarEntrySource("home-pinned")
    setCurrentScreenState("calendar")

    if (firstPinned) {
      setSelectedDate(firstPinned.date)
      setCalendarHighlightedEventId(firstPinned.id)
    }
  }

  const openCalendarExpandFromHome = (date?: string) => {
    setCalendarViewMode("expand")
    setCalendarEntrySource("home-date")
    setCalendarHighlightedEventId(null)
    setSelectedDate(date || todayDateString())
    setCurrentScreenState("calendar")
  }

  const openEventInCalendar = (
    eventId: string,
    mode: CalendarEntryMode = "focus"
  ) => {
    const targetEvent = getEventById(eventId)
    if (!targetEvent) return

    setCalendarViewMode(mode)
    setCalendarEntrySource("event-detail")
    setSelectedDate(targetEvent.date)
    setCalendarHighlightedEventId(targetEvent.id)
    setCurrentScreenState("calendar")
  }

  /* =========================
     EVENT ACTIONS
  ========================= */

  const createEvent = (event: EventType) => {
    const normalizedEvent = normalizeEvent({
      ...event,
      postedById: event.postedById || user?.id || "me-user",
      postedByName: event.postedByName || user?.name || "Mario",
      postedByUsername:
        event.postedByUsername || user?.username || "mariorafaelrosario",
      reminderConfig: event.reminderConfig ?? {
        enabled: false,
        oneDayBefore: false,
        fiveHoursBefore: false,
        oneHourBefore: false,
      },
    })

    setEvents((prev) =>
      uniqueById([normalizedEvent, ...prev.map(normalizeEvent)])
    )

    setSelectedEventState(normalizedEvent)

    setUserState((prev) =>
      prev
        ? {
            ...prev,
            createdEventCount: (prev.createdEventCount ?? 0) + 1,
          }
        : prev
    )

    const threadPost = buildEventThreadPost(
      normalizedEvent,
      normalizedEvent.organizerCreatorId || user?.id || "me-user"
    )

    setCommunityPosts((prev) =>
      uniqueById([threadPost, ...prev.map(normalizeCommunityPost)])
    )

    createEventNotification(
      normalizedEvent,
      "Event Created",
      `${normalizedEvent.title} is ready to view.`
    )

    setSelectedEventState(normalizedEvent)
    showToast("Event created", "success")

    navigateTo({
      screen: "event-detail",
      eventId: normalizedEvent.id,
    })
  }

  const updateEvent = (eventId: string, updates: Partial<EventType>) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({ ...event, ...updates })
          : normalizeEvent(event)
      )
    )

    setSelectedEventState((prev) =>
      prev && prev.id === eventId
        ? normalizeEvent({ ...prev, ...updates })
        : prev
    )
  }

  const toggleLike = (eventId: string) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              isLiked: !event.isLiked,
              likes: Math.max(
                0,
                (event.likes ?? 0) + (event.isLiked ? -1 : 1)
              ),
            })
          : normalizeEvent(event)
      )
    )
  }

  const toggleSave = (eventId: string) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              isSaved: !event.isSaved,
            })
          : normalizeEvent(event)
      )
    )
  }

  const togglePinEvent = (eventId: string) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              isPinned: !event.isPinned,
            })
          : normalizeEvent(event)
      )
    )
  }
  const setAttendanceStatus = (
    eventId: string,
    status: EventAttendanceStatus
  ) => {
    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              attendanceStatus:
                event.attendanceStatus === status ? null : status,
            })
          : normalizeEvent(event)
      )
    )
  }

  const rateEvent = (eventId: string, rating: number, comment?: string) => {
    const cleanRating = Math.min(5, Math.max(1, rating))

    setEvents((prev) =>
      prev.map((event) => {
        if (event.id !== eventId) return normalizeEvent(event)

        const lifecycle = getEventLifecycleStatus(event)
        if (lifecycle === "upcoming" || lifecycle === "live") {
          showToast("Ratings open after the event ends", "info")
          return normalizeEvent(event)
        }

        const existingRatings = event.ratings ?? []
        const withoutMine = existingRatings.filter(
          (item) => item.userId !== (user?.id || "me-user")
        )

        const myRating: EventRating = {
          id: `rating-${eventId}-${user?.id || "me-user"}`,
          userId: user?.id || "me-user",
          userName: user?.name || "Mario",
          rating: cleanRating,
          comment: comment?.trim() || undefined,
          createdAt: new Date().toISOString(),
        }

        const ratings = [...withoutMine, myRating]
        const average =
          ratings.reduce((sum, item) => sum + item.rating, 0) / ratings.length

        return normalizeEvent({
          ...event,
          ratings,
          ratingAverage: Number(average.toFixed(1)),
          ratingCount: ratings.length,
          myRating: cleanRating,
        })
      })
    )
  }

  const addComment = (eventId: string, text: string) => {
    const trimmed = text.trim()
    if (!trimmed) return

    const newComment: EventComment = {
      id: `event-comment-${Date.now()}`,
      userId: user?.id || "me-user",
      userName: user?.name || "Mario",
      userAvatar: user?.avatar || DEFAULT_ASSET,
      text: trimmed,
      createdAt: new Date().toISOString(),
      replies: [],
    }

    setEvents((prev) =>
      prev.map((event) =>
        event.id === eventId
          ? normalizeEvent({
              ...event,
              comments: [...normalizeComments(event.comments), newComment],
              commentsCount: (event.commentsCount ?? 0) + 1,
            })
          : normalizeEvent(event)
      )
    )
  }

  const addReplyToComment = (
    eventId: string,
    commentId: string,
    text: string
  ) => {
    const trimmed = text.trim()
    if (!trimmed) return

    const newReply: EventCommentReply = {
      id: `event-reply-${Date.now()}`,
      userId: user?.id || "me-user",
      userName: user?.name || "Mario",
      userAvatar: user?.avatar || DEFAULT_ASSET,
      text: trimmed,
      createdAt: new Date().toISOString(),
    }

    setEvents((prev) =>
      prev.map((event) => {
        if (event.id !== eventId) return normalizeEvent(event)

        return normalizeEvent({
          ...event,
          comments: normalizeComments(event.comments).map((comment) =>
            comment.id === commentId
              ? {
                  ...comment,
                  replies: [...(comment.replies ?? []), newReply],
                }
              : comment
          ),
        })
      })
    )
  }

  /* =========================
     CREATORS / PEOPLE
  ========================= */

  const getCreatorById = (creatorId: string) => {
    return creators.find((creator) => creator.id === creatorId) || null
  }

  const getVisibleCreators = () => {
    return creators
      .map(normalizeCreator)
      .filter((creator) => !isBlockedByUser(user, creator.id))
  }

  const getFollowingCreators = () => {
    return getVisibleCreators().filter((creator) => creator.isFollowing)
  }

  const getPrioritizedCreators = () => {
    return getVisibleCreators().sort((a, b) => {
      const aFollow = a.isFollowing ? 1 : 0
      const bFollow = b.isFollowing ? 1 : 0

      if (aFollow !== bFollow) return bFollow - aFollow

      const aOfficial = a.isOfficialAccount ? 1 : 0
      const bOfficial = b.isOfficialAccount ? 1 : 0

      if (aOfficial !== bOfficial) return bOfficial - aOfficial

      return (b.followersCount ?? 0) - (a.followersCount ?? 0)
    })
  }

  const getTopCreators = () => {
    return getPrioritizedCreators().slice(0, 10)
  }

  const getCreatorFollowers = (creatorId: string) => {
    return getVisibleCreators()
      .filter((creator) => creator.id !== creatorId)
      .slice(0, 25)
  }

  const getCreatorFollowing = (creatorId: string) => {
    if (creatorId === user?.id) {
      return getFollowingCreators().slice(0, 25)
    }

    return getVisibleCreators()
      .filter((creator) => creator.id !== creatorId)
      .filter((creator) => creator.isFollowing || creator.role === "official")
      .slice(0, 25)
  }

  const getCreatorEvents = (creatorId: string) => {
    if (isBlockedByUser(user, creatorId)) return []

    return getVisibleEvents()
      .filter((event) => event.organizerCreatorId === creatorId)
      .sort((a, b) => getEventSortTimestamp(a) - getEventSortTimestamp(b))
  }

  const getSpaceMembers = (spaceKey: SpaceKey) => {
    const base = getVisibleCreators()

    if (spaceKey === "dance") return base.slice(0, 5)
    if (spaceKey === "events") return base.filter((creator) => creator.isFollowing)

    return base.slice(0, 8)
  }

  const getEventHosts = (eventId?: string) => {
    if (!eventId) {
      return getVisibleCreators().filter(
        (creator) =>
          creator.role === "official" ||
          creator.role === "instructor" ||
          creator.role === "host"
      )
    }

    const event = getEventById(eventId)
    if (!event?.organizerCreatorId) return []

    const host = getCreatorById(event.organizerCreatorId)
    return host ? [host] : []
  }

  const searchCreators = (query: string) => {
    const q = query.trim().toLowerCase()
    if (!q) return getVisibleCreators()

    return getVisibleCreators().filter((creator) =>
      [
        creator.name,
        creator.displayName,
        creator.username,
        creator.role,
        creator.badgeLabel,
        creator.bio,
        creator.city,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase()
        .includes(q)
    )
  }

  const openCreatorProfile = (creatorId: string) => {
    if (isBlockedByUser(user, creatorId)) return

    const creator = getCreatorById(creatorId)
    if (!creator) return

    setSelectedCreatorState(normalizeCreator(creator))

    navigateTo({
      screen: "creator-profile",
      creatorId,
    })
  }

  const toggleFollow = (id: string) => {
    if (!id || id === user?.id || isBlockedByUser(user, id)) return

    setCreatorsState((prev) =>
      prev.map((creator) => {
        if (creator.id !== id) return normalizeCreator(creator)

        const nextFollowing = !creator.isFollowing
        const followersCount = creator.followersCount ?? creator.followers ?? 0

        return normalizeCreator({
          ...creator,
          isFollowing: nextFollowing,
          priorityUntilInteracted: false,
          followersCount: nextFollowing
            ? followersCount + 1
            : Math.max(0, followersCount - 1),
          followers: nextFollowing
            ? followersCount + 1
            : Math.max(0, followersCount - 1),
        })
      })
    )
  }

  const openCreatorList = (
    typeOrContext: CreatorListType | CreatorListContext,
    creatorId?: string | null,
    title?: string
  ) => {
    const context =
      typeof typeOrContext === "string"
        ? {
            type: typeOrContext,
            sourceCreatorId: creatorId || null,
            title,
          }
        : typeOrContext

    setCreatorListType(context.type)
    setCreatorListSourceCreatorId(context.sourceCreatorId || null)
    setCreatorListSourceSpaceKey(context.sourceSpaceKey || null)
    setCreatorListSourceEventId(context.sourceEventId || null)

    if (context.title) {
      setCreatorListTitle(context.title)
    } else if (context.type === "followers") {
      setCreatorListTitle("Followers")
    } else if (context.type === "following") {
      setCreatorListTitle("Following")
    } else if (context.type === "blocked-users") {
      setCreatorListTitle("Blocked Users")
    } else if (context.type === "space-members") {
      setCreatorListTitle("Space Members")
    } else if (context.type === "event-hosts") {
      setCreatorListTitle("Event Hosts")
    } else {
      setCreatorListTitle("Discover People")
    }

    navigateTo({
      screen: "creator-list",
    })
  }

  /* =========================
     PROFILE HELPERS
  ========================= */

  const getUserCreatedEvents = (userId: string) => {
    return getVisibleEvents().filter((event) => event.postedById === userId)
  }

  const getUserHostedEvents = (userId: string) => {
    return getVisibleEvents().filter(
      (event) => event.organizerCreatorId === userId || event.hostId === userId
    )
  }

  const getUserSavedEvents = () => {
    return getVisibleEvents().filter((event) => event.isSaved)
  }

  const getUserLikedEvents = () => {
    return getVisibleEvents().filter((event) => event.isLiked)
  }

  const getUserGoingEvents = () => {
    return getVisibleEvents().filter((event) => event.attendanceStatus === "going")
