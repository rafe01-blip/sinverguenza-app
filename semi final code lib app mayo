/* =========================
   HELPERS 🔥 (CRÍTICO)
========================= */

function uniqueImages(images: (string | undefined | null)[]) {
  return images
    .filter((img): img is string => !!img && img.trim().length > 0)
    .filter((img, index, arr) => arr.indexOf(img) === index)
}

function uniqueMedia(media: (MediaItem | undefined | null)[]) {
  return media
    .filter((item): item is MediaItem => !!item && !!item.url)
    .filter((item, index, arr) => arr.findIndex((m) => m.url === item.url) === index)
}

function imageToMedia(
  url: string | undefined | null,
  alt?: string,
  id = `media-${Date.now()}`
): MediaItem | null {
  if (!url) return null

  return {
    id,
    type: "image",
    url,
    thumbnailUrl: url,
    alt,
  }
}

function videoToMedia(args: {
  id: string
  url?: string
  thumbnailUrl?: string
  alt?: string
  durationSeconds?: number
}): MediaItem | null {
  if (!args.url) return null

  return {
    id: args.id,
    type: "video",
    url: args.url,
    thumbnailUrl: args.thumbnailUrl || DEFAULT_ASSET,
    alt: args.alt,
    durationSeconds: Math.min(args.durationSeconds ?? 60, 60),
  }
}

function normalizeMediaList(args: {
  media?: MediaItem[]
  image?: string
  images?: string[]
  videoUrl?: string
  thumbnailUrl?: string
  durationSeconds?: number
  alt?: string
  fallback?: string
}): MediaItem[] {
  const imageMedia = uniqueImages([
    args.image,
    ...(args.images ?? []),
    args.fallback,
  ]).map((img, i) =>
    imageToMedia(img, args.alt, `img-${i + 1}`)
  )

  const videoMedia = videoToMedia({
    id: "video-1",
    url: args.videoUrl,
    thumbnailUrl: args.thumbnailUrl,
    alt: args.alt,
    durationSeconds: args.durationSeconds,
  })

  const existing: MediaItem[] = (args.media ?? []).map((item, i) => ({
    ...item,
    id: item.id || `media-${i + 1}`,
    thumbnailUrl:
      item.thumbnailUrl ||
      (item.type === "image" ? item.url : args.thumbnailUrl || DEFAULT_ASSET),
  }))

  const merged = uniqueMedia([...existing, videoMedia, ...imageMedia])

  return merged.length > 0
    ? merged
    : [
        {
          id: "fallback",
          type: "image",
          url: args.fallback || DEFAULT_ASSET,
          thumbnailUrl: args.fallback || DEFAULT_ASSET,
        },
      ]
}

function getPrimaryMediaUrl(media?: MediaItem[], fallback = DEFAULT_ASSET) {
  const first = media?.[0]
  if (!first) return fallback

  return first.type === "video"
    ? first.thumbnailUrl || fallback
    : first.url
}

/* =========================
   DATE HELPERS
========================= */

function makeDateAgo(hoursAgo: number) {
  return new Date(Date.now() - hoursAgo * 60 * 60 * 1000).toISOString()
}

function makeDateIn(hoursFromNow: number) {
  return new Date(Date.now() + hoursFromNow * 60 * 60 * 1000).toISOString()
}

function todayDateString() {
  return new Date().toISOString().split("T")[0]
}

function dateInDays(days: number) {
  return new Date(Date.now() + days * 24 * 60 * 60 * 1000)
    .toISOString()
    .split("T")[0]
}

function sevenDaysFromNow() {
  return new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
}

function isExpired(value?: string) {
  if (!value) return false
  return new Date(value).getTime() <= Date.now()
}
/* =========================
   GENERAL HELPERS
========================= */

function normalizeWhatsApp(value?: string) {
  const raw = (value || "").trim()
  if (!raw) return ""

  if (raw.startsWith("http")) return raw

  const digits = raw.replace(/[^\d+]/g, "")
  if (!digits) return raw

  return `https://wa.me/${digits.replace("+", "")}`
}

function normalizeComments(comments?: EventComment[]) {
  return (comments ?? []).map((comment) => ({
    ...comment,
    replies: comment.replies ?? [],
  }))
}

function getEventSortTimestamp(event: EventType) {
  return new Date(`${event.date}T${event.time || "00:00"}`).getTime()
}

function isFutureOrTodayEvent(event: EventType) {
  return getEventSortTimestamp(event) >= Date.now() - 60 * 1000
}

function getStorySortTimestamp(story: CommunityStory) {
  return new Date(story.createdAt).getTime()
}

function isStoryExpired(story: CommunityStory) {
  return new Date(story.expiresAt).getTime() <= Date.now()
}

function isFreshWithin7Days(dateString: string) {
  const created = new Date(dateString).getTime()
  const sevenDays = 7 * 24 * 60 * 60 * 1000
  return Date.now() - created <= sevenDays
}

/* =========================
   SPACE LIMIT HELPERS
========================= */

function getMaxSpacesAllowed(eventCount: number): number {
  if (eventCount >= 6) return 5
  if (eventCount >= 3) return 3
  return 1
}

function buildSpaceLimitInfo(user: UserType | null): SpaceLimitInfo {
  const createdEvents = user?.createdEventCount ?? 0
  const createdSpaces = user?.createdSpaceCount ?? 0
  const maxSpacesAllowed = getMaxSpacesAllowed(createdEvents)
  const remainingSpaces = Math.max(0, maxSpacesAllowed - createdSpaces)

  let nextUnlockMessage = "Create 3 events to unlock up to 3 spaces"

  if (createdEvents >= 6) {
    nextUnlockMessage = "Maximum creator space limit unlocked"
  } else if (createdEvents >= 3) {
    nextUnlockMessage = "Create 6 events to unlock up to 5 spaces"
  }

  return {
    createdEvents,
    createdSpaces,
    maxSpacesAllowed,
    remainingSpaces,
    canCreateMore: remainingSpaces > 0,
    nextUnlockMessage,
  }
}

