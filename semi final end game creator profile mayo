const GOLD = "#C9A84C"
const DARK = "#0A0A0A"
const CARD = "#121212"

function getBadgeColor(label?: string) {
  const key = (label || "").toLowerCase()

  if (key.includes("official")) return "#C9A84C"
  if (key.includes("instructor")) return "#3B82F6"
  if (key.includes("host")) return "#A855F7"
  return "#6B7280"
}

function compact(n: number) {
  if (n >= 1000000) return `${(n / 1000000).toFixed(1)}M`
  if (n >= 1000) return `${(n / 1000).toFixed(1)}K`
  return `${n}`
}

export function CreatorProfileScreen() {
  const {
    selectedCreator,
    toggleFollow,
    creators,
    communityPosts,
    getCreatorEvents,
    setSelectedEvent,
    setCurrentScreen,
  } = useApp()

  const [activeTab, setActiveTab] = useState<"posts" | "events" | "about">("posts")

  const creatorPosts = useMemo(() => {
    if (!selectedCreator) return []
    return communityPosts.filter((post) => post.authorId === selectedCreator.id)
  }, [communityPosts, selectedCreator])

  const creatorEvents = useMemo(() => {
    if (!selectedCreator) return []
    return getCreatorEvents(selectedCreator.id)
  }, [getCreatorEvents, selectedCreator])

  const relatedCreators = useMemo(() => {
    if (!selectedCreator) return []
    return creators
      .filter((creator) => creator.id !== selectedCreator.id)
      .slice(0, 3)
  }, [creators, selectedCreator])

  if (!selectedCreator) return null

  return (
    <div
      style={{
        minHeight: "100vh",
        background: DARK,
        color: "#fff",
        paddingBottom: 96,
      }}
    >
      <TopHeader title="Creator" showBack onBack={() => setCurrentScreen("community")} />

      <div style={{ position: "relative" }}>
        <div style={coverWrap}>
          <img
            src={selectedCreator.coverImage || "/placeholder.svg"}
            alt={selectedCreator.name}
            style={coverImg}
          />
          <div style={coverOverlay} />
        </div>

        <div style={avatarWrap}>
          <img
            src={selectedCreator.avatar || "/placeholder.svg"}
            alt={selectedCreator.name}
            style={avatarImg}
          />
        </div>
      </div>

      <div style={{ padding: "70px 16px 20px" }}>
        <div style={{ textAlign: "center", marginBottom: 18 }}>
          <div style={nameRow}>
            <div style={{ fontSize: 26, fontWeight: 900, lineHeight: 1.1 }}>
              {selectedCreator.name}
            </div>

            {selectedCreator.isVerified && (
              <BadgeCheck size={20} color={GOLD} />
            )}
          </div>

          <div style={{ color: "#aaa", marginBottom: 8 }}>
            @{selectedCreator.username}
          </div>

          <div
            style={{
              display: "inline-flex",
              alignItems: "center",
              justifyContent: "center",
              padding: "7px 12px",
              borderRadius: 999,
              background: getBadgeColor(selectedCreator.badgeLabel),
              color: "#fff",
              fontWeight: 800,
              fontSize: 12,
              marginBottom: 12,
            }}
          >
            {selectedCreator.badgeLabel || "Member"}
          </div>

          {!!selectedCreator.bio && (
            <div
              style={{
                color: "#ddd",
                fontSize: 14,
                lineHeight: 1.6,
                maxWidth: 430,
                margin: "0 auto 12px",
              }}
            >
              {selectedCreator.bio}
            </div>
          )}

          <div style={metaWrap}>
            {!!selectedCreator.city && (
              <div style={metaPill}>
                <MapPin size={14} />
                <span>{selectedCreator.city}</span>
              </div>
            )}

            <div style={metaPill}>
              <Heart size={14} />
              <span>{compact(selectedCreator.totalLikes || 0)} likes</span>
            </div>

            <div style={metaPill}>
              <Calendar size={14} />
              <span>{selectedCreator.eventsCount || selectedCreator.events || 0} events</span>
            </div>
          </div>
        </div>

        <div style={actionsRow}>
          <button
            onClick={() => toggleFollow(selectedCreator.id)}
            style={selectedCreator.isFollowing ? followingBtn : followBtn}
          >
            {selectedCreator.isFollowing ? "Following" : "Follow"}
          </button>

          {!!selectedCreator.socials?.instagram && (
            <button
              onClick={() => window.open(selectedCreator.socials?.instagram, "_blank")}
              style={secondaryBtn}
            >
              <Instagram size={17} />
              <span>Instagram</span>
            </button>
          )}

          <button style={secondaryIconBtn}>
            <Share2 size={17} />
          </button>
        </div>

        <div style={statsRow}>
          <button style={statCard}>
            <div style={statNumber}>
              {compact(selectedCreator.followersCount || selectedCreator.followers || 0)}
            </div>
            <div style={statLabel}>Followers</div>
          </button>

          <button style={statCard}>
            <div style={statNumber}>
              {compact(selectedCreator.followingCount || selectedCreator.following || 0)}
            </div>
            <div style={statLabel}>Following</div>
          </button>

          <button style={statCard}>
            <div style={statNumber}>
              {compact(selectedCreator.postsCount || selectedCreator.posts || creatorPosts.length)}
            </div>
            <div style={statLabel}>Posts</div>
          </button>

          <button style={statCard}>
            <div style={statNumber}>
              {compact(selectedCreator.eventsCount || selectedCreator.events || creatorEvents.length)}
            </div>
            <div style={statLabel}>Events</div>
          </button>
        </div>

        <div style={sectionCard}>
          <div style={sectionTitle}>Bridge</div>

          <div style={bridgeGrid}>
            <div style={bridgeItem}>
              <div style={bridgeItemNumber}>{creatorPosts.length}</div>
              <div style={bridgeItemLabel}>Community posts</div>
            </div>

            <div style={bridgeItem}>
              <div style={bridgeItemNumber}>{creatorEvents.length}</div>
              <div style={bridgeItemLabel}>Real events</div>
            </div>

            <div style={bridgeItem}>
              <div style={bridgeItemNumber}>
                {selectedCreator.socials ? Object.values(selectedCreator.socials).filter(Boolean).length : 0}
              </div>
              <div style={bridgeItemLabel}>Connected socials</div>
            </div>
          </div>
        </div>

        <div style={tabsRow}>
          {[
            { key: "posts", label: "posts" },
            { key: "events", label: "events" },
            { key: "about", label: "about" },
          ].map((tab) => (
            <button
              key={tab.key}
              onClick={() => setActiveTab(tab.key as "posts" | "events" | "about")}
              style={activeTab === tab.key ? tabActive : tabBtn}
            >
              {tab.label}
            </button>
          ))}
        </div>

        {activeTab === "posts" && (
          <div style={{ paddingTop: 14 }}>
            {creatorPosts.length === 0 ? (
              <div style={emptyWrap}>
                <div style={emptyTitle}>No posts yet</div>
                <div style={emptyText}>
                  This creator has not posted anything in the community yet.
                </div>
              </div>
            ) : (
              <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
                {creatorPosts.map((post) => (
                  <div key={post.id} style={postCard}>
                    <div style={{ fontWeight: 900, marginBottom: 8 }}>
                      {post.type === "poll" ? "Poll" : "Post"}
                    </div>

                    <div style={{ color: "#ddd", fontSize: 14, lineHeight: 1.55 }}>
                      {post.content}
                    </div>

                    {post.image && (
                      <div style={postImageWrap}>
                        <img
                          src={post.image}
                          alt="Post"
                          style={postImage}
                        />
                      </div>
                    )}

                    {!!post.instagramUrl && (
                      <button
                        onClick={() => window.open(post.instagramUrl, "_blank")}
                        style={miniLinkBtn}
                      >
                        <Instagram size={14} />
                        <span>Instagram</span>
                        <ExternalLink size={12} />
                      </button>
                    )}

                    <div style={postMetaRow}>
                      <span>{post.likes} likes</span>
                      <span>{post.comments.length} comments</span>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {activeTab === "events" && (
          <div style={{ paddingTop: 14 }}>
            {creatorEvents.length === 0 ? (
              <div style={emptyWrap}>
                <div style={emptyTitle}>No events yet</div>
                <div style={emptyText}>
                  This creator does not have linked events yet.
                </div>
              </div>
            ) : (
              creatorEvents.map((event) => (
                <button
                  key={event.id}
                  onClick={() => {
                    setSelectedEvent(event)
                    setCurrentScreen("event-detail")
                  }}
                  style={eventCard}
                >
                  <div style={eventThumbWrap}>
                    <img
                      src={event.image || event.images?.[0] || "/placeholder.svg"}
                      alt={event.title}
                      style={eventThumb}
                    />
                  </div>

                  <div style={{ flex: 1, textAlign: "left" }}>
                    <div style={{ fontWeight: 900, marginBottom: 5 }}>
                      {event.title}
                    </div>

                    <div style={{ color: "#aaa", fontSize: 13, marginBottom: 3 }}>
                      {event.date} • {event.time}
                    </div>

                    {!!event.location && (
                      <div style={{ color: "#8e8e8e", fontSize: 12 }}>
                        {event.location}
                      </div>
                    )}
                  </div>
                </button>
              ))
            )}
          </div>
        )}

        {activeTab === "about" && (
          <div style={{ paddingTop: 14 }}>
            <div style={sectionCard}>
              <div style={sectionTitle}>About this creator</div>

              <div style={aboutText}>
                {selectedCreator.bio || "No additional details yet."}
              </div>
            </div>

            {selectedCreator.socials && Object.values(selectedCreator.socials).some(Boolean) && (
              <div style={sectionCard}>
                <div style={sectionTitle}>Connected platforms</div>

                <div style={socialsGrid}>
                  {selectedCreator.socials.instagram && (
                    <button
                      onClick={() => window.open(selectedCreator.socials?.instagram, "_blank")}
                      style={socialBtn}
                    >
                      <Instagram size={16} />
                      <span>Instagram</span>
                    </button>
                  )}

                  {selectedCreator.socials.facebook && (
                    <button
                      onClick={() => window.open(selectedCreator.socials?.facebook, "_blank")}
                      style={socialBtn}
                    >
                      <span>f</span>
                      <span>Facebook</span>
                    </button>
                  )}

                  {selectedCreator.socials.tiktok && (
                    <button
                      onClick={() => window.open(selectedCreator.socials?.tiktok, "_blank")}
                      style={socialBtn}
                    >
                      <span>♪</span>
                      <span>TikTok</span>
                    </button>
                  )}

                  {selectedCreator.socials.whatsapp && (
                    <button
                      onClick={() => window.open(selectedCreator.socials?.whatsapp, "_blank")}
                      style={socialBtn}
                    >
                      <span>✆</span>
                      <span>WhatsApp</span>
                    </button>
                  )}

                  {selectedCreator.socials.website && (
                    <button
                      onClick={() => window.open(selectedCreator.socials?.website, "_blank")}
                      style={socialBtn}
                    >
                      <span>↗</span>
                      <span>Website</span>
                    </button>
                  )}
                </div>
              </div>
            )}

            {relatedCreators.length > 0 && (
              <div style={sectionCard}>
                <div style={sectionTitle}>Related creators</div>

                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  {relatedCreators.map((creator) => (
                    <button
                      key={creator.id}
                      onClick={() => setCurrentScreen("creator-list")}
                      style={relatedCreatorRow}
                    >
                      <div style={relatedCreatorAvatar}>
                        <img
                          src={creator.avatar || "/placeholder.svg"}
                          alt={creator.name}
                          style={relatedCreatorAvatarImg}
                        />
                      </div>

                      <div style={{ flex: 1, textAlign: "left" }}>
                        <div style={{ fontWeight: 800 }}>{creator.name}</div>
                        <div style={{ color: "#888", fontSize: 12 }}>
                          @{creator.username}
                        </div>
                      </div>

                      <div style={{ color: GOLD, fontSize: 12, fontWeight: 800 }}>
                        {creator.badgeLabel}
                      </div>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>

      <BottomNav />
    </div>
  )
}

