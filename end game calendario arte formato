                      Event Control Center
                    </p>

                    <h1 className="font-serif text-[28px] font-semibold tracking-[-0.04em] text-white">
                      Calendar
                    </h1>

                    <p className="mt-1 line-clamp-1 text-[12px] text-white/45">
                      {headerSubtitle}
                    </p>
                  </div>

                  <button
                    onClick={() => setCurrentScreen("create-event")}
                    className="mt-1 inline-flex shrink-0 items-center gap-2 rounded-full border border-[#C9A84C]/25 bg-[#C9A84C]/12 px-4 py-2.5 text-[12px] font-medium text-[#F6E7BA] shadow-[0_0_22px_rgba(201,168,76,0.08)] transition-all duration-300 active:scale-[0.97]"
                  >
                    <Plus className="h-4 w-4" />
                    Create
                  </button>
                </div>

                <div className="flex items-center justify-between gap-3">
                  <PremiumToggle
                    value={calendarViewMode as CalendarMode}
                    onChange={handleModeChange}
                  />

                  <div className="flex items-center gap-2">
                    <button
                      onClick={() => setFiltersOpen((prev) => !prev)}
                      className={cn(
                        "flex h-[42px] w-[42px] items-center justify-center rounded-full border backdrop-blur-md transition-all duration-300 active:scale-[0.96]",
                        activeFilterCount > 0
                          ? "border-[#C9A84C]/30 bg-[#C9A84C]/12 text-[#F6E7BA]"
                          : "border-white/10 bg-white/[0.045] text-white/60"
                      )}
                    >
                      <SlidersHorizontal className="h-4 w-4" />
                    </button>

                    <button
                      onClick={() => {
                        setFiltersOpen(false)
                        setCalendarSearchOpen(true)
                      }}
                      className="flex h-[42px] w-[42px] items-center justify-center rounded-full border border-white/10 bg-white/[0.045] text-white/60 backdrop-blur-md transition-all duration-300 active:scale-[0.96]"
                    >
                      <Search className="h-4 w-4" />
                    </button>
                  </div>
                </div>

                <div className="flex items-center gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                  <HeaderStat
                    icon={<CalendarIcon className="h-3.5 w-3.5" />}
                    label={selectedDateLabel}
                    active
                  />

                  <HeaderStat
                    icon={<Bell className="h-3.5 w-3.5" />}
                    label={`Pinned ${pinnedEvents.length > 0 ? pinnedEvents.length : ""}`}
                    active={pinnedIndicatorOn}
                  />

                  <HeaderStat
                    icon={<Bookmark className="h-3.5 w-3.5" />}
                    label={`Saved ${savedEvents.length > 0 ? savedEvents.length : ""}`}
                    active={savedIndicatorOn}
                  />
                </div>

                <div className="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                  {QUICK_CHIPS.map((chip) => (
                    <QuickChip
                      key={chip.key}
                      label={chip.label}
                      active={activeQuickChip(chip)}
                      onClick={() => handleQuickChip(chip)}
                    />
                  ))}
                </div>

                <div
                  className={cn(
                    "grid transition-all duration-300",
                    filtersOpen
                      ? "grid-rows-[1fr] opacity-100"
                      : "grid-rows-[0fr] opacity-0"
                  )}
                >
                  <div className="overflow-hidden">
                    <div className="rounded-[24px] border border-white/10 bg-[#121212]/92 p-3 shadow-[0_18px_45px_rgba(0,0,0,0.22)] backdrop-blur-xl">
                      <div className="mb-3 flex items-center justify-between gap-3">
                        <div>
                          <p className="text-[12px] font-medium text-white">
                            Refine events
                          </p>

                          <p className="mt-0.5 text-[11px] text-white/40">
                            Keep it curated, fast, and clean.
                          </p>
                        </div>

                        {selectedFilters.length > 0 && (
                          <button
                            onClick={clearAllFilters}
                            className="rounded-full border border-[#C9A84C]/20 bg-[#C9A84C]/10 px-3 py-1.5 text-[11px] font-medium text-[#F6E7BA] transition-all duration-300 active:scale-[0.97]"
                          >
                            Clear
                          </button>
                        )}
                      </div>

                      <div className="flex flex-wrap gap-2">
                        {FILTER_OPTIONS.map((filter) => {
                          const active = selectedFilters.includes(filter.key)

                          return (
                            <button
                              key={filter.key}
                              onClick={() => toggleFilter(filter.key)}
                              className={cn(
                                "rounded-full border px-3 py-2 text-[11px] font-medium transition-all duration-300 active:scale-[0.97]",
                                active
                                  ? "border-[#C9A84C]/30 bg-[#C9A84C]/14 text-[#F6E7BA] shadow-[0_0_18px_rgba(201,168,76,0.08)]"
                                  : "border-white/10 bg-white/[0.04] text-white/60 hover:border-white/15 hover:bg-white/[0.06]"
                              )}
                            >
                              {filter.label}
                            </button>
                          )
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ) : (
              <div className="flex gap-2">
                <button
                  onClick={() => {
                    setCalendarSearchOpen(false)
                    setCalendarSearchQuery("")
                  }}
                  className="flex h-[50px] w-[50px] shrink-0 items-center justify-center rounded-full border border-white/10 bg-[#121212]/95 text-white/65 backdrop-blur-xl transition-all duration-300 active:scale-[0.96]"
                >
                  <X className="h-4 w-4" />
                </button>

                <div className="relative flex-1">
                  <Search className="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-white/35" />

                  <input
                    value={calendarSearchQuery}
                    onChange={(event) => setCalendarSearchQuery(event.target.value)}
                    placeholder="Search events, hosts, places..."
                    className="h-[50px] w-full rounded-full border border-white/10 bg-[#121212]/95 pl-11 pr-5 text-[14px] text-white placeholder:text-white/35 outline-none backdrop-blur-xl transition-all duration-300 focus:border-[#C9A84C]/30 focus:bg-[#121212]"
                  />
                </div>

                <button
                  onClick={() => setCurrentScreen("create-event")}
                  className="h-[50px] shrink-0 rounded-full border border-[#C9A84C]/25 bg-[#C9A84C]/12 px-5 text-[12px] font-medium text-[#F6E7BA] transition-all duration-300 active:scale-[0.97]"
                >
                  Create
                </button>
              </div>
            )}

            {calendarViewMode === "focus" ? (
              <div className="mt-4 space-y-4">
                <div
                  ref={daysStripRef}
                  className="flex snap-x gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
                >
                  {focusDays.map((date) => {
                    const dateStr = formatDateString(date)
                    const eventsCount = sourceEvents.filter(
                      (event) => event.date === dateStr
                    ).length

                    return (
                      <FocusDayPill
                        key={dateStr}
                        date={date}
                        selected={selectedDate === dateStr && !quickScope}
                        eventsCount={eventsCount}
                        onClick={() => handleDateSelect(dateStr)}
                      />
                    )
                  })}
                </div>

                {pinnedVisibleEvents.length > 0 && !quickScope && (
                  <div className="space-y-3">
                    <SectionTitle
                      title="Highlights"
                      subtitle="Pinned moments worth keeping close."
                    />

                    <div className="flex gap-3 overflow-x-auto pb-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                      {pinnedVisibleEvents.map((event) => (
                        <PinnedHighlightCard
                          key={event.id}
                          event={event}
                          onOpen={() => handleEventSelect(event)}
                        />
                      ))}
                    </div>
                  </div>
                )}

                <div className="flex items-center justify-between gap-3">
                  <div>
                    <h3 className="font-serif text-[22px] font-semibold tracking-[-0.03em] text-white">
                      {quickScope
                        ? QUICK_CHIPS.find((chip) => chip.key === quickScope)?.label
                        : "Upcoming Events"}
                    </h3>

                    <p className="mt-1 text-[12px] text-white/45">
                      {quickScope
                        ? `${focusEvents.length} curated result${
                            focusEvents.length === 1 ? "" : "s"
                          }`
                        : selectedDateLabel}
                    </p>
                  </div>

                  {activeFilterCount > 0 && (
                    <button
                      onClick={() => {
                        setQuickScope(null)
                        setCalendarFilters([])
                      }}
                      className="rounded-full border border-white/10 bg-white/[0.04] px-3 py-2 text-[11px] font-medium text-white/55 transition-all duration-300 active:scale-[0.97]"
                    >
                      Reset
                    </button>
                  )}
                </div>
              </div>
            ) : (
              <div className="mt-4 space-y-4">
                <div className="mx-auto w-full max-w-[360px] overflow-hidden rounded-[28px] border border-[#C9A84C]/15 bg-[#121212]/92 p-3 shadow-[0_22px_55px_rgba(0,0,0,0.28)] backdrop-blur-xl">
                  <div className="mb-3 flex items-center justify-between">
                    <button
                      onClick={prevMonth}
                      className="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-white/60 transition-all duration-300 active:scale-[0.96]"
                    >
                      <ChevronLeft className="h-4 w-4" />
                    </button>

                    <div className="text-center">
                      <h3 className="font-serif text-[19px] font-semibold tracking-[-0.03em] text-white">
                        {MONTH_NAMES[month]} {year}
                      </h3>

                      <p className="mt-0.5 text-[10px] uppercase tracking-[0.22em] text-[#C9A84C]/65">
                        Expanded View
                      </p>
                    </div>

                    <button
                      onClick={nextMonth}
                      className="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-white/60 transition-all duration-300 active:scale-[0.96]"
                    >
                      <ChevronRight className="h-4 w-4" />
                    </button>
                  </div>

                  <div className="mb-1 grid grid-cols-7 gap-1">
                    {DAY_NAMES.map((day, index) => (
                      <div
                        key={`${day}-${index}`}
                        className="py-1.5 text-center text-[10px] font-medium uppercase tracking-[0.14em] text-white/35"
                      >
                        {day}
                      </div>
                    ))}
                  </div>

                  <div className="grid grid-cols-7 gap-1">
                    {calendarDays.map((day, index) => {
                      if (day === null) {
                        return <div key={`blank-${index}`} />
                      }

                      const dayEvents = getEventsOnDay(day)

                      return (
                        <MonthDayCell
                          key={`${year}-${month}-${day}`}
                          day={day}
                          selected={isSelectedDay(day)}
                          events={dayEvents}
                          onClick={() => handleMonthDaySelect(day)}
                        />
                      )
                    })}
                  </div>
                </div>

                <div className="rounded-[28px] border border-white/10 bg-[#121212]/88 p-4 shadow-[0_18px_45px_rgba(0,0,0,0.22)] backdrop-blur-xl">
                  <div className="flex items-center justify-between gap-3">
                    <div className="min-w-0">
                      <p className="text-[10px] font-medium uppercase tracking-[0.24em] text-[#C9A84C]/75">
                        Selected Day
                      </p>

                      <h3 className="mt-1 line-clamp-1 font-serif text-[22px] font-semibold tracking-[-0.03em] text-white">
                        {selectedDateLabel}
                      </h3>

                      <p className="mt-1 text-[12px] text-white/45">
                        {selectedDateEvents.length === 1
                          ? "1 event scheduled"
                          : `${selectedDateEvents.length} events scheduled`}
                      </p>
                    </div>

                    <button
                      onClick={() => setCalendarViewMode("focus")}
                      className="shrink-0 rounded-full border border-[#C9A84C]/20 bg-[#C9A84C]/10 px-4 py-2 text-[11px] font-medium text-[#F6E7BA] transition-all duration-300 active:scale-[0.97]"
                    >
                      Focus
                    </button>
                  </div>
                </div>
              </div>
            )}
          </div>
          <div className="px-0 pt-5">
            {calendarViewMode === "focus" ? (
              <div className="space-y-6 pb-4">
                {!hasAnyVisibleEvents ? (
                  <EmptyState
                    title="Nothing scheduled yet"
                    subtitle="Explore another day, clear filters, or create the next Sin Vergüenza moment."
                    cta={
                      <div className="flex flex-wrap justify-center gap-2">
                        <button
                          onClick={() => setCurrentScreen("create-event")}
                          className="rounded-full border border-[#C9A84C]/25 bg-[#C9A84C]/12 px-5 py-2.5 text-[12px] font-medium text-[#F6E7BA] transition-all duration-300 active:scale-[0.97]"
                        >
                          Create Event
                        </button>

                        <button
                          onClick={() => {
                            setQuickScope(null)
                            setCalendarFilters([])
                            setCalendarSearchQuery("")
                          }}
                          className="rounded-full border border-white/10 bg-white/[0.045] px-5 py-2.5 text-[12px] font-medium text-white/60 transition-all duration-300 active:scale-[0.97]"
                        >
                          Reset View
                        </button>
                      </div>
                    }
                  />
                ) : quickScope ? (
                  <div className="space-y-3">
                    {focusEvents
                      .slice(
                        0,
                        selectedDayExpanded
                          ? focusEvents.length
                          : INITIAL_VISIBLE_SELECTED_DAY
                      )
                      .map((event, index) => (
                        <CompactEventCard
                          key={event.id}
                          event={event}
                          index={index}
                          mounted={mounted}
                          isOpening={openingEventId === event.id}
                          highlighted={calendarHighlightedEventId === event.id}
                          onOpen={() => handleEventSelect(event)}
                          onToggleSave={toggleSave}
                        />
                      ))}

                    <ViewMoreButton
                      expanded={selectedDayExpanded}
                      hiddenCount={Math.max(
                        focusEvents.length - INITIAL_VISIBLE_SELECTED_DAY,
                        0
                      )}
                      onClick={() => setSelectedDayExpanded((prev) => !prev)}
                    />
                  </div>
                ) : groupedFocusEvents.length > 0 ? (
                  <div className="space-y-6">
                    {groupedFocusEvents.map((group) => {
                      const expanded = expandedGroups[group.key]
                      const visibleEvents = expanded
                        ? group.events
                        : group.events.slice(0, INITIAL_VISIBLE_PER_GROUP)

                      const hiddenCount = Math.max(
                        group.events.length - INITIAL_VISIBLE_PER_GROUP,
                        0
                      )

                      return (
                        <section key={group.key} className="space-y-3">
                          <div className="flex items-end justify-between gap-3 px-1">
                            <div>
                              <h3 className="font-serif text-[21px] font-semibold tracking-[-0.03em] text-white">
                                {group.title}
                              </h3>

                              <p className="mt-1 text-[12px] text-white/42">
                                {group.subtitle}
                              </p>
                            </div>

                            <span className="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[10px] font-medium uppercase tracking-[0.14em] text-white/40">
                              {formatShortDate(group.key)}
                            </span>
                          </div>

                          <div className="space-y-3">
                            {visibleEvents.map((event, index) => (
                              <CompactEventCard
                                key={event.id}
                                event={event}
                                index={index}
                                mounted={mounted}
                                isOpening={openingEventId === event.id}
                                highlighted={
                                  calendarHighlightedEventId === event.id
                                }
                                onOpen={() => handleEventSelect(event)}
                                onToggleSave={toggleSave}
                              />
                            ))}
                          </div>

                          <ViewMoreButton
                            expanded={expanded}
                            hiddenCount={hiddenCount}
                            onClick={() => toggleGroupExpanded(group.key)}
                          />
                        </section>
                      )
                    })}
                  </div>
                ) : (
                  <div className="space-y-3">
                    {visibleSelectedDayEvents.map((event, index) => (
                      <CompactEventCard
                        key={event.id}
                        event={event}
                        index={index}
                        mounted={mounted}
                        isOpening={openingEventId === event.id}
                        highlighted={calendarHighlightedEventId === event.id}
                        onOpen={() => handleEventSelect(event)}
                        onToggleSave={toggleSave}
                      />
                    ))}

                    <ViewMoreButton
                      expanded={selectedDayExpanded}
                      hiddenCount={hiddenSelectedDayCount}
                      onClick={() => setSelectedDayExpanded((prev) => !prev)}
                    />
                  </div>
                )}
              </div>
            ) : (
              <div className="space-y-4 pb-4">
                {filteredEvents.length === 0 ? (
                  <EmptyState
                    title="No events here yet"
                    subtitle="This date is quiet. Try a nearby day, reset filters, or create something worth showing up for."
                    cta={
                      <div className="flex flex-wrap justify-center gap-2">
                        <button
                          onClick={() => setCurrentScreen("create-event")}
                          className="rounded-full border border-[#C9A84C]/25 bg-[#C9A84C]/12 px-5 py-2.5 text-[12px] font-medium text-[#F6E7BA] transition-all duration-300 active:scale-[0.97]"
                        >
                          Create Event
                        </button>

                        <button
                          onClick={() => {
                            setCalendarFilters([])
                            setCalendarSearchQuery("")
                            setQuickScope(null)
                          }}
                          className="rounded-full border border-white/10 bg-white/[0.045] px-5 py-2.5 text-[12px] font-medium text-white/60 transition-all duration-300 active:scale-[0.97]"
                        >
                          Clear Filters
                        </button>
                      </div>
                    }
                  />
                ) : (
                  <>
                    <div className="flex items-center justify-between gap-3 px-1">
                      <div>
                        <h3 className="font-serif text-[21px] font-semibold tracking-[-0.03em] text-white">
                          Events on this day
                        </h3>

                        <p className="mt-1 text-[12px] text-white/42">
                          {filteredEvents.length === 1
                            ? "1 event ready to view"
                            : `${filteredEvents.length} events ready to view`}
                        </p>
                      </div>

                      {filteredEvents.length >
                        INITIAL_VISIBLE_SELECTED_DAY && (
                        <button
                          onClick={() =>
                            setSelectedDayExpanded((prev) => !prev)
                          }
                          className="rounded-full border border-white/10 bg-white/[0.045] px-3 py-2 text-[11px] font-medium text-white/55 transition-all duration-300 active:scale-[0.97]"
                        >
                          {selectedDayExpanded ? "Less" : "More"}
                        </button>
                      )}
                    </div>

                    <div className="space-y-3">
                      {(selectedDayExpanded
                        ? filteredEvents
                        : filteredEvents.slice(
                            0,
                            INITIAL_VISIBLE_SELECTED_DAY
                          )
                      ).map((event, index) => (
                        <CompactEventCard
                          key={event.id}
                          event={event}
                          index={index}
                          mounted={mounted}
                          isOpening={openingEventId === event.id}
                          highlighted={calendarHighlightedEventId === event.id}
                          onOpen={() => handleEventSelect(event)}
                          onToggleSave={toggleSave}
                        />
                      ))}
                    </div>

                    <ViewMoreButton
                      expanded={selectedDayExpanded}
                      hiddenCount={Math.max(
                        filteredEvents.length - INITIAL_VISIBLE_SELECTED_DAY,
                        0
                      )}
                      onClick={() => setSelectedDayExpanded((prev) => !prev)}
                    />
                  </>
                )}
              </div>
            )}
          </div>
        </div>
      </div>

          <div className="absolute inset-x-0 bottom-0 z-[80]">
        <BottomNav />
      </div>
    </div>
  )
}