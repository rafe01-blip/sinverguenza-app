/* =========================
   STORY SORTING
========================= */

function sortStoriesForSource(
  stories: CommunityStory[],
  source: "home" | "community",
  myUserId?: string | null
) {
  if (source === "home") {
    return [...stories].sort((a, b) => {
      const aIsMine = a.authorId === myUserId
      const bIsMine = b.authorId === myUserId

      if (aIsMine && !bIsMine) return -1
      if (!aIsMine && bIsMine) return 1

      const aSeen = a.seenByMe ? 1 : 0
      const bSeen = b.seenByMe ? 1 : 0

      if (aSeen !== bSeen) return aSeen - bSeen

      return getStorySortTimestamp(b) - getStorySortTimestamp(a)
    })
  }

  return [...stories].sort(
    (a, b) => getStorySortTimestamp(b) - getStorySortTimestamp(a)
  )
}

