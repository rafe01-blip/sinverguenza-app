const DEFAULT_AVATAR = "/images/avatar-placeholder.png"


function getSafeImage(src?: string | null) {
  if (!src || src.includes("placeholder") || src === "/placeholder.svg") {
    return DEFAULT_AVATAR
  }
  return src
}

