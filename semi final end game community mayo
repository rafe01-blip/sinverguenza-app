        )}

        <div className="mt-3 flex items-center gap-2 rounded-full border border-white/10 bg-[#111111] px-3 py-2">
          <Instagram className="h-4 w-4 text-zinc-500" />

          <input
            value={instagramUrl}
            onChange={(e) => setInstagramUrl(e.target.value)}
            placeholder="Instagram link optional"
            className="min-w-0 flex-1 bg-transparent text-sm text-white outline-none placeholder:text-zinc-600"
          />
        </div>

        <div className="mt-4 flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <input
              ref={fileInputRef}
              type="file"
              accept="image/*,video/*"
              onChange={handleImageSelect}
              className="hidden"
            />

            <button
              onClick={() => fileInputRef.current?.click()}
              className="rounded-2xl border border-white/10 bg-white/[0.04] p-2 text-zinc-400 transition-colors hover:text-primary"
            >
              {composerType === "video" ? (
                <Play className="h-5 w-5" />
              ) : (
                <ImageIcon className="h-5 w-5" />
              )}
            </button>

            <span className="text-[11px] text-zinc-500">
              {composerType === "video" ? "Max 60s video" : "Add media"}
            </span>
          </div>

          <div className="flex items-center gap-2">
            <Button
              variant="outline"
              size="sm"
              onClick={closeComposer}
              className="rounded-full"
            >
              Cancel
            </Button>

            <Button
              onClick={handleCreatePost}
              disabled={!newPostContent.trim()}
              size="sm"
              className="rounded-full gap-2"
            >
              <Send className="h-4 w-4" />
              Publish
            </Button>
          </div>
        </div>
      </div>
    </div>
  )
}
///////////////////////////////////////////////////////////////
// STICKY SHARE BAR — WHATSAPP / IMESSAGE STYLE
///////////////////////////////////////////////////////////////

function StickyShareBar({
  user,
  quickText,
  setQuickText,
  submitQuickPost,
  openComposer,
}: {
  user: ReturnType<typeof useApp>["user"]
  quickText: string
  setQuickText: React.Dispatch<React.SetStateAction<string>>
  submitQuickPost: () => void
  openComposer: () => void
}) {
  return (
    <div className="fixed bottom-[92px] left-0 right-0 z-40 px-3">
      <div className="mx-auto flex max-w-xl items-center gap-2 rounded-[26px] border border-primary/20 bg-[#0f0f0f]/95 p-2 shadow-[0_16px_45px_rgba(0,0,0,0.55)] backdrop-blur-xl">
        <button
          onClick={openComposer}
          className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-black shadow-[0_0_18px_rgba(201,168,76,0.28)] active:scale-[0.94]"
        >
          <Plus className="h-6 w-6 stroke-[2.4]" />
        </button>

        <input
          value={quickText}
          onChange={(e) => setQuickText(e.target.value.slice(0, 160))}
          placeholder="Share something..."
          className="h-11 min-w-0 flex-1 rounded-full border border-white/10 bg-white/[0.05] px-4 text-[14px] text-white outline-none placeholder:text-zinc-500 focus:border-primary/40"
          onKeyDown={(e) => {
            if (e.key === "Enter") {
              e.preventDefault()
              submitQuickPost()
            }
          }}
        />

        <button
          onClick={quickText.trim() ? submitQuickPost : openComposer}
          className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/[0.05] text-zinc-300 active:scale-[0.94]"
        >
          {quickText.trim() ? <Send className="h-5 w-5" /> : <ImageIcon className="h-5 w-5" />}
        </button>
      </div>
    </div>
  )
}
///////////////////////////////////////////////////////////////
// COMMUNITY SCREEN
///////////////////////////////////////////////////////////////

export function CommunityScreen() {
  const {
    user,
    creators,
    communityPosts,
    createCommunityPost,
    toggleCommunityLike,
    addCommunityComment,
    addCommunityReply,
    voteOnPoll,
    openCreatorProfile,
    toggleFollow,
    getTopCreators,
    getStoriesForSource,
    spaces,
    openSpace,
    setCurrentScreen,
  } = useApp()

  const [newPostContent, setNewPostContent] = useState("")
  const [newPostImage, setNewPostImage] = useState<string | null>(null)
  const [instagramUrl, setInstagramUrl] = useState("")
  const [showComposer, setShowComposer] = useState(false)
  const [composerType, setComposerType] = useState<ComposerType>("post")
  const [storyAudience, setStoryAudience] = useState<StoryAudienceOption>("both")
  const [quickText, setQuickText] = useState("")
  const [expandedComments, setExpandedComments] = useState<string[]>([])
  const [commentText, setCommentText] = useState<Record<string, string>>({})
  const [replyText, setReplyText] = useState<Record<string, string>>({})
  const [replyingTo, setReplyingTo] = useState<{
    postId: string
    commentId: string
  } | null>(null)

  const [pollOption1, setPollOption1] = useState("")
  const [pollOption2, setPollOption2] = useState("")
  const [selectedSpaceForPost, setSelectedSpaceForPost] =
    useState<SpaceKey | null>(null)

  const [showCreators, setShowCreators] = useState(false)
  const [showSpaces, setShowSpaces] = useState(false)
  const [trendingExpanded, setTrendingExpanded] = useState(false)
  
  const fileInputRef = useRef<HTMLInputElement>(null)

  const topCreators = useMemo(() => getTopCreators(), [creators])
  const publicStories = getStoriesForSource("community")

  const storyIds = useMemo(() => {
    return publicStories.map((story) => story.id)
  }, [publicStories])

  const visibleFeedPosts = useMemo(() => {
    return communityPosts.filter(
      (post) => post.type === "post" || post.type === "poll" || post.type === "video"
    )
  }, [communityPosts])

  const trendingPosts = useMemo(() => {
    return [...visibleFeedPosts].sort((a, b) => b.likes - a.likes).slice(0, 3)
  }, [visibleFeedPosts])

  const resetComposer = () => {
    setNewPostContent("")
    setNewPostImage(null)
    setInstagramUrl("")
    setComposerType("post")
    setStoryAudience("both")
    setPollOption1("")
    setPollOption2("")
    setSelectedSpaceForPost(null)
  }

  const handleImageSelect = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return

    const reader = new FileReader()
    reader.onload = (event) => {
      setNewPostImage(event.target?.result as string)
    }
    reader.readAsDataURL(file)
  }

  const handleCreatePost = () => {
    const trimmed = newPostContent.trim()
    if (!trimmed) return

    if (composerType === "poll" && (!pollOption1.trim() || !pollOption2.trim())) {
      return
    }

    createCommunityPost({
      content: trimmed,
      image: newPostImage || undefined,
      instagramUrl: instagramUrl.trim() || undefined,
      type: composerType,
      audience:
        composerType === "story" || composerType === "video"
          ? storyAudience
          : undefined,
      pollOptions:
        composerType === "poll"
          ? [pollOption1.trim(), pollOption2.trim()].filter(Boolean)
          : undefined,
      spaceKey: selectedSpaceForPost,
    })

    resetComposer()
    setShowComposer(false)
  }
const submitQuickPost = () => {
  const trimmed = quickText.trim()
  if (!trimmed) return

  createCommunityPost({
    content: trimmed,
    type: "post",
    image: undefined,
    instagramUrl: undefined,
    spaceKey: null,
  })

  setQuickText("")
}
  const toggleComments = (postId: string) => {
    setExpandedComments((prev) =>
      prev.includes(postId)
        ? prev.filter((id) => id !== postId)
        : [...prev, postId]
    )
  }

  const handleShare = async (text: string, instagramLink?: string) => {
    if (typeof navigator !== "undefined" && navigator.share) {
      try {
        await navigator.share({ text })
        return
      } catch {}
    }

    if (instagramLink && typeof window !== "undefined") {
      window.open(instagramLink, "_blank", "noopener,noreferrer")
    }
  }

  return (
    <div className="flex h-screen flex-col overflow-hidden bg-background">
      <TopHeader title="Community" showProfile />

<div className="flex-1 overflow-y-auto pb-52">
        <div className="px-4 pt-4">
          <CommunityHero />
        </div>

        <StoriesSection storyIds={storyIds} />

        <TopCreatorsStrip
          creators={topCreators}
          openCreatorProfile={openCreatorProfile}
          toggleFollow={toggleFollow}
          showCreators={showCreators}
          setShowCreators={setShowCreators}
        />

        <SpacesPreview
         spaces={spaces}
         openSpace={openSpace}
        openExplore={() => setCurrentScreen("spaces")}
        showSpaces={showSpaces}
        setShowSpaces={setShowSpaces}
        />

        <TrendingPreview
          trendingPosts={trendingPosts}
          creators={creators}
          openCreatorProfile={openCreatorProfile}
          expanded={trendingExpanded}
          setExpanded={setTrendingExpanded}
        />

        <div className="pt-2">
          {visibleFeedPosts.map((post) => {
            const creator = creators.find((item) => item.id === post.authorId)
            if (!creator) return null

            return (
              <PostCard
                key={post.id}
                post={post}
                creator={creator}
                user={user}
                openCreatorProfile={openCreatorProfile}
                openSpace={openSpace}
                voteOnPoll={voteOnPoll}
                toggleCommunityLike={toggleCommunityLike}
                expandedComments={expandedComments}
                toggleComments={toggleComments}
                handleShare={handleShare}
                commentText={commentText}
                setCommentText={setCommentText}
                replyText={replyText}
                setReplyText={setReplyText}
                replyingTo={replyingTo}
                setReplyingTo={setReplyingTo}
                addCommunityComment={addCommunityComment}
                addCommunityReply={addCommunityReply}
              />
            )
          })}
        </div>
      </div>

      <ComposerSheet
        user={user}
        spaces={spaces}
        showComposer={showComposer}
        setShowComposer={setShowComposer}
        composerType={composerType}
        setComposerType={setComposerType}
        storyAudience={storyAudience}
        setStoryAudience={setStoryAudience}
        newPostContent={newPostContent}
        setNewPostContent={setNewPostContent}
        newPostImage={newPostImage}
        setNewPostImage={setNewPostImage}
        instagramUrl={instagramUrl}
        setInstagramUrl={setInstagramUrl}
        selectedSpaceForPost={selectedSpaceForPost}
        setSelectedSpaceForPost={setSelectedSpaceForPost}
        pollOption1={pollOption1}
        setPollOption1={setPollOption1}
        pollOption2={pollOption2}
        setPollOption2={setPollOption2}
        fileInputRef={fileInputRef}
        handleImageSelect={handleImageSelect}
        handleCreatePost={handleCreatePost}
        resetComposer={resetComposer}
      />

     <StickyShareBar
  user={user}
  quickText={quickText}
  setQuickText={setQuickText}
  submitQuickPost={submitQuickPost}
  openComposer={() => setShowComposer(true)}
/>

      <BottomNav />
    </div>
  )
}