  return {
    ...story,
    media,
    image: safeImage(story.image || getPrimaryMediaUrl(media)),
    thumbnailUrl: safeImage(story.thumbnailUrl || getPrimaryMediaUrl(media)),
    durationSeconds: Math.min(story.durationSeconds ?? 8, 60),
