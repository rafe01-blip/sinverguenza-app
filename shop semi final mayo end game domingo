}

type ShopProductInput = Omit<ProductType, "colorOptions"> & {
  heroImage?: string
  featuredImage?: string
  hoverImage?: string
  colorOptions?: ShopColorOption[]
}

type EnhancedProduct = Omit<ProductType, "colorOptions"> & {
  category: ShopCategory | string
  gender?: "male" | "female" | "unisex"
  compareAtPrice?: number
  material?: string
  fit?: string
  care?: string
  shippingNote?: string
  availability?: "in-stock" | "low-stock" | "out-of-stock"
  featured?: boolean
  isNew?: boolean
  isBestSeller?: boolean
  isLimited?: boolean
  sortOrder?: number
  lifestyleImages?: string[]
  heroImage?: string
  featuredImage?: string
  hoverImage?: string
  colorOptions?: ShopColorOption[]
}

