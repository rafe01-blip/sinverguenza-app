    setSpaces((prev) =>
      prev.map((item) => {
        if (item.key !== space) return normalizeSpace(item)

        if (item.visibility === "private" && !item.isJoined) {
          return normalizeSpace({
            ...item,
            requestStatus: "pending",
            isJoined: false,
          })
        }

        const nextJoined = !item.isJoined

        return normalizeSpace({
          ...item,
          isJoined: nextJoined,
          requestStatus: nextJoined ? "approved" : "none",
          membersCount: nextJoined
            ? item.membersCount + 1
            : Math.max(0, item.membersCount - 1),
        })
      })
    )
  }

  const getMaxSpacesAllowed = (eventCount: number): number => {
    if (eventCount >= 6) return 5
    if (eventCount >= 3) return 3
    return 1
  }

  const getSpaceLimitInfo = () => {
    const createdEvents = user?.createdEventCount ?? 0
    const createdSpaces = user?.createdSpaceCount ?? 0
    const maxSpacesAllowed = getMaxSpacesAllowed(createdEvents)
    const remainingSpaces = Math.max(0, maxSpacesAllowed - createdSpaces)

    let nextUnlockMessage = "Create 3 events to unlock up to 3 spaces"

    if (createdEvents >= 6) {
      nextUnlockMessage = "Maximum creator space limit unlocked"
    } else if (createdEvents >= 3) {
      nextUnlockMessage = "Create 6 events to unlock up to 5 spaces"
    }

    return {
      createdEvents,
      createdSpaces,
      maxSpacesAllowed,
      remainingSpaces,
      canCreateMore: remainingSpaces > 0,
      nextUnlockMessage,
    }
  }

