function mergeUserWithDefaults(
  storedUser: UserType | null | undefined,
  fallback: UserType
): UserType {
  if (!storedUser) return fallback

  const isPrototype =
    storedUser.name?.toLowerCase() === "prototype" ||
    storedUser.username?.toLowerCase() === "prototype"

  if (isPrototype) return fallback

  return {
    ...fallback,
    ...storedUser,
    id: "me-user",
    name: "Mario",
    username: "mariorafaelrosario",
    avatar: safeImage(storedUser.avatar || fallback.avatar),
    coverImage: safeImage(storedUser.coverImage || fallback.coverImage),
    socials: {
      ...(fallback.socials || {}),
      ...(storedUser.socials || {}),
    },
    preferences: {
      ...(fallback.preferences || {}),
      ...(storedUser.preferences || {}),
      blockedUsers: storedUser.preferences?.blockedUsers ?? [],
      restrictedEventTypes:
        storedUser.preferences?.restrictedEventTypes ??
        fallback.preferences?.restrictedEventTypes ??
        ["all"],
      eventPreferences:
        storedUser.preferences?.eventPreferences ??
        fallback.preferences?.eventPreferences,
      notificationPreferences:
        storedUser.preferences?.notificationPreferences ??
        fallback.preferences?.notificationPreferences,
    },
  }
}

function mergeEventsWithDefaults(
  baseEvents: EventType[],
  storedEvents?: EventType[]
) {
  const cleanedStoredEvents = (storedEvents ?? [])
    .map(normalizeEvent)
    .filter((event) => {
      const text = [
        event.hostName,
        event.hostUsername,
        event.hostInstagram,
        event.organizer,
        event.organizerInstagram,
        event.organizerCreatorId,
        event.postedByName,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase()

      return !text.includes("prototype")
    })

  return uniqueById([
    ...cleanedStoredEvents,
    ...baseEvents.map(normalizeEvent),
  ])
}

function mergeCreatorsWithDefaults(
  baseCreators: Creator[],
  storedCreators?: Creator[],
  user?: UserType | null
) {
  const merged = uniqueById([
    ...(storedCreators ?? []).map(normalizeCreator),
    ...baseCreators.map(normalizeCreator),
  ])

  const cleaned = merged.filter(
    (creator) =>
      creator.id !== "prototype" &&
      creator.id !== "creator-prototype" &&
      creator.name?.toLowerCase() !== "prototype" &&
      creator.username?.toLowerCase() !== "prototype"
  )

  return ensureOfficialSVCreator(upsertMeCreator(cleaned, user || INITIAL_USER))
}

function mergeSpacesWithDefaults(
  baseSpaces: SpaceType[],
  storedSpaces?: SpaceType[]
) {
  return uniqueByKey([
    ...(storedSpaces ?? []).map(normalizeSpace),
    ...baseSpaces.map(normalizeSpace),
  ])
}

function mergeProductsWithDefaults(
  baseProducts: ProductType[],
  storedProducts?: ProductType[]
) {
  return uniqueById([
    ...(storedProducts ?? []).map((product, index) =>
      normalizeProduct(product, index)
    ),
    ...baseProducts.map((product, index) => normalizeProduct(product, index)),
  ])
}

function cleanupEvents(events: EventType[]) {
  return events.map((event) => {
    const status = getEventLifecycleStatusStatic(event)

    return normalizeEvent({
      ...event,
      lifecycleStatus: status,
      isPinned:
        event.isPinned && status !== "archived" && status !== "expired",
      hiddenFromHome:
        event.hiddenFromHome ||
        status === "archived" ||
        status === "expired",
      archivedAt:
        status === "archived" && !event.archivedAt
          ? new Date().toISOString()
          : event.archivedAt,
    })
  })
}

function getEventLifecycleStatusStatic(event: EventType): EventLifecycleStatus {
  const { start, end } = getEventDateTime(event)
  const now = Date.now()

  if (now < start.getTime()) return "upcoming"
  if (now >= start.getTime() && now <= end.getTime()) return "live"

  const thirtySixHours = 36 * 60 * 60 * 1000
  if (now <= end.getTime() + thirtySixHours) return "just-ended"

  return "archived"
}

function shouldKeepEventInProfileStatic(event: EventType) {
  return Boolean(
    event.isSaved ||
      event.isLiked ||
      event.attendanceStatus ||
      event.keepInProfile ||
      event.organizerCreatorId === "me-user" ||
      event.postedById === "me-user" ||
      event.featuredBadge
  )
}
