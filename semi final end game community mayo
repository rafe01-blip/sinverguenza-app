function SafeImage({
  src,
  alt,
  fill = true,
  className = "object-cover",
}: {
  src?: string | null
  alt: string
  fill?: boolean
  className?: string
}) {
  const safeSrc = getSafeImage(src)

  if (fill) {
    return <Image src={safeSrc} alt={alt} fill className={className} />
  }

  return (
    <Image
      src={safeSrc}
      alt={alt}
      width={48}
      height={48}
      className={className}
    />
  )
}

