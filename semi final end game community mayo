function CommentsBlock({
  post,
  user,
  commentText,
  setCommentText,
  replyText,
  setReplyText,
  replyingTo,
  setReplyingTo,
  addCommunityComment,
  addCommunityReply,
}: {
  post: ReturnType<typeof useApp>["communityPosts"][number]
  user: ReturnType<typeof useApp>["user"]
  commentText: Record<string, string>
  setCommentText: React.Dispatch<React.SetStateAction<Record<string, string>>>
  replyText: Record<string, string>
  setReplyText: React.Dispatch<React.SetStateAction<Record<string, string>>>
  replyingTo: { postId: string; commentId: string } | null
  setReplyingTo: React.Dispatch<
    React.SetStateAction<{ postId: string; commentId: string } | null>
  >
  addCommunityComment: (postId: string, text: string) => void
  addCommunityReply: (postId: string, commentId: string, text: string) => void
}) {
  const submitComment = () => {
    const text = commentText[post.id] || ""
    if (!text.trim()) return

    addCommunityComment(post.id, text)

    setCommentText((prev) => ({
      ...prev,
      [post.id]: "",
    }))
  }

  const submitReply = (commentId: string) => {
    const text = replyText[commentId] || ""
    if (!text.trim()) return

    addCommunityReply(post.id, commentId, text)

    setReplyText((prev) => ({
      ...prev,
      [commentId]: "",
    }))

    setReplyingTo(null)
  }

  return (
    <div className="mt-4 space-y-3 border-t border-white/10 pt-4">
      <div className="flex items-center gap-2">
        <Avatar
          src={user?.avatar}
          name={user?.name || "User"}
          size={32}
        />

        <Input
          value={commentText[post.id] || ""}
          onChange={(e) =>
            setCommentText((prev) => ({
              ...prev,
              [post.id]: e.target.value.slice(0, 120),
            }))
          }
          placeholder="Write a comment..."
          className="h-9 flex-1 rounded-full border-white/10 bg-white/[0.04] text-sm"
          onKeyDown={(e) => {
            if (e.key === "Enter" && !e.shiftKey) {
              e.preventDefault()
              submitComment()
            }
          }}
        />

        <button
          onClick={submitComment}
          disabled={!commentText[post.id]?.trim()}
          className="flex h-9 w-9 items-center justify-center rounded-full border border-primary/25 bg-primary/10 text-primary disabled:opacity-40"
        >
          <Send className="h-4 w-4" />
        </button>
      </div>

      {post.comments.length === 0 ? (
        <p className="py-2 text-center text-[13px] text-zinc-500">
          No comments yet. Be the first to comment.
        </p>
      ) : (
        <div className="space-y-3">
          {post.comments.slice(-10).map((comment) => (
            <div key={comment.id} className="space-y-2">
              <div className="flex items-start gap-2">
                <Avatar
                  src={comment.authorAvatar}
                  name={comment.authorName}
                  size={30}
                />

                <div className="flex-1 rounded-[18px] border border-white/10 bg-white/[0.04] px-3 py-2.5">
                  <div className="flex items-center justify-between gap-3">
                    <span className="text-[13px] font-semibold text-white">
                      {comment.authorName}
                    </span>

                    <span className="text-[10px] text-zinc-500">
                      {timeAgoFromDate(comment.createdAt)}
                    </span>
                  </div>

                  <p className="mt-1 text-[13px] leading-5 text-zinc-300">
                    {comment.content}
                  </p>

                  <button
                    onClick={() =>
                      setReplyingTo({
                        postId: post.id,
                        commentId: comment.id,
                      })
                    }
                    className="mt-2 text-[11px] font-medium text-zinc-500 hover:text-primary"
                  >
                    Reply
                  </button>
                </div>
              </div>

              {replyingTo?.postId === post.id &&
                replyingTo?.commentId === comment.id && (
                  <div className="ml-10 flex items-center gap-2">
                    <Input
                      value={replyText[comment.id] || ""}
                      placeholder={`Reply to ${comment.authorName}...`}
                      className="h-8 flex-1 rounded-full border-white/10 bg-white/[0.04] text-sm"
                      autoFocus
                      onChange={(e) =>
                        setReplyText((prev) => ({
                          ...prev,
                          [comment.id]: e.target.value.slice(0, 90),
                        }))
                      }
                      onKeyDown={(e) => {
                        if (e.key === "Enter" && !e.shiftKey) {
                          e.preventDefault()
                          submitReply(comment.id)
                        }

                        if (e.key === "Escape") {
                          setReplyingTo(null)
                        }
                      }}
                    />

                    <button
                      onClick={() => submitReply(comment.id)}
                      disabled={!replyText[comment.id]?.trim()}
                      className="flex h-8 w-8 items-center justify-center rounded-full border border-primary/25 bg-primary/10 text-primary disabled:opacity-40"
                    >
                      <Send className="h-3.5 w-3.5" />
                    </button>
                  </div>
                )}

              {comment.replies.length > 0 && (
                <div className="ml-10 space-y-2">
                  {comment.replies.map((reply) => (
                    <div key={reply.id} className="flex items-start gap-2">
                      <Avatar
                        src={reply.authorAvatar}
                        name={reply.authorName}
                        size={24}
                      />

                      <div className="flex-1 rounded-[16px] border border-white/8 bg-white/[0.03] px-3 py-2">
                        <div className="flex items-center justify-between gap-3">
                          <span className="text-[12px] font-semibold text-white">
                            {reply.authorName}
                          </span>

                          <span className="text-[9px] text-zinc-500">
                            {timeAgoFromDate(reply.createdAt)}
                          </span>
                        </div>

                        <p className="mt-1 text-[12px] leading-5 text-zinc-300">
                          {reply.content}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {post.comments.length >= 10 && (
        <p className="text-center text-[11px] text-zinc-500">
          Showing last 10 comments
        </p>
      )}
    </div>
  )
}
