function cn(...classes: Array<string | false | null | undefined>) {
  return classes.filter(Boolean).join(" ")
}
function safeImage(src?: string | null) {
  if (!src) return FALLBACK_IMAGE

  const normalized = src.trim()

  if (
    !normalized ||
    normalized === "/placeholder.svg" ||
    normalized.includes("placeholder.svg")
  ) {
    return FALLBACK_IMAGE
  }

  return normalized
}

function formatDateString(date: Date) {
  const y = date.getFullYear()
  const m = String(date.getMonth() + 1).padStart(2, "0")
  const d = String(date.getDate()).padStart(2, "0")

  return `${y}-${m}-${d}`
}

function parseDate(dateString?: string | null) {
  if (!dateString) return new Date()

  const date = new Date(`${dateString}T00:00:00`)

  if (Number.isNaN(date.getTime())) return new Date()

  return date
}

function formatTime12h(time?: string | null) {
  if (!time) return "Time TBA"

  const [rawHours, rawMinutes] = time.split(":").map(Number)

  if (Number.isNaN(rawHours)) return time

  const hours = rawHours
  const minutes = Number.isNaN(rawMinutes) ? 0 : rawMinutes
  const period = hours >= 12 ? "PM" : "AM"
  const displayHours = hours % 12 || 12

  return `${displayHours}:${minutes
    .toString()
    .padStart(2, "0")} ${period}`
}

function formatDateTitle(dateString: string) {
  return parseDate(dateString).toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
  })
}

function formatShortDate(dateString: string) {
  return parseDate(dateString).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  })
}

function formatTinyDate(dateString: string) {
  return parseDate(dateString).toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
  })
}

function getTodayString() {
  return formatDateString(new Date())
}

function getTomorrowString() {
  const tomorrow = new Date()
  tomorrow.setDate(tomorrow.getDate() + 1)

  return formatDateString(tomorrow)
}

function getWeekRangeFrom(dateString: string) {
  const base = parseDate(dateString)
  const end = new Date(base)

  end.setDate(base.getDate() + 6)

  return {
    start: formatDateString(base),
    end: formatDateString(end),
  }
}

function isDateWithinRange(
  dateString: string,
  startString: string,
  endString: string
) {
  const date = parseDate(dateString).getTime()
  const start = parseDate(startString).getTime()
  const end = parseDate(endString).getTime()

  return date >= start && date <= end
}

function getCategoryLabel(event: EventType) {
  if (event.category === "class") return "Class"
  if (event.category === "announcement") return "Announcement"

  return "Event"
}

function getVisibilityLabel(event: EventType) {
  if (event.visibility === "private" || event.isPublic === false) {
    return "Private"
  }

  return "Public"
}

function isEventFree(event: EventType) {
  return (
    event.isFree ||
    event.pricing === "free" ||
    event.price === 0
  )
}

function getEventTags(event: EventType) {
  return event.audienceTags ?? []
}

function isEventOffCampus(event: EventType) {
  return (
    event.isOffCampus ||
    event.activityTypes?.includes("off-campus") ||
    event.activityTypes?.includes("off campus") ||
    getEventTags(event).includes("off-campus") ||
    false
  )
}

function isEventWorkshop(event: EventType) {
  return (
    event.isWorkshop ||
    event.activityTypes?.includes("workshop") ||
    getEventTags(event).includes("workshop") ||
    event.category === "class" ||
    false
  )
}

function isEventDance(event: EventType) {
  return (
    event.isDance ||
    event.activityTypes?.includes("dance") ||
    getEventTags(event).includes("dance") ||
    false
  )
}
function getEventTimestamp(event: EventType) {
  return new Date(`${event.date}T${event.time || "00:00"}`).getTime()
}

function isFutureEvent(event: EventType) {
  return getEventTimestamp(event) >= Date.now() - 60 * 1000
}

function getEventMediaType(event: EventType) {
  const mediaType = event.mediaType?.toLowerCase()
  const mediaUrl = event.mediaUrl || event.image || ""

  if (mediaType === "video") return "video"
  if (mediaUrl.match(/\.(mp4|mov|webm|m4v)$/i)) return "video"

  return "image"
}

function getEventImage(event: EventType) {
  if (event.mediaThumbnail) return safeImage(event.mediaThumbnail)

  if (event.mediaUrl && getEventMediaType(event) === "image") {
    return safeImage(event.mediaUrl)
  }

  if (event.image) return safeImage(event.image)

  const galleryImage = event.mediaGallery?.find((item) => {
    if (typeof item === "string") return true

    const itemType = item.type?.toLowerCase()
    return itemType === "image" || !itemType
  })

  if (typeof galleryImage === "string") return safeImage(galleryImage)

  return safeImage(galleryImage?.url)
}

function getEventHost(event: EventType) {
  const host: any = event.host
  const postedBy: any = event.postedBy

  return (
    host?.name ||
    host?.displayName ||
    event.hostName ||
    event.organizer ||
    event.creatorName ||
    postedBy?.name ||
    event.postedByName ||
    "Sin Vergüenza"
  )
}

function getEventLocationLabel(event: EventType) {
  if (event.locationType === "online" || event.onlineLink) return "Online"
  if (event.location) return event.location

  return "Location TBA"
}

function getEventPriceLabel(event: EventType) {
  if (isEventFree(event)) return "Free"

  if (typeof event.price === "number" && event.price > 0) {
    return `$${event.price}`
  }

  return "Paid"
}

function getCardToneTags(event: EventType) {
  const tags: { label: string; tone: BadgeTone }[] = [
    { label: getCategoryLabel(event), tone: "gold" },
    {
      label: getVisibilityLabel(event),
      tone: getVisibilityLabel(event) === "Public" ? "emerald" : "orange",
    },
    {
      label: getEventPriceLabel(event),
      tone: isEventFree(event) ? "emerald" : "orange",
    },
  ]

  if (event.locationType === "online" || event.onlineLink) {
    tags.push({ label: "Online", tone: "cyan" })
  }

  if (isEventWorkshop(event)) {
    tags.push({
      label: event.category === "class" ? "Class" : "Workshop",
      tone: "purple",
    })
  }

  if (isEventDance(event)) {
    tags.push({ label: "Dance", tone: "pink" })
  }

  if (event.isPinned) {
    tags.push({ label: "Pinned", tone: "gold" })
  }

  return tags
}

