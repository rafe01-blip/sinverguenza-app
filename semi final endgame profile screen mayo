"use client"

import { useMemo, useState, type ReactNode } from "react"
import {
  Settings,
  Share2,
  Instagram,
  BadgeCheck,
  Facebook,
  MessageCircle,
  Globe,
  Music2,
} from "lucide-react"
import { TopHeader } from "@/components/navigation/top-header"
import { BottomNav } from "@/components/navigation/bottom-nav"
import { useApp } from "@/lib/app-context"

const GOLD = "#C9A84C"
const DARK = "#0A0A0A"
const CARD = "#121212"

type ProfileTab = "posts" | "events" | "saved"

function compact(n: number) {
  if (n >= 1000000) return `${(n / 1000000).toFixed(1)}M`
  if (n >= 1000) return `${(n / 1000).toFixed(1)}K`
  return `${n}`
}

export function ProfileScreen() {
  const {
    user,
    creators,
    communityPosts,
    events,
    setCurrentScreen,
  } = useApp()

  const [activeTab, setActiveTab] = useState<ProfileTab>("posts")
  const [showSocials, setShowSocials] = useState(false)

  const myCreator = useMemo(() => {
    if (!user) return null

    const exact = creators.find((creator) => creator.id === user.id)
    if (exact) return exact

    const byUsername =
      user.username
        ? creators.find((creator) => creator.username === user.username)
        : null

    if (byUsername) return byUsername

    return null
  }, [creators, user])

  const myPosts = useMemo(() => {
    if (!user) return []
    return communityPosts.filter((post) => post.authorId === user.id)
  }, [communityPosts, user])

  const savedEvents = useMemo(() => {
    return events.filter((event) => event.isSaved)
  }, [events])

  const likedEvents = useMemo(() => {
    return events.filter((event) => event.isLiked)
  }, [events])

  const myEvents = useMemo(() => {
    if (!user) return []
    return events.filter(
      (event) =>
        event.organizerCreatorId === user.id ||
        event.hostUsername === user.username
    )
  }, [events, user])

  const followerCount =
    myCreator?.followersCount ??
    myCreator?.followers ??
    120

  const followingCount =
    myCreator?.followingCount ??
    myCreator?.following ??
    80

  const postsCount =
    myCreator?.postsCount ??
    myCreator?.posts ??
    myPosts.length

  const eventsCount =
    myCreator?.eventsCount ??
    myCreator?.events ??
    myEvents.length

  const profileName = user?.name || "Mario Rosario"
  const profileUsername = user?.username || "mariorafaelrosario"
  const profileBio = user?.bio || "Passion for dance and community ✨"
  const profileAvatar = user?.avatar || "/placeholder.svg"
  const profileCover = user?.coverImage || "/placeholder.svg"
  const profileRole = user?.role || "Member"
  const socials = user?.socials || {}

  const socialItems = [
    socials.instagram
      ? {
          key: "instagram",
          label: "Instagram",
          icon: <Instagram size={18} />,
          url: socials.instagram,
        }
      : null,
    socials.facebook
      ? {
          key: "facebook",
          label: "Facebook",
          icon: <Facebook size={18} />,
          url: socials.facebook,
        }
      : null,
    socials.tiktok
      ? {
          key: "tiktok",
          label: "TikTok",
          icon: <Music2 size={18} />,
          url: socials.tiktok,
        }
      : null,
    socials.whatsapp
      ? {
          key: "whatsapp",
          label: "WhatsApp",
          icon: <MessageCircle size={18} />,
          url: socials.whatsapp,
        }
      : null,
    socials.website
      ? {
          key: "website",
          label: "Website",
          icon: <Globe size={18} />,
          url: socials.website,
        }
      : null,
    socials.x
      ? {
          key: "x",
          label: "X",
          icon: <span style={{ fontWeight: 900 }}>X</span>,
          url: socials.x,
        }
      : null,
  ].filter(Boolean) as {
    key: string
    label: string
    icon: ReactNode
    url: string
  }[]

  return (
    <div
      style={{
        minHeight: "100vh",
        background: DARK,
        color: "#fff",
        paddingBottom: 96,
      }}
    >
      <TopHeader title="Profile" />

      <div style={{ position: "relative" }}>
        <div style={coverWrap}>
          <img
            src={profileCover}
            alt="Cover"
            style={coverImg}
          />
          <div style={coverOverlay} />
        </div>

        <button
          onClick={() => setCurrentScreen("settings")}
          style={settingsBtn}
        >
          <Settings size={20} />
        </button>

        <div style={profileImgWrap}>
          <img
            src={profileAvatar}
            alt="Profile"
            style={profileImg}
          />
        </div>
      </div>

      <div style={{ padding: "74px 16px 16px", textAlign: "center" }}>
        <div style={nameRow}>
          <div style={{ fontSize: 24, fontWeight: 900 }}>
            {profileName}
          </div>

          <BadgeCheck size={18} color={GOLD} />
        </div>

        <div style={{ color: "#aaa", marginBottom: 8 }}>
          @{profileUsername}
        </div>

        <div style={rolePill}>
          {profileRole}
        </div>

        <div style={bioText}>
          {profileBio}
        </div>
      </div>

      <div style={statsRow}>
        <button style={statBox}>
          <div style={statNumber}>{compact(followerCount)}</div>
          <div style={statLabel}>Followers</div>
        </button>

        <button style={statBox}>
          <div style={statNumber}>{compact(followingCount)}</div>
          <div style={statLabel}>Following</div>
        </button>

        <button style={statBox}>
          <div style={statNumber}>{compact(postsCount)}</div>
          <div style={statLabel}>Posts</div>
        </button>

        <button style={statBox}>
          <div style={statNumber}>{compact(eventsCount)}</div>
          <div style={statLabel}>Events</div>
        </button>
      </div>

      <div style={actionsRow}>
        <button
          onClick={() => setCurrentScreen("settings")}
          style={primaryActionBtn}
        >
          Edit
        </button>

        <button
          onClick={() => setShowSocials(true)}
          style={secondaryActionBtn}
        >
          Socials
        </button>

        <button style={iconActionBtn}>
          <Share2 size={16} />
        </button>
      </div>

      <div style={sectionCard}>
        <div style={sectionTitle}>My World</div>

        <div style={activityGrid}>
          <div style={activityBox}>
            <div style={activityNumber}>{myEvents.length || 14}</div>
            <div style={activityLabel}>Events attended</div>
          </div>

          <div style={activityBox}>
            <div style={activityNumber}>{savedEvents.length || 6}</div>
            <div style={activityLabel}>Saved items</div>
          </div>

          <div style={activityBox}>
            <div style={activityNumber}>{myPosts.length || 8}</div>
            <div style={activityLabel}>Posts created</div>
          </div>

          <div style={activityBox}>
            <div style={activityNumber}>{likedEvents.length || 10}</div>
            <div style={activityLabel}>Liked events</div>
          </div>
        </div>
      </div>

      <div style={sectionCard}>
        <div style={sectionTitle}>Bridge</div>

        <div style={bridgeText}>
          Your profile connects your activity inside the app with your real social presence outside the app.
        </div>

        <div style={bridgeMiniRow}>
          <div style={bridgeMiniPill}>
            community
          </div>
          <div style={bridgeMiniPill}>
            creators
          </div>
          <div style={bridgeMiniPill}>
            events
          </div>
          <div style={bridgeMiniPill}>
            socials
          </div>
        </div>
      </div>

      <div style={tabsRow}>
        {["posts", "events", "saved"].map((tab) => (
          <button
            key={tab}
            onClick={() => setActiveTab(tab as ProfileTab)}
            style={activeTab === tab ? tabActive : tabBtn}
          >
            {tab}
          </button>
        ))}
      </div>

      {activeTab === "posts" && (
        <div style={postsWrap}>
          {myPosts.length === 0 ? (
            <div style={emptyWrap}>
              <div style={emptyTitle}>No posts yet</div>
              <div style={emptyText}>
                Your community posts will appear here.
              </div>
            </div>
          ) : (
            <div style={grid}>
              {myPosts.slice(0, 9).map((post) => (
                <div key={post.id} style={gridItem}>
                  {post.image ? (
                    <img
                      src={post.image}
                      alt="Post"
                      style={gridImage}
                    />
                  ) : (
                    <div style={gridFallbackText}>
                      {post.content.slice(0, 42)}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {activeTab === "events" && (
        <div style={{ padding: 16 }}>
          {myEvents.length === 0 ? (
            <div style={emptyWrap}>
              <div style={emptyTitle}>No events yet</div>
              <div style={emptyText}>
                Events linked to your profile will show here.
              </div>
            </div>
          ) : (
            myEvents.map((event) => (
              <div key={event.id} style={card}>
                <div style={{ fontWeight: 900, marginBottom: 4 }}>
                  {event.title}
                </div>

                <div style={{ color: "#aaa", fontSize: 13 }}>
                  {event.date} • {event.time}
                </div>
              </div>
            ))
          )}
        </div>
      )}

      {activeTab === "saved" && (
        <div style={{ padding: 16 }}>
          {savedEvents.length === 0 ? (
            <div style={emptyWrap}>
              <div style={emptyTitle}>No saved items yet</div>
              <div style={emptyText}>
                Saved events and selected items will appear here.
              </div>
            </div>
          ) : (
            savedEvents.map((event) => (
              <div key={event.id} style={card}>
                <div style={{ fontWeight: 900, marginBottom: 4 }}>
                  {event.title}
                </div>

                <div style={{ color: "#aaa", fontSize: 13 }}>
                  {event.date} • {event.time}
                </div>
              </div>
            ))
          )}
        </div>
      )}

      {showSocials && (
        <div style={modalOverlay} onClick={() => setShowSocials(false)}>
          <div style={socialsModal} onClick={(e) => e.stopPropagation()}>
            <div style={socialsModalHeader}>
              <div style={socialsModalTitle}>Socials</div>

              <button
                onClick={() => setShowSocials(false)}
                style={closeBtn}
              >
                ✕
              </button>
            </div>

            {socialItems.length === 0 ? (
              <div style={emptyWrapSmall}>
                <div style={emptyTitleSmall}>No socials connected</div>
                <div style={emptyTextSmall}>
                  Add your social links in Settings.
                </div>
              </div>
            ) : (
              <div style={socialsGrid}>
                {socialItems.map((item) => (
                  <button
                    key={item.key}
                    onClick={() => window.open(item.url, "_blank")}
                    style={socialIconBtn}
                  >
                    <div style={socialIconCircle}>{item.icon}</div>
                    <div style={socialIconLabel}>{item.label}</div>
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      <BottomNav />
    </div>
  )
}

