========================================================= */

interface StoredAppState {
  version: number

  user?: UserType | null

  events?: EventType[]
  creators?: Creator[]
  communityPosts?: CommunityPost[]
  communityStories?: CommunityStory[]
  spaces?: SpaceType[]
  products?: ProductType[]
  cartItems?: CartItem[]
  orders?: OrderType[]
  notifications?: NotificationItem[]
}

function canUseLocalStorage() {
  return typeof window !== "undefined" && !!window.localStorage
}

function safelyParseStoredState(
  raw: string | null
): StoredAppState | null {
  if (!raw) return null

  try {
    const parsed = JSON.parse(raw) as StoredAppState

    if (!parsed || parsed.version !== STORAGE_VERSION) {
      return null
    }

    return parsed
  } catch {
    return null
  }
}

function loadStoredAppState(): StoredAppState | null {
  if (!canUseLocalStorage()) return null

  const state = safelyParseStoredState(
    window.localStorage.getItem(STORAGE_KEY)
  )

  if (!state) return null

  // limpiar Prototype legacy
  if (
    state.user?.name?.toLowerCase() === "prototype" ||
    state.user?.username?.toLowerCase() === "prototype"
  ) {
    state.user = undefined
  }

  return state
}

function saveStoredAppState(state: StoredAppState) {
  if (!canUseLocalStorage()) return

  try {
    window.localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify({
        ...state,
        version: STORAGE_VERSION,
      })
    )
  } catch {
    // nunca romper app por storage
  }
}
