function normalizeText(value?: string) {
  return (value || "").trim().toLowerCase()
}

function toggleValue(list: string[], value: string) {
  return list.includes(value)
    ? list.filter((item) => item !== value)
    : [...list, value]
}

function inferCategory(product: ProductType): ShopCategory {
  const raw = normalizeText(product.category)
  const name = normalizeText(product.name)

  if (raw.includes("women") || raw === "female") return "womens"
  if (raw.includes("men") || raw === "male") return "mens"

  if (
    raw.includes("top") ||
    raw.includes("hoodie") ||
    raw.includes("tee") ||
    name.includes("hoodie") ||
    name.includes("tee") ||
    name.includes("shirt")
  ) {
    return "tops"
  }

  if (raw.includes("auto") || name.includes("car")) return "auto"

  if (
    raw.includes("accessor") ||
    name.includes("cap") ||
    name.includes("hat") ||
    name.includes("bag")
  ) {
    return "accessories"
  }

  return "accessories"
}

function normalizeColorOptions(product: ProductType): ShopColorOption[] {
  const extended = product as ShopProductInput

  if (extended.colorOptions && extended.colorOptions.length > 0) {
    return extended.colorOptions.map((option, index) => {
      const optionImages = uniqueImages([
        option.image,
        option.heroImage,
        option.featuredImage,
        option.hoverImage,
        ...(option.images || []),
        ...(option.lifestyleImages || []),
      ])

      const fallbackImages = uniqueImages([
        product.image,
        product.heroImage,
        product.featuredImage,
        product.hoverImage,
        ...(product.images || []),
        ...(product.lifestyleImages || []),
      ])

      const safeImages =
        optionImages.length > 0
          ? optionImages
          : fallbackImages.length > 0
          ? fallbackImages
          : ["/placeholder.svg"]

      return {
        ...option,
        id: option.id || `${product.id}-color-${index + 1}`,
        label: option.label || option.name,
        image: option.image || safeImages[0],
        images: safeImages,
        lifestyleImages: option.lifestyleImages || [],
        heroImage: option.heroImage || option.image || safeImages[0],
        featuredImage: option.featuredImage || option.image || safeImages[0],
        hoverImage: option.hoverImage || safeImages[1] || safeImages[0],
        isDefault: option.isDefault ?? index === 0,
      }
    })
  }
  const fallbackImages = uniqueImages([
    product.image,
    product.heroImage,
    product.featuredImage,
    product.hoverImage,
    ...(product.images || []),
    ...(product.lifestyleImages || []),
  ])

  const safeImages =
    fallbackImages.length > 0 ? fallbackImages : ["/placeholder.svg"]

  const colors =
    product.colors && product.colors.length > 0 ? product.colors : ["Black/Gold"]

  return colors.map((color, index) => ({
    id: `${product.id}-color-${index + 1}`,
    name: color,
    label: color,
    swatch:
      normalizeText(color).includes("white") ||
      normalizeText(color).includes("cream")
        ? "#F3F3F3"
        : normalizeText(color).includes("burgundy")
        ? "#6E1F2A"
        : normalizeText(color).includes("olive")
        ? "#4A5A3A"
        : "#111111",
    image: safeImages[0],
    images: safeImages,
    lifestyleImages: product.lifestyleImages || [],
    heroImage: product.heroImage || safeImages[0],
    featuredImage: product.featuredImage || safeImages[0],
    hoverImage: product.hoverImage || safeImages[1] || safeImages[0],
    isDefault: index === 0,
  }))
}

function enrichProduct(product: ProductType, index: number): EnhancedProduct {
  const extended = product as ShopProductInput
  const category = inferCategory(product)
  const stock = typeof product.stock === "number" ? product.stock : 12

  const availability: EnhancedProduct["availability"] =
    stock <= 0 ? "out-of-stock" : stock <= 8 ? "low-stock" : "in-stock"

  const colorOptions = normalizeColorOptions(product)
  const defaultColor =
    colorOptions.find((option) => option.isDefault) || colorOptions[0]

    const safeImages =
    product.images && product.images.length > 0
      ? product.images
      : defaultColor?.images && defaultColor.images.length > 0
      ? defaultColor.images
      : uniqueImages([
          product.image,
          extended.heroImage,
          extended.featuredImage,
          extended.hoverImage,
          defaultColor?.image,
          defaultColor?.heroImage,
        ])

  const finalImages = safeImages.length > 0 ? safeImages : ["/placeholder.svg"]
  return {
    ...product,
    image: product.image || defaultColor?.image || finalImages[0],
    images: finalImages,
    category,
    stock,
    availability,
    colorOptions,
    lifestyleImages: uniqueImages([
      ...(defaultColor?.lifestyleImages || []),
      ...(product.lifestyleImages || []),
    ]),
        heroImage: extended.heroImage || finalImages[0],
    featuredImage: extended.featuredImage || finalImages[0],
    hoverImage: extended.hoverImage || finalImages[1] || finalImages[0],
    shortDescription:
      product.shortDescription ||
      product.description?.slice(0, 90) ||
      "Premium Sin Vergüenza piece with elevated black-and-gold identity.",
    compareAtPrice:
      product.compareAtPrice ??
      (product.price >= 50 ? Number((product.price * 1.18).toFixed(0)) : undefined),
    material: product.material || "Premium signature finish",
    fit: product.fit || "True to size",
    care: product.care || "Machine wash cold",
    shippingNote: product.shippingNote || "Ships in 2–4 business days",
    featured:
      product.featured ??
      product.isBestSeller ??
      product.isNew ??
      index < 3,
    isBestSeller: product.isBestSeller ?? product.badge === "Best Seller",
    isNew: product.isNew ?? product.badge === "New",
    isLimited: product.isLimited ?? product.badge === "Limited",
    sortOrder: product.sortOrder ?? index + 1,
    gender:
      category === "mens"
        ? "male"
        : category === "womens"
        ? "female"
        : "unisex",
  }
}

function getBadgeLabel(product: EnhancedProduct) {
  if (product.badge) return product.badge
  if (product.isBestSeller) return "Best Seller"
  if (product.isNew) return "New"
  if (product.isLimited) return "Limited"
  return ""
}

function getAvailabilityLabel(product: EnhancedProduct) {
  if (product.availability === "out-of-stock") return "Out of Stock"
  if (product.availability === "low-stock") return "Low Stock"
  return "In Stock"
}

function getProductCardImage(product: EnhancedProduct) {
  return (
    product.image ||
    product.featuredImage ||
    product.images?.[0] ||
    product.hoverImage ||
    "/placeholder.svg"
  )
}

function getProductFeaturedImage(product: EnhancedProduct) {
  return (
    product.featuredImage ||
    product.image ||
    product.images?.[0] ||
    "/placeholder.svg"
  )
}
function getSwatchBorder(swatch?: string) {
  const value = normalizeText(swatch)

  if (
    value === "#ffffff" ||
    value === "#fff" ||
    value === "#f5f5f5" ||
    value === "#f3f3f3" ||
    value === "#ededed" ||
    value === "#e7e0d4"
  ) {
    return "1px solid rgba(255,255,255,0.18)"
  }

  return "1px solid rgba(255,255,255,0.08)"
}

