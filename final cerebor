  const addToCart = ({
    product,
    size,
    color,
    quantity,
    model,
  }: {
    product: ProductType
    size: string
    color: string
    quantity: number
    model?: string
  }) => {
    const normalizedProduct = normalizeProduct(product, product.sortOrder ?? 0)

    const productImage =
      normalizedProduct.featuredImage ||
      normalizedProduct.image ||
      normalizedProduct.images?.[0] ||
      DEFAULT_ASSET

    setCartItems((prev) => {
      const existing = prev.find(
        (item) =>
          item.productId === normalizedProduct.id &&
          item.size === size &&
          item.color === color &&
          item.model === model
      )

      if (existing) {
        return prev.map((item) =>
          item.id === existing.id
            ? {
                ...item,
                quantity: item.quantity + Math.max(1, quantity),
                subtotal:
                  item.price * (item.quantity + Math.max(1, quantity)),
              }
            : item
        )
      }

      return [
        ...prev,
        {
          id: `cart-${Date.now()}`,
          productId: normalizedProduct.id,
          productName: normalizedProduct.name,
          productImage,
          size,
          color,
          model,
          quantity: Math.max(1, quantity),
          price: normalizedProduct.price,
          subtotal: normalizedProduct.price * Math.max(1, quantity),
        },
      ]
    })

    showToast("Added to cart", "success")
  }

  const removeFromCart = (id: string) => {
    setCartItems((prev) => prev.filter((item) => item.id !== id))
  }

  const updateCartQuantity = (id: string, qty: number) => {
    if (qty <= 0) {
      removeFromCart(id)
      return
    }

    setCartItems((prev) =>
      prev.map((item) =>
        item.id === id
          ? {
              ...item,
              quantity: qty,
              subtotal: item.price * qty,
            }
          : item
      )
    )
  }

  const clearCart = () => {
    setCartItems([])
  }

  const cartSubtotal = useMemo(
    () =>
      cartItems.reduce(
        (sum, item) => sum + item.price * item.quantity,
        0
      ),
    [cartItems]
  )

  const cartShipping = cartItems.length > 0 && cartSubtotal < 75 ? 8 : 0
  const cartTotal = cartSubtotal + cartShipping

  const getOrderById = (orderId: string) => {
    return orders.find((order) => order.id === orderId) || null
  }

  const createOrder = (args: CreateOrderInput) => {
    if (cartItems.length === 0) return null

    const createdAt = new Date().toISOString()
    const orderId = `order-${Date.now()}`

    const orderItems: OrderItem[] = cartItems.map((item) => ({
      productId: item.productId,
      name: item.productName,
      image: item.productImage,
      size: item.size,
      color: item.color,
      model: item.model,
      quantity: item.quantity,
      price: item.price,
    }))

    const newOrder = normalizeOrder({
      id: orderId,
      orderNumber: `SV-${String(Date.now()).slice(-6)}`,
      items: orderItems,
      subtotal: cartSubtotal,
      shipping: cartShipping,
      tax: 0,
      discount: 0,
      total: cartTotal,
      status: "processing",
      createdAt,
      updatedAt: createdAt,
      trackingSteps: buildOrderTrackingSteps("processing"),
      customerName: args.customerName,
      customerEmail: args.customerEmail,
      deliveryInfo: args.deliveryInfo,
      paymentMethod: args.paymentMethod,
    })

    setOrders((prev) => [newOrder, ...prev.map(normalizeOrder)])
    setSelectedOrderState(newOrder)
    setCartItems([])

    createOrderNotification(newOrder)
    showToast("Order confirmed", "success")

    navigateTo({
      screen: "order-tracking",
      orderId,
    })

    return newOrder
  }

  const updateOrderStatus = (orderId: string, status: OrderStatus) => {
    setOrders((prev) =>
      prev.map((order) =>
        order.id === orderId
          ? normalizeOrder({
              ...order,
              status,
              updatedAt: new Date().toISOString(),
              trackingSteps: buildOrderTrackingSteps(status),
            })
          : normalizeOrder(order)
      )
    )
  }

  const openOrderTracking = (orderId: string) => {
    const order = getOrderById(orderId)
    if (!order) return

    setSelectedOrderState(order)

    navigateTo({
      screen: "order-tracking",
      orderId,
    })
  }

  const getOrdersSorted = () => {
    return orders
      .map(normalizeOrder)
      .sort(
        (a, b) =>
          new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
      )
  }

  /* =========================
     NOTIFICATIONS
  ========================= */

  const createNotification = (
    notification: Omit<NotificationItem, "id" | "createdAt" | "isRead">
  ) => {
    if (notification.actorId && notification.actorId === user?.id) return
    if (notification.actorId && isBlockedByUser(user, notification.actorId)) return

    const newNotification: NotificationItem = {
      id: `notification-${Date.now()}`,
      createdAt: new Date().toISOString(),
      isRead: false,
      priority: notification.priority || "medium",
      ...notification,
    }

    setNotifications((prev) => [newNotification, ...prev].slice(0, 80))
  }

  const createOrderNotification = (order: OrderType) => {
    createNotification({
      type: "orders",
      source: "orders",
      title: "Order confirmed",
      message: "Your order has been placed successfully.",
      targetType: "order-tracking",
      targetId: order.id,
      image: order.items[0]?.image,
      priority: "high",
      metadata: {
        orderStatus: order.status,
      },
    })
  }

  const createEventNotification = (
    event: EventType,
    title: string,
    message: string
  ) => {
    if (isEventBlockedOrRestrictedLocal(event)) return

    createNotification({
      type: "events",
      source: "events",
      title,
      message,
      targetType: "event",
      targetId: event.id,
      image: event.image,
      priority: "high",
    })
  }

  const createSocialNotification = (
    actorId: string,
    targetType: NotificationTargetType,
    targetId: string,
    title: string,
    message: string
  ) => {
    createNotification({
      type: "community",
      source: "community",
      actorId,
      targetType,
      targetId,
      title,
      message,
      priority: "medium",
    })
  }

  const createSpaceNotification = (
    spaceKey: SpaceKey,
    title: string,
    message: string
  ) => {
    createNotification({
      type: "spaces",
      source: "spaces",
      title,
      message,
      targetType: "space",
      targetId: String(spaceKey),
      priority: "medium",
    })
  }

  const getVisibleNotifications = () => {
    return notifications
      .filter((notification) => {
        if (notification.actorId && isBlockedByUser(user, notification.actorId)) {
          return false
        }

        if (notification.expiresAt && isExpired(notification.expiresAt)) {
          return false
        }

        return true
      })
      .sort(
        (a, b) =>
          new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
      )
  }

  const markNotificationRead = (notificationId: string) => {
    setNotifications((prev) =>
      prev.map((notification) =>
        notification.id === notificationId
          ? { ...notification, isRead: true }
          : notification
      )
    )
  }

  const markAllNotificationsRead = () => {
    setNotifications((prev) =>
      prev.map((notification) => ({ ...notification, isRead: true }))
    )
  }

  const openNotificationTarget = (notification: NotificationItem) => {
    setSelectedNotification(notification)
    markNotificationRead(notification.id)

    if (notification.targetType === "event" && notification.targetId) {
      openEventDetail(notification.targetId, "notifications")
      return
    }

    if (notification.targetType === "space" && notification.targetId) {
      openSpace(notification.targetId as SpaceKey)
      return
    }

    if (notification.targetType === "creator" && notification.targetId) {
      openCreatorProfile(notification.targetId)
      return
    }

    if (notification.targetType === "story" && notification.targetId) {
      openStory(notification.targetId, "community")
      return
    }

    if (notification.targetType === "product" && notification.targetId) {
      openProductDetail(notification.targetId)
      return
    }

    if (
      notification.targetType === "community-post" ||
      notification.targetType === "post" ||
      notification.targetType === "event-thread"
    ) {
      navigateTo({
        screen: "community",
      })
      return
    }

    if (
      (notification.targetType === "order" ||
        notification.targetType === "order-tracking") &&
      notification.targetId
    ) {
      openOrderTracking(notification.targetId)
      return
    }

    navigateTo({
      screen: "notifications",
    })
  }

  /* =========================
     SHARE / CLEANUP
  ========================= */

  const getSharePayload = (type: ShareItemType, id: string) => {
    if (type === "event") {
      const event = getEventById(id)
      if (!event) return null

      return {
        type,
        id,
        title: event.title,
        text: `${event.title} — ${formatEventDate(event.date)} at ${formatTime(
          event.time
        )}. ${event.location || ""}`,
      }
    }

    if (type === "creator" || type === "profile") {
      const creator =
        type === "profile" ? buildMeCreator(user || INITIAL_USER) : getCreatorById(id)

      if (!creator) return null

      return {
        type,
        id,
        title: creator.name,
        text: `${creator.name} on Sin Vergüenza @${creator.username}`,
        url: getPrimarySocialLink(creator),
      }
    }

    if (type === "product") {
      const product = getProductById(id)
      if (!product) return null

      return {
        type,
        id,
        title: product.name,
        text: `${product.name} — $${product.price}`,
      }
    }

    if (type === "space") {
      const space = getSpaceByKey(id)
      if (!space) return null

      return {
        type,
        id,
        title: space.label,
        text: `${space.emoji} ${space.label}: ${space.description}`,
      }
    }

    return null
  }

  const shareItem = (type: ShareItemType, id: string) => {
    const payload = getSharePayload(type, id)
    if (payload) showToast("Link copied", "success")
    return payload
  }

  const cleanupAppState = () => {
    setEvents((prev) => cleanupEvents(prev))
    setCommunityStories((prev) =>
      prev.map(normalizeStory).filter((story) => !isStoryExpired(story))
    )
    setSpacePosts((prev) =>
      prev.map(normalizeSpacePost).filter((post) => !isExpired(post.expiresAt))
    )
    setNotifications((prev) =>
      prev.filter((notification) => !notification.expiresAt || !isExpired(notification.expiresAt))
    )
  }

  const resetAppState = () => {
    if (canUseLocalStorage()) {
      window.localStorage.removeItem(STORAGE_KEY)
    }

    setUserState(INITIAL_USER)
    setEvents(INITIAL_EVENTS)
    setCreatorsState(INITIAL_CREATORS)
    setCommunityPosts(INITIAL_COMMUNITY_POSTS)
    setCommunityStories(INITIAL_COMMUNITY_STORIES)
    setSpaces(INITIAL_SPACES)
    setSpacePosts(INITIAL_SPACE_POSTS)
    setProductsState(INITIAL_PRODUCTS)
    setCartItems([])
    setOrders([])
    setNotifications(INITIAL_NOTIFICATIONS)
    resetNavigation("home")
  }

  return (
    <AppContext.Provider
      value={{
        currentScreen,
        setCurrentScreen,
        navigateTo,
        goBack,
        navigationStack,
        resetNavigation,
        navigateMainTab,

        appEventTags: APP_EVENT_TAGS,
        filterTags: FILTER_TAGS,

        user,
        setUser,
        updateMyProfile,
        updateMySocials,
        getPrimarySocialLink,
        getUserActivity,
        getMyPosts,
        getMyEvents,
        getMyStories,
        getMySpaces,
        getUserCreatedEvents,
        getUserHostedEvents,
        getUserSavedEvents,
        getUserLikedEvents,
        getUserGoingEvents,
        getUserPosts,
        getUserStories,
        getUserSpaces,

        blockUser,
        unblockUser,
        isUserBlocked,
        restrictTag,
        unrestrictTag,
        isTagRestricted,
        eventMatchesUserPreferences,
        isEventBlockedOrRestricted: isEventBlockedOrRestrictedLocal,

        homeSelectedDate,
        setHomeSelectedDate,

        events,
        selectedEvent,
        setSelectedEvent,
        lastEventSource,
        setLastEventSource,
        createEvent,
        updateEvent,
        toggleLike,
        toggleSave,
        togglePinEvent,
        setAttendanceStatus,
        rateEvent,
        getEventById,
        getVisibleEvents,
        getHomeEvents,
        getCalendarEvents,
        getProfileEvents,
        getPinnedEvents,
        getSavedEvents,
        getGoingEvents,
        getEventCardData,
        isPastEvent,
        isEventLive,
        isEventRecentlyEnded,
        getEventLifecycleStatus,
        shouldShowEventInHome,
        shouldShowEventInCalendar,
        shouldKeepEventInProfile,

        addComment,
        addReplyToComment,

        openEventDetail,
        openPinnedCalendarFocus,
        openCalendarExpandFromHome,
        openEventInCalendar,

        calendarSearchOpen,
        setCalendarSearchOpen,
        calendarSearchQuery,
        setCalendarSearchQuery,
        selectedDate,
        setSelectedDate,
        currentMonth,
        setCurrentMonth,
        calendarFilters,
        setCalendarFilters,
        calendarViewMode,
        setCalendarViewMode,
        calendarEntrySource,
        setCalendarEntrySource,
        calendarHighlightedEventId,
        setCalendarHighlightedEventId,

        products,
        setProducts,
        selectedProduct,
        setSelectedProduct,
        toggleProductFavorite,
        getProductById,
        getRecommendedProducts,
        getCartRecommendations,
        openProductDetail,

        cartItems,
        addToCart,
        removeFromCart,
        updateCartQuantity,
        clearCart,
        cartSubtotal,
        cartShipping,
        cartTotal,

        orders,
        selectedOrder,
        setSelectedOrder,
        createOrder,
        updateOrderStatus,
        buildOrderTrackingSteps,
        openOrderTracking,
        getOrdersSorted,
        getOrderById,

        creators,
        setCreators,
        selectedCreator,
        setSelectedCreator,
        openCreatorProfile,
        toggleFollow,
        creatorListType,
        creatorListTitle,
        creatorListSourceCreatorId,
        creatorListSourceSpaceKey,
        creatorListSourceEventId,
        openCreatorList,
        getCreatorById,
        getVisibleCreators,
        getFollowingCreators,
        getPrioritizedCreators,
        getTopCreators,
        getCreatorFollowers,
        getCreatorFollowing,
        getCreatorEvents,
        getSpaceMembers,
        getEventHosts,
        searchCreators,

        communityPosts,
        communityStories,
        createCommunityPost,
        toggleCommunityLike,
        addCommunityComment,
        addCommunityReply,
        voteOnPoll,
        getPostById,
        getVisibleCommunityPosts,
        getVisibleComments,

        getStoriesForSource,
        markStorySeen,
        toggleStoryLike,
        addStoryReply,
        setStoryReaction,
        selectedStoryId,
        setSelectedStoryId,
        storySource,
        openStory,
        getStoryById,
        getVisibleStories,

        spaces,
        activeSpace,
        setActiveSpace,
        openSpace,
        openCreateSpace,
        toggleJoinSpace,
        requestJoinSpace,
        createSpace,
        getSpaceLimitInfo,
        spacePosts,
        getSpacePosts,
        getVisibleSpacePosts,
        createSpacePost,
        createSpaceReply,
        toggleSpacePostLike,
        getActiveSpaces,
        getSpaceFreshness,
        getSpaceActivityBadge,
        getTopSpacePost,
        getSpaceByKey,
        getSpaceForEvent,
        eventHasSpace,

        notifications,
        selectedNotification,
        setSelectedNotification,
        createNotification,
        createOrderNotification,
        createEventNotification,
        createSocialNotification,
        createSpaceNotification,
        markNotificationRead,
        markAllNotificationsRead,
        getVisibleNotifications,
        openNotificationTarget,

        safeImage,
        getInitialsFallback,
        uniqueImages,
        uniqueMedia,
        normalizeMediaList,
        getPrimaryMediaUrl,
        getMediaGallery,
        isVideoMedia,
        isAudioMedia,

        formatTime,
        formatEventDate,
        formatRelativeTime,
        getEventDateTime,

        getSharePayload,
        shareItem,

        toasts,
        showToast,
        dismissToast,

        resetAppState,
        cleanupAppState,
      }}
    >
      {children}
    </AppContext.Provider>
  )
}

/* =========================
   HOOK
========================= */

export const useApp = () => {
  const context = useContext(AppContext)

  if (!context) {
    throw new Error("useApp must be used inside AppProvider")
  }

  return context
}
