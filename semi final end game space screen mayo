type SpacePostFilter = "all" | "recent" | "popular"

const GOLD = "#C9A84C"
const DARK = "#0A0A0A"
const CARD = "#121212"

function timeAgoFromDate(dateString: string) {
  const now = Date.now()
  const then = new Date(dateString).getTime()
  const diff = Math.max(1, now - then)

  const minutes = Math.floor(diff / (1000 * 60))
  const hours = Math.floor(diff / (1000 * 60 * 60))
  const days = Math.floor(diff / (1000 * 60 * 60 * 24))

  if (minutes < 60) return `${minutes}m ago`
  if (hours < 24) return `${hours}h ago`
  return `${days}d ago`
}

function isFreshWithin7Days(dateString: string) {
  const created = new Date(dateString).getTime()
  const sevenDays = 7 * 24 * 60 * 60 * 1000
  return Date.now() - created <= sevenDays
}

function getSpaceTypeLabel(key: string) {
  return key === "private" ? "Private" : "Public"
}

function getSpaceThemeLabel(key: string) {
  switch (key) {
    case "dance":
      return "Dance"
    case "workshop":
      return "Workshop"
    case "free":
      return "Free"
    case "paid":
      return "Paid"
    case "public":
      return "Public"
    case "private":
      return "Private"
    case "off-campus":
      return "Off Campus"
    case "individual":
      return "Individual"
    case "general":
      return "General"
    case "music":
      return "Music"
    case "events":
      return "Events"
    case "opportunities":
      return "Opportunities"
    default:
      return "Space"
  }
}

export function SpaceScreen() {
  const {
    spaces,
    activeSpace,
    getSpacePosts,
    creators,
    user,
    createCommunityPost,
    toggleCommunityLike,
    addCommunityComment,
    toggleJoinSpace,
    setCurrentScreen,
  } = useApp()

  const [postFilter, setPostFilter] = useState<SpacePostFilter>("all")
  const [newMessage, setNewMessage] = useState("")
  const [commentDrafts, setCommentDrafts] = useState<Record<string, string>>({})

  const currentSpace = useMemo(() => {
    return spaces.find((space) => space.key === activeSpace) || null
  }, [spaces, activeSpace])

  const visiblePosts = useMemo(() => {
    const source = getSpacePosts(activeSpace).filter((post) =>
      isFreshWithin7Days(post.createdAt)
    )

    if (postFilter === "recent") {
      return [...source].sort(
        (a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
      )
    }

    if (postFilter === "popular") {
      return [...source].sort((a, b) => b.likes - a.likes)
    }

    return source
  }, [activeSpace, getSpacePosts, postFilter])

  const pinnedPost = useMemo(() => {
    if (visiblePosts.length === 0) return null
    return [...visiblePosts].sort((a, b) => b.likes - a.likes)[0]
  }, [visiblePosts])

  const handlePost = () => {
    const trimmed = newMessage.trim()
    if (!trimmed || !activeSpace) return

    createCommunityPost({
      content: trimmed,
      type: "post",
      spaceKey: activeSpace,
    })

    setNewMessage("")
  }

  const handleComment = (postId: string) => {
    const text = (commentDrafts[postId] || "").trim()
    if (!text) return

    addCommunityComment(postId, text)
    setCommentDrafts((prev) => ({ ...prev, [postId]: "" }))
  }

  if (!currentSpace || !activeSpace) {
    return (
      <div
        style={{
          minHeight: "100vh",
          background: DARK,
          color: "#fff",
          paddingBottom: 96,
        }}
      >
        <TopHeader title="Space" showBack onBack={() => setCurrentScreen("spaces")} />

        <div style={{ padding: 16 }}>
          <div style={emptyWrap}>
            <div style={emptyTitle}>No space selected</div>
            <div style={emptyText}>Go back and open a space first.</div>

            <button onClick={() => setCurrentScreen("spaces")} style={goldBtn}>
              Back to Spaces
            </button>
          </div>
        </div>

        <BottomNav />
      </div>
    )
  }

  return (
    <div
      style={{
        minHeight: "100vh",
        background: DARK,
        color: "#fff",
        paddingBottom: 110,
      }}
    >
      <TopHeader
        title={currentSpace.label}
        showBack
        onBack={() => setCurrentScreen("spaces")}
      />

      <div style={{ padding: "16px" }}>
        <div style={heroCard}>
          <div style={heroGlow} />

          <div style={heroTop}>
            <button onClick={() => setCurrentScreen("spaces")} style={backCircleBtn}>
              <ChevronLeft size={18} />
            </button>

            <div style={heroEmoji}>{currentSpace.emoji}</div>

            <div style={{ flex: 1 }}>
              <div style={heroTitleRow}>
                <div style={heroTitle}>{currentSpace.label}</div>

                <div style={spaceTypePill}>
                  {currentSpace.key === "private" ? <Lock size={12} /> : <Globe size={12} />}
                  <span>{getSpaceTypeLabel(currentSpace.key)}</span>
                </div>
              </div>

              <div style={heroDesc}>{currentSpace.description}</div>
            </div>
          </div>

          <div style={heroStatsRow}>
            <div style={heroStat}>
              <Users size={14} />
              <span>{currentSpace.membersCount} members</span>
            </div>

            <div style={heroStat}>
              <Sparkles size={14} />
              <span>{currentSpace.topicsCount} topics</span>
            </div>

            <div style={heroStat}>
              <Pin size={14} />
              <span>7-day live flow</span>
            </div>
          </div>

          <div style={heroActionsRow}>
            <button
              onClick={() => toggleJoinSpace(currentSpace.key)}
              style={currentSpace.isJoined ? joinedBtn : joinBtn}
            >
              {currentSpace.isJoined ? "Joined" : "Join Space"}
            </button>
          </div>
        </div>

        <div style={composerCard}>
          <div style={composerTitle}>Talk in this Space</div>

          <div style={composerHint}>
            Posts here stay focused on{" "}
            <span style={{ color: GOLD }}>{getSpaceThemeLabel(currentSpace.key)}</span>. Later we
            can add auto-expiration after 7 days without redesigning this screen.
          </div>

          <textarea
            value={newMessage}
            onChange={(e) => setNewMessage(e.target.value.slice(0, 220))}
            placeholder={`Write something for ${currentSpace.label}...`}
            style={composerTextarea}
          />

          <div style={composerBottom}>
            <div style={charCount}>{newMessage.length}/220</div>

            <button onClick={handlePost} style={goldBtn} disabled={!newMessage.trim()}>
              <Send size={15} />
              <span>Post</span>
            </button>
          </div>
        </div>

        <div style={filtersWrap}>
          {[
            { key: "all", label: "All" },
            { key: "recent", label: "Recent" },
            { key: "popular", label: "Popular" },
          ].map((item) => (
            <button
              key={item.key}
              onClick={() => setPostFilter(item.key as SpacePostFilter)}
              style={postFilter === item.key ? chipActive : chip}
            >
              {item.label}
            </button>
          ))}
        </div>

        {pinnedPost && (
          <div style={pinnedCard}>
            <div style={pinnedTop}>
              <div style={pinnedLabel}>
                <Pin size={13} />
                <span>Pinned vibe</span>
              </div>

              <div style={pinnedMeta}>{pinnedPost.likes} likes</div>
            </div>

            <div style={pinnedContent}>{pinnedPost.content}</div>
          </div>
        )}

        <div style={sectionHeader}>
          <span>Conversation</span>
          <div style={sectionCount}>{visiblePosts.length} active posts</div>
        </div>

        {visiblePosts.length === 0 ? (
          <div style={emptyWrap}>
            <div style={emptyTitle}>This space is quiet right now</div>
            <div style={emptyText}>Be the first one to start the conversation.</div>
          </div>
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
            {visiblePosts.map((post) => {
              const creator = creators.find((item) => item.id === post.authorId) || null

              return (
                <div key={post.id} style={postCard}>
                  <div style={postHeader}>
                    <div style={postAuthorRow}>
                      <div style={postAvatarWrap}>
                        <img
                          src={creator?.avatar || user?.avatar || "/placeholder.svg"}
                          alt={creator?.name || "Author"}
                          style={postAvatar}
                        />
                      </div>

                      <div>
                        <div style={postAuthorName}>
                          {creator?.displayName || creator?.name || user?.name || "Community"}
                        </div>

                        <div style={postMeta}>
                          @{creator?.username || user?.username || "user"} •{" "}
                          {timeAgoFromDate(post.createdAt)}
                        </div>
                      </div>
                    </div>

                    <div style={tagPill}>{getSpaceThemeLabel(currentSpace.key)}</div>
                  </div>

                  <div style={postContent}>{post.content}</div>

                  {post.image && (
                    <div style={postImageWrap}>
                      <img src={post.image} alt="Post" style={postImage} />
                    </div>
                  )}

                  <div style={actionsRow}>
                    <button onClick={() => toggleCommunityLike(post.id)} style={actionBtn}>
                      <Heart
                        size={18}
                        fill={post.isLiked ? "#ff4d67" : "transparent"}
                        color={post.isLiked ? "#ff4d67" : "#c8c8c8"}
                      />
                      <span>{post.likes}</span>
                    </button>

                    <div style={actionBtnStatic}>
                      <MessageCircle size={18} color="#c8c8c8" />
                      <span>{post.comments.length}</span>
                    </div>
                  </div>

                  <div style={commentsWrap}>
                    {post.comments.length > 0 && (
                      <div
                        style={{
                          marginBottom: 12,
                          display: "flex",
                          flexDirection: "column",
                          gap: 10,
                        }}
                      >
                        {post.comments.slice(-3).map((comment) => (
                          <div key={comment.id} style={commentCard}>
                            <div style={commentHeader}>
                              <span style={commentAuthor}>{comment.authorName}</span>
                              <span style={commentTime}>
                                {timeAgoFromDate(comment.createdAt)}
                              </span>
                            </div>

                            <div style={commentText}>{comment.content}</div>
                          </div>
                        ))}
                      </div>
                    )}

                    <div style={commentInputRow}>
                      <input
                        value={commentDrafts[post.id] || ""}
                        onChange={(e) =>
                          setCommentDrafts((prev) => ({
                            ...prev,
                            [post.id]: e.target.value.slice(0, 100),
                          }))
                        }
                        placeholder="Add a comment..."
                        style={commentInput}
                      />

                      <button
                        onClick={() => handleComment(post.id)}
                        style={commentSendBtn}
                        disabled={!commentDrafts[post.id]?.trim()}
                      >
                        Post
                      </button>
                    </div>
                  </div>
                </div>
              )
            })}
          </div>
        )}
      </div>

      <BottomNav />
    </div>
  )
}

